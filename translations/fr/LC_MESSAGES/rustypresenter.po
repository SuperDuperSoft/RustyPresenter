msgid "Couldn't run “{name}”: step {step}'s screen view was deleted. Edit the macro."
msgstr "Impossible d’exécuter « {name} » : la vue d’écran de l’étape {step} a été supprimée. Modifiez la macro."

#: src/strings/automation.rs
msgid "Couldn't run “{name}”: step {step}'s message was deleted. Edit the macro."
msgstr "Impossible d’exécuter « {name} » : le message de l’étape {step} a été supprimé. Modifiez la macro."

