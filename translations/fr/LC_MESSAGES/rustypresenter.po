msgstr "Nouvelle diapo (automatique)"

#: src/strings/scripture.rs
msgid "New slide (you added)"
msgstr "Nouvelle diapo (ajoutée par vous)"

#: src/strings/scripture.rs
msgid "Kept together"
msgstr "Gardés ensemble"

