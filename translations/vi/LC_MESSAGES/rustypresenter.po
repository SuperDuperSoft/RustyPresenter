msgstr "Hiện ở cuối luồng phát (không đè lên lời bài hát hay câu Kinh Thánh)"

#: ui/dialogs/settings-stream.slint
msgid "Keep them in a captions file beside the recording (for YouTube's replay and video players)"
msgstr "Lưu vào tệp phụ đề cạnh bản ghi (cho phần phát lại trên YouTube và trình phát video)"

