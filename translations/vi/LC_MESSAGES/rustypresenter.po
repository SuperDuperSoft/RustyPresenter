msgstr "Tạo thêm"

#: src/strings/planning.rs
msgid "“{name}” is ready"
msgstr "“{name}” đã sẵn sàng"

#: src/strings/planning.rs
msgid "“{name}” is ready — fill in {blanks}"
msgstr "“{name}” đã sẵn sàng — hãy điền {blanks}"

#: src/strings/planning.rs
msgid "Date of the service (leave empty for no date)"
msgstr "Ngày của buổi lễ (để trống nếu không có ngày)"

#: src/strings/planning.rs
msgid "Date of the service, like {example} (leave empty for no date)"
msgstr "Ngày của buổi lễ, như {example} (để trống nếu không có ngày)"

#: src/strings/planning.rs
msgid "Name for the template"
msgstr "Tên mẫu"

#: src/strings/planning.rs
msgid "Template “{name}” saved"
msgstr "Đã lưu mẫu “{name}”"

#: src/strings/planning.rs
msgid "Rename template"
msgstr "Đổi tên mẫu"

#: src/strings/planning.rs
msgid "Delete the template “{name}”? (Services made from it stay.)"
msgstr "Xóa mẫu “{name}”? (Các buổi lễ tạo từ mẫu vẫn được giữ.)"

#: src/strings/planning.rs
msgid "Which template?"
msgstr "Mẫu nào?"

#: src/strings/planning.rs src/strings/services.rs
msgid "Name for the new service"
msgstr "Tên buổi lễ mới"

#: src/strings/planning.rs
msgid "Which day is the template “{name}” for?"
msgstr "Mẫu “{name}” dùng cho ngày nào?"

#: src/strings/planning.rs
msgid "Name for the header"
msgstr "Tên tiêu đề mục"

#: src/strings/planning.rs
msgid "Worship"
msgstr "Thờ phượng"

#: src/strings/planning.rs
msgid "Rename header"
msgstr "Đổi tên tiêu đề mục"

#: src/strings/planning.rs
msgid "Click “Make a service” on the template you want, under Templates."
msgstr "Bấm “Tạo buổi lễ” trên mẫu bạn muốn, trong phần Mẫu."

#: src/strings/planning.rs
msgid "Type a day of the week, like Sunday, or leave it empty for any day."
msgstr "Gõ một ngày trong tuần, như Chủ nhật, hoặc để trống cho ngày bất kỳ."

#: src/strings/pplive.rs
msgid "Slide {n} of {total}"
msgstr "Trang {n}/{total}"

#: src/strings/pplive.rs
msgid "Run in PowerPoint"
msgstr "Chạy trong PowerPoint"

#: src/strings/pplive.rs
msgid "Run in PowerPoint needs Microsoft PowerPoint on a Windows computer."
msgstr "“Chạy trong PowerPoint” cần Microsoft PowerPoint trên máy tính Windows."

#: src/strings/pplive.rs
msgid "How should “{name}” come in? Editable slides can be changed in the slide editor. Pictures look exactly like PowerPoint. Run in PowerPoint plays every animation, transition and video in PowerPoint itself."
msgstr "Nhập “{name}” theo cách nào? Trang chiếu chỉnh sửa được có thể thay đổi trong trình sửa trang chiếu. Hình ảnh trông y hệt như trong PowerPoint. “Chạy trong PowerPoint” phát mọi hoạt ảnh, hiệu ứng chuyển và video ngay trong PowerPoint."

#: src/strings/pplive.rs
msgid "How should “{title}” show? Editable slides and a deck without its file come in again from the presentation."
msgstr "Hiển thị “{title}” theo cách nào? Trang chiếu chỉnh sửa được, và bài trình chiếu thiếu tệp, sẽ được nhập lại từ bài trình chiếu."

#: src/strings/pplive.rs
msgid "Choose the presentation file for “{title}” again."
msgstr "Hãy chọn lại tệp trình chiếu cho “{title}”."

#: src/strings/pplive.rs
msgid "“{title}” runs in PowerPoint now."
msgstr "“{title}” giờ chạy trong PowerPoint."

#: src/strings/pplive.rs
msgid "“{title}” shows as pictures now."
msgstr "“{title}” giờ hiện dưới dạng hình ảnh."

#: src/strings/pplive.rs
msgid "Run in PowerPoint needs the room screen on a monitor. Turn the room screen on in Screens; until then the room shows the slide pictures."
msgstr "“Chạy trong PowerPoint” cần màn hình hội trường ở trên một màn hình máy tính. Hãy bật màn hình hội trường trong “Màn hình”; trong lúc chờ, hội trường sẽ hiện hình trang chiếu."

#: src/strings/pplive.rs
msgid "PowerPoint could not run “{title}”: {error} The room shows the slide pictures instead."
msgstr "PowerPoint không chạy được “{title}”: {error} Hội trường sẽ hiện hình trang chiếu thay thế."

#: src/strings/pplive.rs
msgid "PowerPoint ended the slide show of “{title}”. The room shows the slide pictures now; click a slide to start PowerPoint again."
msgstr "PowerPoint đã kết thúc trình chiếu “{title}”. Giờ hội trường hiện hình trang chiếu; bấm vào một trang để khởi động lại PowerPoint."

#: src/strings/pplive.rs
msgid "PowerPoint did not answer."
msgstr "PowerPoint không phản hồi."

#: src/strings/preflight.rs
msgid "All set. Every song, file and screen for this service was found."
msgstr "Mọi thứ đã sẵn sàng. Đã tìm thấy đủ bài hát, tệp và màn hình cho buổi lễ này."

#: src/strings/preflight.rs
msgid "This service has no items yet."
msgstr "Buổi lễ này chưa có mục nào."

#: src/strings/preflight.rs
msgid "No room screen is chosen. Choose one in Screens."
msgstr "Chưa chọn màn hình hội trường. Hãy chọn trong Màn hình."

#: src/strings/preflight.rs
msgid "The room screen is not connected. Check its cable, or choose another in Screens."
msgstr "Màn hình hội trường chưa được kết nối. Hãy kiểm tra dây cáp, hoặc chọn màn hình khác trong Màn hình."

#: src/strings/preflight.rs
msgid "The stage screen is not connected. The service can run without it."
msgstr "Màn hình sân khấu chưa được kết nối. Buổi lễ vẫn chạy được mà không cần nó."

#: src/strings/preflight.rs
msgid "The sound output chosen in Settings is not connected. Plug it in, or choose another in Settings → Video."
msgstr "Đầu ra âm thanh đã chọn trong Cài đặt chưa được kết nối. Hãy cắm vào, hoặc chọn đầu ra khác trong Cài đặt → Video."

#: src/strings/preflight.rs
msgid "The sound output is not connected, so the video or audio was paused. Plug it in, or choose another in Settings → Video, then press play."
msgstr "Đầu ra âm thanh chưa được kết nối, nên video hoặc âm thanh đã tạm dừng. Hãy cắm vào, hoặc chọn đầu ra khác trong Cài đặt → Video, rồi bấm phát."

#: src/strings/preflight.rs
msgid "The logo's file is missing. Choose it again in Settings."
msgstr "Thiếu tệp logo. Hãy chọn lại trong Cài đặt."

#: src/strings/preflight.rs
msgid "The default background's file is missing. Choose it again in Settings."
msgstr "Thiếu tệp nền mặc định. Hãy chọn lại trong Cài đặt."

#: src/strings/preflight.rs
msgid "the song is no longer in the library"
msgstr "bài hát không còn trong thư viện"

#: src/strings/preflight.rs
msgid "the song has no words"
msgstr "bài hát không có lời"

#: src/strings/preflight.rs
msgid "there is no verse text"
msgstr "không có nội dung câu"

#: src/strings/preflight.rs
msgid "it is no longer in the library"
msgstr "không còn trong thư viện"

#: src/strings/preflight.rs
msgid "its file is missing"
msgstr "thiếu tệp"

#: src/strings/preflight.rs
msgid "these slides are no longer in the library"
msgstr "các trang chiếu này không còn trong thư viện"

#: src/strings/preflight.rs
msgid "its background file is missing"
msgstr "thiếu tệp nền"

#: src/strings/preflight.rs
msgid "it can't be played ({reason})"
msgstr "không phát được ({reason})"

