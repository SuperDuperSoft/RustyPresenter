msgstr "Đã dời {side} {x} %, {way} {y} %"

#: src/strings/screens.rs
msgid "about {ms} ms"
msgstr "khoảng {ms} ms"

#: src/strings/screens.rs
msgid "Colour and corner changes show when the screens draw with OpenGL (Settings → Video → Graphics: Automatic or OpenGL). Test patterns and the delay work either way."
msgstr "Thay đổi màu và góc chỉ hiện khi màn hình vẽ bằng OpenGL (Cài đặt → Video → Đồ họa: Tự động hoặc OpenGL). Hình kiểm tra và độ trễ dùng được trong cả hai trường hợp."

#: src/strings/scripture.rs
msgid "Type at least one word to search for."
msgstr "Hãy gõ ít nhất một từ để tìm."

#: src/strings/scripture.rs
msgid "Add a chapter, like Job 1 or Job 1:1."
msgstr "Thêm số chương, như Job 1 hoặc Job 1:1."

#: src/strings/scripture.rs
msgid "Pick a different second translation."
msgstr "Hãy chọn bản dịch thứ hai khác."

#: src/strings/scripture.rs
msgid "Second translation turned off (same as main)."
msgstr "Đã tắt bản dịch thứ hai (trùng bản chính)."

#: src/strings/scripture.rs
msgid "Too long — will split inside a verse"
msgstr "Quá dài — sẽ tách giữa câu"

#: src/strings/scripture.rs
msgid "Keeping these together makes a slide too long, so it will split inside a verse."
msgstr "Giữ chung các câu này làm trang chiếu quá dài, nên sẽ tách giữa câu."

#: src/strings/scripture.rs
msgid "Bible slides are now fitted to the screen, so some passages may break in different places."
msgstr "Trang chiếu Kinh Thánh giờ được canh vừa màn hình, nên một số phân đoạn có thể ngắt ở chỗ khác."

#: src/strings/scripture.rs
msgid "Fitting slides…"
msgstr "Đang canh trang chiếu…"

#: src/strings/scripture.rs
msgid "This translation can't be used in RustyPresenter. Please choose another Bible."
msgstr "Không thể dùng bản dịch này trong RustyPresenter. Vui lòng chọn bản Kinh Thánh khác."

#: src/strings/scripture.rs
msgid "This verse came from an older version; look the passage up again to choose breaks here."
msgstr "Câu này đến từ phiên bản cũ hơn; hãy tra lại phân đoạn để chọn chỗ ngắt ở đây."

#: src/strings/scripture.rs
msgid "One passage used a translation that can't be used in RustyPresenter and was removed."
msgid_plural "{n} passages used a translation that can't be used in RustyPresenter and were removed."
msgstr[0] "{n} phân đoạn dùng bản dịch không thể dùng trong RustyPresenter và đã bị gỡ."

#: src/strings/scripture.rs
msgid "Ready on this computer"
msgstr "Sẵn sàng trên máy này"

#: src/strings/scripture.rs
msgid "Ready (needs internet)"
msgstr "Sẵn sàng (cần internet)"

#: src/strings/scripture.rs
msgid "Needs a key — Get one"
msgstr "Cần khóa — Lấy khóa"

#: src/strings/scripture.rs
msgid "Not available"
msgstr "Không có sẵn"

#: src/strings/scripture.rs
msgid "Search: Ready"
msgstr "Tìm kiếm: Sẵn sàng"

#: src/strings/scripture.rs
msgid "Search: online (ESV)"
msgstr "Tìm kiếm: trực tuyến (ESV)"

#: src/strings/scripture.rs
msgid "Search works for the translations stored on this computer (KJV and any bundled or imported Bible). Online translations can't be searched, because their owners don't allow it (ESV may offer its own online search)."
msgstr "Tìm kiếm dùng được cho các bản dịch lưu trên máy này (KJV và mọi bản Kinh Thánh có sẵn hoặc đã nhập). Không tìm được trong bản dịch trực tuyến vì chủ sở hữu không cho phép (ESV có thể có tìm kiếm trực tuyến riêng)."

#: src/strings/scripture.rs
msgid "Every word must appear in the verse (love neighbour finds verses with both)."
msgstr "Mọi từ phải có trong câu (love neighbour tìm các câu có cả hai từ)."

#: src/strings/scripture.rs
msgid "Words match their beginnings: love finds love, loved, loveth, lovest, loving. Words shorter than 3 letters must match exactly."
msgstr "Từ khớp theo phần đầu: love tìm thấy love, loved, loveth, lovest, loving. Từ ngắn hơn 3 chữ cái phải khớp chính xác."

#: src/strings/scripture.rs
msgid "Put words in quotes for an exact phrase: \"be still\"."
msgstr "Đặt các từ trong ngoặc kép để tìm đúng cụm từ: \"be still\"."

#: src/strings/scripture.rs
msgid "Capitals and punctuation do not matter. lord finds LORD."
msgstr "Chữ hoa và dấu câu không quan trọng. lord tìm thấy LORD."

#: src/strings/scripture.rs
msgid "Best matches come first: verses with your exact words in order, then verses where the words are close together, then the rest in Bible order. Switch to Bible order to see Genesis first."
msgstr "Kết quả phù hợp nhất hiện trước: các câu có đúng các từ theo thứ tự, rồi các câu có các từ ở gần nhau, rồi phần còn lại theo thứ tự Kinh Thánh. Chuyển sang thứ tự Kinh Thánh để thấy Sáng Thế Ký trước."

#: src/strings/scripture.rs
msgid "Ctrl+Enter in the Bible box always searches, even for a book name like \"Job\"."
msgstr "Ctrl+Enter trong ô Kinh Thánh luôn tìm kiếm, kể cả với tên sách như \"Job\"."

#: src/strings/scripture.rs
msgid "Also show…"
msgstr "Hiện thêm…"

#: src/strings/scripture.rs
msgid "Search by words…"
msgstr "Tìm theo từ…"

#: src/strings/scripture.rs
msgid "Find a verse"
msgstr "Tìm câu Kinh Thánh"

#: src/strings/scripture.rs
msgid "Slide breaks"
msgstr "Ngắt trang"

#: src/strings/scripture.rs
msgid "New slide (automatic)"
msgstr "Trang mới (tự động)"

#: src/strings/scripture.rs
msgid "New slide (you added)"
msgstr "Trang mới (bạn thêm)"

#: src/strings/scripture.rs
msgid "Kept together"
msgstr "Giữ chung"

#: src/strings/scripture.rs
msgid "+ New slide here"
msgstr "+ Trang mới ở đây"

#: src/strings/scripture.rs
msgid "Lower-third themes always stack two translations."
msgstr "Chủ đề phần ba dưới luôn xếp chồng hai bản dịch."

#: src/strings/scripture.rs
msgid "Search for these words"
msgstr "Tìm các từ này"

#: src/strings/scripture.rs
msgid "No verses in {bible} have all of those words."
msgstr "Không có câu nào trong {bible} chứa tất cả các từ đó."

#: src/strings/scripture.rs
msgid "No verses in {bible} have that word. If it's a book name, check the spelling and add a chapter, like John 3."
msgstr "Không có câu nào trong {bible} chứa từ đó. Nếu đó là tên sách, hãy kiểm tra chính tả và thêm số chương, như John 3."

#: src/strings/scripture.rs
msgid "Showing the first {shown} of {total} verses — add more words to narrow it down."
msgstr "Đang hiện {shown} câu đầu trong {total} câu — thêm từ để thu hẹp kết quả."

#: src/strings/scripture.rs
msgid "{count} verse found in {bible}"
msgid_plural "{count} verses found in {bible}"
msgstr[0] "Tìm thấy {count} câu trong {bible}"

#: src/strings/scripture.rs
msgid "Getting {bible} ready to search…"
msgstr "Đang chuẩn bị {bible} để tìm kiếm…"

#: src/strings/scripture.rs
msgid "Search isn't available for {bible}. Try a translation stored on this computer, like KJV."
msgstr "Không tìm kiếm được trong {bible}. Hãy thử bản dịch lưu trên máy này, như KJV."

#: src/strings/scripture.rs
msgid "Search isn't available for {bible}, so this searches {local}."
msgstr "Không tìm kiếm được trong {bible}, nên sẽ tìm trong {local}."

#: src/strings/scripture.rs
msgid "Searching ESV needs the internet. Check the connection, or search in KJV."
msgstr "Tìm trong ESV cần internet. Hãy kiểm tra kết nối, hoặc tìm trong KJV."

#: src/strings/scripture.rs
msgid "Search isn't available for {bible}"
msgstr "Không tìm kiếm được trong {bible}"

#: src/strings/scripture.rs
msgid "{bible} needs a key. Add one in Settings → Bible."
msgstr "{bible} cần khóa. Hãy thêm trong Cài đặt → Kinh Thánh."

#: src/strings/scripture.rs
msgid "{bible} isn't available."
msgstr "{bible} không có sẵn."

#: src/strings/scripture.rs
msgid "Couldn't get {bible} text — check the internet."
msgstr "Không lấy được nội dung {bible} — hãy kiểm tra internet."

#: src/strings/scripture.rs
msgid "{second} isn't available right now, so only {main} was added. Turn off the second translation with the X."
msgstr "{second} hiện không có sẵn, nên chỉ thêm {main}. Tắt bản dịch thứ hai bằng nút X."

