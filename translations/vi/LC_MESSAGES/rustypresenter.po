msgid "None"
msgstr "Không"

#: src/strings/screens.rs
msgid "In a window (for testing)"
msgstr "Trong cửa sổ (để thử)"

#: src/strings/screens.rs
msgid "Not connected right now"
msgstr "Hiện chưa kết nối"

#: src/strings/screens.rs
msgid "This is the screen you are working on. Turning this on covers it."
msgstr "Đây là màn hình bạn đang làm việc. Bật lên sẽ che mất nó."

#: src/strings/screens.rs
msgid "Shows the same picture as {screen}. Sound only plays from {screen}."
msgstr "Hiện cùng hình với {screen}. Âm thanh chỉ phát từ {screen}."

#: src/strings/screens.rs
msgid "Remove “{name}”?"
msgstr "Gỡ “{name}”?"

#: src/strings/screens.rs
msgid "Placeholder (connect the projector later)"
msgstr "Giữ chỗ (kết nối máy chiếu sau)"

#: src/strings/screens.rs
msgid "Placeholder"
msgstr "Giữ chỗ"

#: src/strings/screens.rs
msgid "Nothing shows on a placeholder. Set it up now, then pick the projector here once it is plugged in."
msgstr "Màn hình giữ chỗ không hiện gì. Hãy thiết lập ngay, rồi chọn máy chiếu ở đây khi đã cắm vào."

#: src/strings/screens.rs
msgid "Shows the audience picture instead of a stage layout. It has no sound."
msgstr "Hiện hình ảnh hội chúng thấy thay cho bố cục sân khấu. Không có âm thanh."

#: src/strings/screens.rs
msgid "Colour bars"
msgstr "Sọc màu"

