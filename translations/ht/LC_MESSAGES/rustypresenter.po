#: src/strings/pplive.rs
msgid "Slide {n} of {total}"
msgstr "Diapo {n} sou {total}"

#: src/strings/pplive.rs
msgid "Run in PowerPoint"
msgstr "Lanse nan PowerPoint"

#: src/strings/pplive.rs
msgid "Run in PowerPoint needs Microsoft PowerPoint on a Windows computer."
msgstr "“Lanse nan PowerPoint” bezwen Microsoft PowerPoint sou yon òdinatè Windows."

#: src/strings/pplive.rs
msgid "How should “{name}” come in? Editable slides can be changed in the slide editor. Pictures look exactly like PowerPoint. Run in PowerPoint plays every animation, transition and video in PowerPoint itself."
msgstr "Kijan “{name}” dwe antre? Ou ka chanje diapo ou ka modifye yo nan editè diapo a. Foto yo parèt egzakteman tankou nan PowerPoint. “Lanse nan PowerPoint” jwe chak animasyon, tranzisyon ak videyo nan PowerPoint menm."

#: src/strings/pplive.rs
msgid "How should “{title}” show? Editable slides and a deck without its file come in again from the presentation."
msgstr "Kijan “{title}” dwe parèt? Diapo ou ka modifye yo, ak yon prezantasyon ki pa gen fichye li, ap antre ankò soti nan prezantasyon an."

#: src/strings/pplive.rs
msgid "Choose the presentation file for “{title}” again."
msgstr "Chwazi fichye prezantasyon an pou “{title}” ankò."

#: src/strings/pplive.rs
msgid "“{title}” runs in PowerPoint now."
msgstr "“{title}” ap kouri nan PowerPoint kounye a."

#: src/strings/pplive.rs
msgid "“{title}” shows as pictures now."
msgstr "“{title}” parèt kòm foto kounye a."

#: src/strings/pplive.rs
msgid "Run in PowerPoint needs the room screen on a monitor. Turn the room screen on in Screens; until then the room shows the slide pictures."
msgstr "“Lanse nan PowerPoint” bezwen ekran sal la sou yon monitè. Limen ekran sal la nan Ekran; jiskaske sa fèt, sal la montre foto diapo yo."

#: src/strings/pplive.rs
msgid "PowerPoint could not run “{title}”: {error} The room shows the slide pictures instead."
msgstr "PowerPoint pa t ka lanse “{title}”: {error} Sal la montre foto diapo yo pito."

#: src/strings/pplive.rs
msgid "PowerPoint ended the slide show of “{title}”. The room shows the slide pictures now; click a slide to start PowerPoint again."
msgstr "PowerPoint fini prezantasyon diapo “{title}” la. Sal la montre foto diapo yo kounye a; klike sou yon diapo pou lanse PowerPoint ankò."

#: src/strings/pplive.rs
msgid "PowerPoint did not answer."
msgstr "PowerPoint pa t reponn."

