msgstr "RustyPresenter에서 인쇄 · {date}"

#: src/strings/print.rs
msgid "Opened in your web browser — use Print there (you can also save as PDF from the print window)"
msgstr "웹 브라우저에서 열었어요 — 거기서 인쇄하세요(인쇄 창에서 PDF로 저장할 수도 있어요)"

#: src/strings/print.rs
msgid "Saved {file}"
msgstr "{file} 저장됨"

#: src/strings/print.rs
msgid "Couldn't make the page: {reason}."
msgstr "페이지를 만들지 못했어요: {reason}."

#: src/strings/print.rs
msgid "Couldn't save to that folder: {reason}."
msgstr "그 폴더에 저장하지 못했어요: {reason}."

#: src/strings/print.rs
msgid "The page is saved at {path} but no program opened it. Open it from there to print."
msgstr "페이지가 {path}에 저장되었지만 열어 준 프로그램이 없어요. 거기서 열어서 인쇄하세요."

#: src/strings/print.rs
msgid "Print or save"
msgstr "인쇄 또는 저장"

