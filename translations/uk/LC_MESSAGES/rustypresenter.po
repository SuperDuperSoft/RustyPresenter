msgid "Downloading “{title}”. It will be in Video & media when it's done."
msgstr "Завантаження «{title}». Після завершення воно буде у «Відео й медіа»."

#: src/strings/youtube.rs
msgid "Downloading “{title}”"
msgstr "Завантаження «{title}»"

#: src/strings/youtube.rs
msgid "less than a minute left"
msgstr "залишилося менше хвилини"

#: src/strings/youtube.rs
msgid "about a minute left"
msgstr "залишилося близько хвилини"

