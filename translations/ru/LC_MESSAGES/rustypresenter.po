msgid "Upload: {speed} Mbit/s. Enough to stream in 1080p."
msgstr "Отдача: {speed} Мбит/с. Хватит для трансляции в 1080p."

#: src/stream/speed.rs
msgid "Upload: {speed} Mbit/s. Stream in 720p: 1080p needs {need} Mbit/s."
msgstr "Отдача: {speed} Мбит/с. Транслируйте в 720p: для 1080p нужно {need} Мбит/с."

#: src/stream/speed.rs
msgid "Upload: {speed} Mbit/s. That is too slow: 720p to every destination that is on needs {need} Mbit/s. Stream to fewer places, or use a faster connection."
msgstr "Отдача: {speed} Мбит/с. Слишком медленно: для 720p во все включённые места нужно {need} Мбит/с. Транслируйте в меньшее число мест или используйте более быстрое подключение."

