msgstr "Anzisha upya RustyPresenter ili kutumia mpangilio mpya wa michoro."

#: src/video/graphics.rs
msgid "The {wanted} graphics mode could not be used on this computer, so RustyPresenter is using {mode}."
msgstr "Hali ya michoro {wanted} haikuweza kutumika kwenye kompyuta hii, kwa hiyo RustyPresenter inatumia {mode}."

#: src/video/graphics.rs
msgid "RustyPresenter had trouble with the graphics card, so it started in safe mode. You can change this in Settings → Video."
msgstr "RustyPresenter ilipata tatizo na kadi ya michoro, kwa hiyo ilianza katika hali salama. Unaweza kubadilisha hili katika Mipangilio → Video."

#: src/video/player.rs
msgid "The video player could not start."
msgstr "Kicheza video hakikuweza kuanza."

#: src/video/player.rs
msgid "The video player could not start: {reason}"
msgstr "Kicheza video hakikuweza kuanza: {reason}"

#: src/video/player.rs
msgid "{name} could not be played ({reason})"
msgstr "{name} haikuweza kuchezwa ({reason})"

#: src/video/surface.rs
msgid "The video cannot be shown: {reason}"
msgstr "Video haiwezi kuonyeshwa: {reason}"

