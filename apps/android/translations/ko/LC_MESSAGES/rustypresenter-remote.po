# The Android remote's words (apps/android/ui). Where a text is the same as the desktop app's, its translation
# is the desktop's (translations/ko); the rest were translated for the app (November 18, 2026).
msgid ""
msgstr ""
"Language: ko\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "Remote"
msgstr "리모컨"

msgid "Stage"
msgstr "무대"

msgid "On air"
msgstr "방송 중"

msgid "Microphone"
msgstr "마이크"

msgid "Camera"
msgstr "카메라"

msgid "Cancel"
msgstr "취소"

msgid "Continue"
msgstr "계속"

msgid "Choose the presentation computer. It needs RustyPresenter open and this phone on the same Wi-Fi."
msgstr "발표용 컴퓨터를 고르세요. 그 컴퓨터에서 RustyPresenter가 열려 있고 이 휴대폰이 같은 Wi-Fi에 있어야 합니다."

msgid "Looking for RustyPresenter on this Wi-Fi…"
msgstr "이 Wi-Fi에서 RustyPresenter를 찾는 중…"

msgid "On this Wi-Fi"
msgstr "이 Wi-Fi에서"

msgid "Search again"
msgstr "다시 찾기"

msgid "Or scan the QR code"
msgstr "또는 QR 코드 스캔"

msgid "On the computer, click Phone → Pair a phone or tablet, then scan the code it shows."
msgstr "컴퓨터에서 휴대폰 → 휴대폰이나 태블릿 연결을 누른 다음 화면에 나온 코드를 스캔하세요."

msgid "Scan the QR code"
msgstr "QR 코드 스캔"

msgid "Or type the address"
msgstr "또는 주소 입력"

msgid "Connect"
msgstr "연결"

msgid "On the presentation computer, click Phone, then Pair a phone or tablet, and type the 6-digit code here."
msgstr "발표용 컴퓨터에서 휴대폰, 그다음 휴대폰이나 태블릿 연결을 누르고 여기에 6자리 코드를 입력하세요."

msgid "This remote needs a password too."
msgstr "이 리모컨에도 비밀번호가 필요합니다."

msgid "Password"
msgstr "비밀번호"

msgid "Choose another computer"
msgstr "다른 컴퓨터 고르기"

msgid "Connecting…"
msgstr "연결 중…"

msgid "On screen"
msgstr "화면 표시 중"

msgid "Hide presenter notes"
msgstr "발표자 메모 숨기기"

msgid "Show presenter notes"
msgstr "발표자 메모 보기"

msgid "Back"
msgstr "뒤로"

msgid "Next"
msgstr "다음"

msgid "Play video"
msgstr "동영상 재생"

msgid "Pause video"
msgstr "동영상 일시 정지"

msgid "Up next"
msgstr "다음 순서"

msgid "Clear all"
msgstr "모두 지우기"

msgid "Text"
msgstr "텍스트"

msgid "Media"
msgstr "미디어"

msgid "Audio"
msgstr "오디오"

msgid "Logo"
msgstr "로고"

msgid "Service"
msgstr "예배"

msgid "Tap a slide to put it on the screen."
msgstr "슬라이드를 탭하면 화면에 표시돼요."

msgid "Stage screen"
msgstr "무대 화면"

msgid "Not connected"
msgstr "연결 안 됨"

msgid "This stage screen needs a password."
msgstr "이 무대 화면은 비밀번호가 필요해요."

msgid "Open"
msgstr "열기"

msgid "Camera {}"
msgstr "카메라 {}"

msgid "Phone microphone"
msgstr "휴대폰 마이크"

msgid "Sends this phone's microphone to the livestream."
msgstr "이 휴대폰의 마이크 소리를 라이브 방송으로 보냅니다."

msgid "Stop"
msgstr "정지"

msgid "Start sending sound"
msgstr "소리 보내기 시작"

msgid "Keep this screen open while it sends."
msgstr "보내는 동안 이 화면을 열어 두세요."

msgid "Phone camera"
msgstr "휴대폰 카메라"

msgid "Camera name"
msgstr "카메라 이름"

msgid "Back camera"
msgstr "후면 카메라"

msgid "Front camera"
msgstr "전면 카메라"

msgid "Start the camera"
msgstr "카메라 시작"

msgid "Turn the phone sideways for a full picture."
msgstr "휴대폰을 가로로 돌리면 화면 전체가 나와요."

msgid "On the computer, choose this phone in Settings → Livestream → Cameras."
msgstr "컴퓨터의 설정 → 라이브 방송 → 카메라에서 이 휴대폰을 고르세요."

msgid "No computer found yet. Check that RustyPresenter is open on the presentation computer and that this phone is on the same Wi-Fi."
msgstr "아직 컴퓨터를 찾지 못했습니다. 발표용 컴퓨터에서 RustyPresenter가 열려 있는지, 이 휴대폰이 같은 Wi-Fi에 있는지 확인하세요."

msgid "This phone is not on a Wi-Fi network. Connect to the church's Wi-Fi, then search again."
msgstr "이 휴대폰은 Wi-Fi에 연결되어 있지 않습니다. 교회 Wi-Fi에 연결한 다음 다시 찾으세요."

msgid "That address isn't right. It looks like 192.168.1.20 — the computer shows it under Pair a phone or tablet."
msgstr "주소가 올바르지 않습니다. 192.168.1.20 같은 모양이며, 컴퓨터의 휴대폰이나 태블릿 연결에 나와 있습니다."

msgid "Could not reach {}. Check that RustyPresenter is open there and that this phone is on the same Wi-Fi."
msgstr "{}에 연결할 수 없습니다. 그곳에서 RustyPresenter가 열려 있는지, 이 휴대폰이 같은 Wi-Fi에 있는지 확인하세요."

msgid "{} is not a RustyPresenter computer."
msgstr "{}은(는) RustyPresenter 컴퓨터가 아닙니다."

msgid "Connected"
msgstr "연결됨"

msgid "Could not connect."
msgstr "연결하지 못했어요."

msgid "(Logo)"
msgstr "(로고)"

msgid "(Clear)"
msgstr "(지움)"

msgid "(Music playing)"
msgstr "(음악 재생 중)"

msgid "End of service"
msgstr "예배 끝"

msgid "The screen changed just now — tap the slide again."
msgstr "방금 화면이 바뀌었어요 — 슬라이드를 다시 탭하세요."

msgid "Android phone"
msgstr "Android 휴대폰"

msgid "To send this phone's microphone to the livestream, the app needs to use the microphone. Android will ask you next."
msgstr "이 휴대폰의 마이크 소리를 라이브 방송으로 보내려면 앱이 마이크를 사용해야 합니다. 다음에 Android가 물어봅니다."

msgid "To send this phone's camera to the livestream, the app needs to use the camera. Android will ask you next."
msgstr "이 휴대폰의 카메라 화면을 라이브 방송으로 보내려면 앱이 카메라를 사용해야 합니다. 다음에 Android가 물어봅니다."

msgid "To read the QR code, the app needs to use the camera. Android will ask you next."
msgstr "QR 코드를 읽으려면 앱이 카메라를 사용해야 합니다. 다음에 Android가 물어봅니다."

msgid "The microphone is not allowed. Allow it in the phone's Settings → Apps → RustyPresenter → Permissions."
msgstr "마이크가 허용되지 않았습니다. 휴대폰의 설정 → 애플리케이션 → RustyPresenter → 권한에서 허용하세요."

msgid "The camera is not allowed. Allow it in the phone's Settings → Apps → RustyPresenter → Permissions."
msgstr "카메라가 허용되지 않았습니다. 휴대폰의 설정 → 애플리케이션 → RustyPresenter → 권한에서 허용하세요."

msgid "The camera could not start. Close other apps that use it and try again."
msgstr "카메라를 시작할 수 없습니다. 카메라를 쓰는 다른 앱을 닫고 다시 시도하세요."

msgid "The microphone could not start. Close other apps that use it and try again."
msgstr "마이크를 시작할 수 없습니다. 마이크를 쓰는 다른 앱을 닫고 다시 시도하세요."

msgid "Point the camera at the QR code on the presentation computer."
msgstr "발표용 컴퓨터의 QR 코드에 카메라를 맞추세요."

msgid "That QR code is not from RustyPresenter. On the computer, click Phone → Pair a phone or tablet."
msgstr "RustyPresenter의 QR 코드가 아닙니다. 컴퓨터에서 휴대폰 → 휴대폰이나 태블릿 연결을 누르세요."

msgid "Connecting to the computer…"
msgstr "컴퓨터에 연결하는 중…"

msgid "Sending to the computer"
msgstr "컴퓨터로 보내는 중"

msgid "The computer cannot be reached. Trying again…"
msgstr "컴퓨터에 연결할 수 없어요. 다시 시도하는 중…"

msgid "This phone is no longer paired. Pair it again."
msgstr "이 휴대폰은 더 이상 연결되어 있지 않습니다. 다시 연결하세요."

msgid "Draw"
msgstr "그리기"

msgid "Draw on the slide"
msgstr "슬라이드에 그리기"

msgid "Ink fades"
msgstr "잉크가 사라짐"

msgid "Ink stays"
msgstr "잉크가 남음"

msgid "Undo"
msgstr "실행 취소"

msgid "Clear"
msgstr "지우기"

msgid "Done"
msgstr "완료"

msgid "Drawing from this phone is turned off on the computer."
msgstr "이 휴대폰에서 그리기는 컴퓨터에서 꺼져 있습니다."

msgid "The app closed by itself last time. Please pass this on:"
msgstr "지난번에 앱이 저절로 닫혔습니다. 이 내용을 전달해 주세요:"
