<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists/PLIST-1.0.dtd">
<!-- Merged into the Info.plist cargo-packager makes (Packager.toml `infoPlistPath`). macOS shows these words when
     the app (or the FFmpeg it starts) first opens a camera or a sound input; without them the app is stopped. -->
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>RustyPresenter shows your cameras in the livestream and the recording.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>RustyPresenter records and streams the sound from your microphone or sound board, and listens to the room to follow songs.</string>
</dict>
</plist>
