# Pinned versions for packaging: the single place to bump them.
# Read by packaging/stage.sh, packaging/libmpv/*.sh and the GitHub workflows
# (`source` in bash, appended to $GITHUB_ENV in Actions), so keep plain KEY=VALUE
# lines: no spaces, no quotes, comments only on their own lines.

# Packager.
CARGO_PACKAGER_VERSION=0.11.8

# LGPL libmpv, built by .github/workflows/libmpv.yml and published on this repo's
# release `libmpv-r<LIBMPV_REV>`. The artifacts are
#   libmpv-<os>-<arch>-mpv<MPV_VERSION>-ff<FFMPEG_VERSION>-r<LIBMPV_REV>.zip
#   libmpv-sources-r<LIBMPV_REV>.tar.xz
# Bump LIBMPV_REV before building a new revision, publish the release, then fill in
# the sha256 values below (sha256sum of each published zip).
LIBMPV_REPO=SuperDuperSoft/RustyPresenter
LIBMPV_REV=1
# libmpv-r1 was published on Nov 21 2026. Windows stays TODO on purpose: the Windows installer is made on the
# build PC with that PC's libmpv-2.dll, the one every release so far was tried with. Its zip's sha256 is
# dbf02b10dc8f1b9f2363dbe3bae4033056fa615cf557e841e8c8228206a03c0f; put it here once an installer with that library has been tried.
LIBMPV_SHA256_WINDOWS=TODO
LIBMPV_SHA256_MACOS=b9befd22d9edbbe3eb34900df595933bca673b9fad5c46556b906b5d6fc7ae87
LIBMPV_SHA256_LINUX=4c6c88406cf53e02c5a27d3236a1562bd5def40edf9c68587b877a1d967ae43e

# Sources built into libmpv. FFmpeg is configured without --enable-gpl, version3 or nonfree.
MPV_VERSION=0.41.0
# Backported onto v0.41.0 (git apply of the upstream commit).
MPV_BACKPORT=c5d391adba7bd024954d0df1e0405f5749f4d4ca
FFMPEG_VERSION=9.0.2
# mpv 0.41 needs libplacebo >= 6.338.2.
LIBPLACEBO_VERSION=7.360.1
# Headers only: libplacebo compiles its Vulkan stubs even with -Dvulkan=disabled.
VULKAN_HEADERS_VERSION=v1.4.304
# Static dependencies built into libmpv (git tags; freetype's tag is VER-<dashes>).
DAV1D_VERSION=1.5.4
FREETYPE_VERSION=2.14.3
HARFBUZZ_VERSION=14.6.0
FRIBIDI_VERSION=1.0.17
LIBASS_VERSION=0.17.5

# Windows installer made on a PC by make-installer.cmd (packaging/windows/make-installer.sh).
# NSIS from its official release on SourceForge: the zip, which runs without installing.
# Pinned Nov 8 2026 from the first run on the build PC (size matches the SourceForge listing, 2.4 MB):
# https://sourceforge.net/projects/nsis/files/NSIS%203/3.11/ (SourceForge lists sha1 and md5 per file).
NSIS_VERSION=3.11
NSIS_URL=https://downloads.sourceforge.net/project/nsis/NSIS%203/3.11/nsis-3.11.zip
NSIS_SHA256=c7d27f780ddb6cffb4730138cd1591e841f4b7edb155856901cdf5f214394fa1
# mpv's own Copyright file at MPV_VERSION's tag. Used only while LIBMPV_SHA256_WINDOWS is TODO, when the
# installer ships the build PC's libmpv-2.dll; the release zip carries this file otherwise.
# Pinned Nov 8 2026 from the first run (the file at the v0.41.0 tag): https://github.com/mpv-player/mpv/blob/v0.41.0/Copyright
MPV_COPYRIGHT_URL=https://raw.githubusercontent.com/mpv-player/mpv/v0.41.0/Copyright
MPV_COPYRIGHT_SHA256=bfe9ee4cceabcb8ecbfadf208d04156f73d801e6a57369a5606bb8341e204a23

# pdfium from bblanchon/pdfium-binaries: one tag, one archive per OS, each with its sha256
# (the release's own asset digests).
PDFIUM_TAG=chromium/8125
PDFIUM_SHA256_WINDOWS=9a964261760cff52570aabf038ab346d3a5034dd8b30d0d5fe8861235d356b8b
PDFIUM_SHA256_MACOS=4939bd935ac83ddc09a3a4f038bc43a19cea1660316a3667f26cb07a070e139d
PDFIUM_SHA256_LINUX=e1c3ce6e270cb5e0c20816b379ad9f2c1309972697c505f508de92bf5e7d6659

# The Android remote (apps/android/build-apk.ps1): the SDK packages the "android" job of package.yml installs,
# the same as the PC's .tools/android/sdk.
ANDROID_PLATFORM=android-34
ANDROID_BUILD_TOOLS=34.0.0
ANDROID_NDK_VERSION=27.2.12479018
