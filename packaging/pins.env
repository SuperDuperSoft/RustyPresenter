# Pinned versions for packaging: the single place to bump them.
# Read by packaging/stage.sh, packaging/libmpv/*.sh and the GitHub workflows
# (`source` in bash, appended to $GITHUB_ENV in Actions), so keep plain KEY=VALUE
# lines: no spaces, no quotes, comments only on their own lines.

# Packager.
CARGO_PACKAGER_VERSION=0.11.8

# LGPL libmpv, built by .github/workflows/libmpv.yml and published on this repo's
# release `libmpv-r<LIBMPV_REV>`. The artifacts are
#   libmpv-<os>-<arch>-mpv<MPV_VERSION>-ff<FFMPEG_VERSION>-r<LIBMPV_REV>.zip
#   libmpv-sources-r<LIBMPV_REV>.tar.xz
# Bump LIBMPV_REV before building a new revision, publish the release, then fill in
# the sha256 values below (sha256sum of each published zip).
LIBMPV_REPO=SuperDuperSoft/RustyPresenter
LIBMPV_REV=1
# TODO(Plan 4 Task 16 Step 2): libmpv-r1 is not published yet. Fill these in from the
# release; stage.sh and the gated-video CI job refuse to run while they say TODO.
LIBMPV_SHA256_WINDOWS=TODO
LIBMPV_SHA256_MACOS=TODO
LIBMPV_SHA256_LINUX=TODO

# Sources built into libmpv. FFmpeg is configured without --enable-gpl, version3 or nonfree.
MPV_VERSION=0.41.0
# Backported onto v0.41.0 (git apply of the upstream commit).
MPV_BACKPORT=c5d391adba7bd024954d0df1e0405f5749f4d4ca
FFMPEG_VERSION=9.0.2
# mpv 0.41 needs libplacebo >= 6.338.2.
LIBPLACEBO_VERSION=7.360.1
# Headers only: libplacebo compiles its Vulkan stubs even with -Dvulkan=disabled.
VULKAN_HEADERS_VERSION=v1.4.304
# Static dependencies built into libmpv (git tags; freetype's tag is VER-<dashes>).
DAV1D_VERSION=1.5.4
FREETYPE_VERSION=2.14.3
HARFBUZZ_VERSION=14.6.0
FRIBIDI_VERSION=1.0.17
LIBASS_VERSION=0.17.5

# pdfium from bblanchon/pdfium-binaries: one tag, one archive per OS, each with its sha256
# (the release's own asset digests).
PDFIUM_TAG=chromium/8125
PDFIUM_SHA256_WINDOWS=9a964261760cff52570aabf038ab346d3a5034dd8b30d0d5fe8861235d356b8b
PDFIUM_SHA256_MACOS=4939bd935ac83ddc09a3a4f038bc43a19cea1660316a3667f26cb07a070e139d
PDFIUM_SHA256_LINUX=e1c3ce6e270cb5e0c20816b379ad9f2c1309972697c505f508de92bf5e7d6659
