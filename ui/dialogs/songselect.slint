// Songs from SongSelect: three steps, then the songs that came in from the Downloads folder while this window is
// open. The app never signs in to SongSelect; the person downloads in their own web browser. Filled and answered by
// `src/ui/dialogs/songselect.rs`.
import { Theme } from "../theme.slint";
import { Btn } from "../widgets.slint";
import { DialogBody, DialogFoot } from "shell.slint";
import { Lbl, Note } from "form.slint";

/// One song that came in: its title, "CCLI #n", what happened (`detail` is both, as shown), and whether it can be
/// added to the service.
export struct SongSelectRow { id: string, title: string, ccli: string, note: string, detail: string, problem: bool, can-add: bool, in-service: bool }

export global SongSelectDlg {
    in property <[SongSelectRow]> rows;
    /// "Watching Downloads (C:\Users\…\Downloads)", or why it can't.
    in property <string> watching;
    in property <bool> watching-problem;
    callback open-songselect();
    callback choose-file();
    callback add(string);
    callback close();
}

/// A numbered step.
component Step inherits HorizontalLayout {
    in property <string> number;
    in property <string> text;
    spacing: 10px;
    Rectangle {
        width: 26px;
        height: 26px;
        border-radius: 13px;
        background: Theme.tile-on-bg;
        Text {
            text: root.number;
            color: Theme.accent;
            font-family: Theme.font;
            font-size: Theme.base-size;
            font-weight: 700;
        }
    }
    Text {
        horizontal-stretch: 1;
        text: root.text;
        color: Theme.text;
        font-family: Theme.font;
        font-size: Theme.base-size;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

export component SongSelectDialog inherits VerticalLayout {
    DialogBody {
        VerticalLayout {
            spacing: 10px;
            step-1 := Step { number: "1"; text: @tr("Sign in to SongSelect in your web browser."); }
            step-2 := Step { number: "2"; text: @tr("Find the song and choose Download → Lyrics (or ChordPro)."); }
            step-3 := Step { number: "3"; text: @tr("It comes in here by itself."); }
        }
        Rectangle { height: 14px; }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            open-songselect := Btn {
                primary: true;
                icon: "download";
                text: @tr("Open SongSelect");
                clicked => { SongSelectDlg.open-songselect(); }
            }
            choose-file := Btn {
                text: @tr("Choose a file…");
                tooltip: @tr("For a song you downloaded before");
                clicked => { SongSelectDlg.choose-file(); }
            }
        }
        Rectangle { height: 10px; }
        watching := Text {
            text: SongSelectDlg.watching;
            color: SongSelectDlg.watching-problem ? Theme.danger-text : Theme.muted;
            font-family: Theme.font;
            font-size: 12.5px;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: self.text;
        }
        Rectangle { height: 14px; }
        Lbl { label: @tr("Songs that came in"); }
        Rectangle { height: 6px; }
        VerticalLayout {
            spacing: 4px;
            for r in SongSelectDlg.rows: came := Rectangle {
                background: Theme.panel-2;
                border-radius: 8px;
                accessible-role: list-item;
                accessible-label: r.title;
                accessible-description: r.note;
                HorizontalLayout {
                    padding: 8px;
                    padding-left: 12px;
                    spacing: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: r.title;
                            color: Theme.text;
                            font-family: Theme.font;
                            font-size: Theme.base-size;
                            font-weight: 650;
                            overflow: elide;
                        }
                        Text {
                            text: r.detail;
                            color: r.problem ? Theme.danger-text : Theme.muted;
                            font-family: Theme.font;
                            font-size: 12.5px;
                            wrap: word-wrap;
                        }
                    }
                    if r.can-add: add := Btn {
                        horizontal-stretch: 0;
                        small: true;
                        icon: r.in-service ? "" : "plus";
                        enabled: !r.in-service;
                        text: r.in-service ? @tr("In the service") : @tr("Add to the service");
                        clicked => { SongSelectDlg.add(r.id); }
                    }
                }
            }
        }
        if SongSelectDlg.rows.length == 0: nothing-yet := Text {
            text: @tr("Nothing yet. Songs you download from SongSelect show up here.");
            color: Theme.muted;
            font-family: Theme.font;
            font-size: Theme.base-size;
            wrap: word-wrap;
        }
        Rectangle { height: 14px; }
        Note { text: @tr("RustyPresenter never signs in to SongSelect and never downloads for you. It only reads the song files you download, and leaves your Downloads folder as it is."); }
    }
    DialogFoot {
        close := Btn { primary: true; text: @tr("Close"); clicked => { SongSelectDlg.close(); } }
    }
}
