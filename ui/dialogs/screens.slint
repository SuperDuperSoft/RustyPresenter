// Screen Configuration: the Audience and Stage lists on the left, the picked screen's settings on the right.
import { Theme } from "../theme.slint";
import { Btn, Chip } from "../widgets.slint";
import { Icon } from "../icons.slint";
import { DialogBody, DialogFoot } from "shell.slint";
import { Lbl, Note, RangeSlider, Select, Tabs, TextField, Toggle } from "form.slint";

/// A screen in a list. `state` is a `Chip` state.
export struct ScreenRow { id: string, name: string, size: string, status: string, state: string }

/// The Audience or the Stage list. `key` is what the actions call it.
export struct ScreenList { key: string, title: string, on: bool, rows: [ScreenRow] }

/// A connected monitor on the layout map: where it sits in the map (0–1 of its width and height), its number (as
/// Identify shows it), its resolution, and what shows on it ("Room", "Stage", "Main"); `used`: one of our screens.
export struct MonitorBox { x: float, y: float, w: float, h: float, number: string, size: string, shows: string, used: bool }

/// Set and answered by `src/ui/dialogs/screens.rs`.
export global ScreensDialogState {
    in property <[ScreenList]> lists;
    /// The id of the screen on the right.
    in property <string> selected;
    in property <string> kind;
    in-out property <string> name;
    in property <[string]> outputs;
    in-out property <int> output;
    /// A window's size can be typed; a monitor's is what the monitor is.
    in property <bool> size-editable;
    in property <bool> has-size;
    in-out property <string> width-text;
    in-out property <string> height-text;
    in property <string> size;
    in property <string> aspect;
    in property <string> note;
    in property <bool> can-remove;
    in property <bool> one-monitor;
    /// The connected monitors as Windows has them arranged, and the map's width over its height.
    in property <[MonitorBox]> monitors;
    in property <float> map-aspect: 1.78;
    /// "Slides are drawn at" (`Settings::draw_height`): the choices, the one picked, and what that means here.
    in property <[string]> draw-sizes;
    in-out property <int> draw-size;
    in property <string> draw-note;
    callback pick-draw-size(int);
    /// The system has a display settings page to open (Windows).
    in property <bool> has-display-settings;
    callback display-settings();
    /// N20: the Screen or Picture tab on the right.
    in-out property <int> tab;
    /// A stage screen can show the audience picture instead (`mirror`).
    in property <bool> is-stage;
    in property <bool> mirror;
    in property <[string]> tests;
    in-out property <int> test;
    /// Red, green, blue and black in %, gamma × 100.
    in-out property <int> red: 100;
    in-out property <int> green: 100;
    in-out property <int> blue: 100;
    in-out property <int> gamma: 100;
    in-out property <int> black;
    in property <[string]> corners;
    in-out property <int> corner;
    /// Where the picked corner is moved to, as text ("right 1.5 %, down 0 %").
    in property <string> corner-at;
    in-out property <string> delay-text;
    in property <string> delay-ms;
    /// Why colour and corners do not show here, if they don't.
    in property <string> fix-note;
    callback set-mirror(bool);
    callback pick-test(int);
    callback colour();
    callback nudge(int, int);
    callback reset-fix();
    callback delay();
    /// N12: an audience screen's mask. Shape 0 whole screen, 1 smaller rectangle, 2 rounded corners, 3 oval;
    /// `mask-inset` each side and `mask-radius` the corners, in percent.
    in property <bool> can-mask;
    in-out property <int> mask-shape;
    in-out property <int> mask-inset;
    in-out property <int> mask-radius;
    callback power(string, bool);
    callback add(string);
    callback select(string);
    callback rename(string);
    callback pick-output(int);
    callback resize();
    callback remove();
    callback identify();
    callback refresh();
    callback mask-changed();
}

/// A small label and a slider, side by side.
component MaskSlider inherits HorizontalLayout {
    in property <string> label;
    in property <int> maximum;
    in-out property <int> value;
    callback changed();
    spacing: 8px;
    Text {
        text: root.label;
        color: Theme.muted;
        font-family: Theme.font;
        font-size: 13px;
        vertical-alignment: center;
    }
    VerticalLayout {
        alignment: center;
        slider := RangeSlider {
            width: 110px;
            maximum: root.maximum;
            value <=> root.value;
            accessible-label: root.label;
            changed => { root.changed(); }
        }
    }
}

/// The round + at the end of a list's head.
component AddButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.raise : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Icon {
        name: "plus";
        color: Theme.text;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ScreenRowView inherits Rectangle {
    in property <ScreenRow> screen;
    property <bool> on: root.screen.id == ScreensDialogState.selected;
    border-radius: 9px;
    border-width: 1px;
    border-color: root.on ? Theme.accent : touch.has-hover ? Theme.line : transparent;
    background: root.on ? Theme.raise : transparent;
    accessible-role: list-item;
    accessible-label: root.screen.name;
    accessible-checked: root.on;
    accessible-action-default => { ScreensDialogState.select(root.screen.id); }
    HorizontalLayout {
        padding-top: 7px;
        padding-bottom: 7px;
        padding-left: 11px;
        padding-right: 9px;
        spacing: 8px;
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            Text {
                text: root.screen.name;
                color: Theme.text;
                font-family: Theme.font;
                font-size: Theme.base-size;
                font-weight: 600;
                overflow: elide;
            }
            if root.screen.size != "": Text {
                text: root.screen.size;
                color: Theme.muted;
                font-family: Theme.font;
                font-size: 12.5px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            status := Chip {
                text: root.screen.status;
                state: root.screen.state;
                accessible-role: text;
                accessible-label: root.screen.status;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { ScreensDialogState.select(root.screen.id); }
    }
}

component ScreenListView inherits VerticalLayout {
    in property <ScreenList> list;
    spacing: 4px;
    HorizontalLayout {
        spacing: 10px;
        padding-bottom: 2px;
        VerticalLayout {
            alignment: center;
            power := Toggle {
                on: root.list.on;
                label: root.list.title;
                toggled(on) => { ScreensDialogState.power(root.list.key, on); }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.list.title;
            color: Theme.text;
            font-family: Theme.display;
            font-size: 16px;
            font-weight: 600;
            vertical-alignment: center;
        }
        add-btn := AddButton {
            label: @tr("Add a screen to {}", root.list.title);
            clicked => { ScreensDialogState.add(root.list.key); }
        }
    }
    for r in root.list.rows: row-view := ScreenRowView { screen: r; }
}

/// A heading over one setting.
component Setting inherits VerticalLayout {
    in property <string> label;
    spacing: 6px;
    Lbl { label: root.label; }
    @children
}

/// The connected monitors, drawn where the system has them: each with its number, its resolution and what it shows.
component MonitorMap inherits Rectangle {
    height: 120px;
    property <length> inner-w: min(self.width, self.height * ScreensDialogState.map-aspect);
    property <length> inner-h: self.inner-w / ScreensDialogState.map-aspect;
    for m in ScreensDialogState.monitors: Rectangle {
        x: (root.width - root.inner-w) / 2 + root.inner-w * m.x + 1px;
        y: (root.height - root.inner-h) / 2 + root.inner-h * m.y + 1px;
        width: max(0px, root.inner-w * m.w - 2px);
        height: max(0px, root.inner-h * m.h - 2px);
        border-radius: 5px;
        border-width: m.used ? 2px : 1px;
        border-color: m.used ? Theme.accent : Theme.dash;
        background: Theme.panel-2;
        clip: true;
        VerticalLayout {
            alignment: center;
            padding: 2px;
            Text {
                text: m.number;
                color: Theme.text;
                font-family: Theme.font;
                font-size: 15px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: m.size;
                color: Theme.muted;
                font-family: Theme.font;
                font-size: 11px;
                horizontal-alignment: center;
                overflow: elide;
            }
            if m.shows != "": Text {
                text: m.shows;
                color: m.used ? Theme.accent : Theme.muted;
                font-family: Theme.font;
                font-size: 11px;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }
}

/// One colour setting: its name, a slider and the number.
component ColourRow inherits HorizontalLayout {
    in property <string> label;
    in property <int> minimum;
    in property <int> maximum;
    in-out property <int> value;
    in property <string> shown;
    callback changed();
    spacing: 10px;
    Text {
        width: 96px;
        text: root.label;
        color: Theme.text;
        font-family: Theme.font;
        font-size: 13.5px;
        vertical-alignment: center;
    }
    slider := RangeSlider {
        horizontal-stretch: 1;
        minimum: root.minimum;
        maximum: root.maximum;
        value <=> root.value;
        accessible-label: root.label;
        changed => { root.changed(); }
    }
    Text {
        width: 52px;
        text: root.shown;
        color: Theme.muted;
        font-family: Theme.font;
        font-size: 13px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

/// The Picture tab (N20): test patterns, colour, corners and delay for the picked screen.
component PictureFix inherits VerticalLayout {
    spacing: 14px;
    alignment: start;
    Setting {
        label: @tr("Test pattern");
        test-select := Select {
            options: ScreensDialogState.tests;
            index <=> ScreensDialogState.test;
            changed(i) => { ScreensDialogState.pick-test(i); }
        }
    }
    Setting {
        label: @tr("Colour");
        red-row := ColourRow {
            label: @tr("Red");
            minimum: 0;
            maximum: 200;
            value <=> ScreensDialogState.red;
            shown: ScreensDialogState.red + " %";
            changed => { ScreensDialogState.colour(); }
        }
        green-row := ColourRow {
            label: @tr("Green");
            minimum: 0;
            maximum: 200;
            value <=> ScreensDialogState.green;
            shown: ScreensDialogState.green + " %";
            changed => { ScreensDialogState.colour(); }
        }
        blue-row := ColourRow {
            label: @tr("Blue");
            minimum: 0;
            maximum: 200;
            value <=> ScreensDialogState.blue;
            shown: ScreensDialogState.blue + " %";
            changed => { ScreensDialogState.colour(); }
        }
        gamma-row := ColourRow {
            label: @tr("Gamma");
            minimum: 40;
            maximum: 250;
            value <=> ScreensDialogState.gamma;
            shown: (ScreensDialogState.gamma / 100).to-fixed(2);
            changed => { ScreensDialogState.colour(); }
        }
        black-row := ColourRow {
            label: @tr("Black level");
            minimum: 0;
            maximum: 30;
            value <=> ScreensDialogState.black;
            shown: ScreensDialogState.black + " %";
            changed => { ScreensDialogState.colour(); }
        }
    }
    Setting {
        label: @tr("Corners (to square up a tilted projector)");
        HorizontalLayout {
            spacing: 8px;
            corner-select := Select {
                width: 150px;
                options: ScreensDialogState.corners;
                index <=> ScreensDialogState.corner;
                // A nudge of nothing redraws where the newly picked corner is.
                changed => { ScreensDialogState.nudge(0, 0); }
            }
            left-btn := Btn { small: true; text: "←"; tooltip: @tr("Move this corner left"); clicked => { ScreensDialogState.nudge(-1, 0); } }
            right-btn := Btn { small: true; text: "→"; tooltip: @tr("Move this corner right"); clicked => { ScreensDialogState.nudge(1, 0); } }
            up-btn := Btn { small: true; text: "↑"; tooltip: @tr("Move this corner up"); clicked => { ScreensDialogState.nudge(0, -1); } }
            down-btn := Btn { small: true; text: "↓"; tooltip: @tr("Move this corner down"); clicked => { ScreensDialogState.nudge(0, 1); } }
            Rectangle { horizontal-stretch: 1; }
        }
        corner-text := Text {
            text: ScreensDialogState.corner-at;
            color: Theme.muted;
            font-family: Theme.font;
            font-size: 13px;
        }
    }
    Setting {
        label: @tr("Delay (frames)");
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            delay-field := TextField {
                width: 96px;
                height: 38px;
                label: @tr("Delay (frames)");
                text <=> ScreensDialogState.delay-text;
                edited => { ScreensDialogState.delay(); }
            }
            Text {
                text: ScreensDialogState.delay-ms;
                color: Theme.muted;
                font-family: Theme.font;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
    if ScreensDialogState.fix-note != "": fix-note := Note { text: ScreensDialogState.fix-note; font-size: 13px; }
    HorizontalLayout {
        alignment: start;
        reset-btn := Btn {
            small: true;
            icon: "restart";
            text: @tr("Reset the picture");
            clicked => { ScreensDialogState.reset-fix(); }
        }
    }
}

export component ScreensDialog inherits VerticalLayout {
    DialogBody {
        HorizontalLayout {
            spacing: 22px;
            VerticalLayout {
                width: 280px;
                spacing: 18px;
                alignment: start;
                for l in ScreensDialogState.lists: list := ScreenListView { list: l; }
                if ScreensDialogState.monitors.length > 0: Setting {
                    label: @tr("Connected screens");
                    monitor-map := MonitorMap {}
                }
            }
            Rectangle {
                width: 1px;
                background: Theme.line;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                spacing: 16px;
                alignment: start;
                tabs := Tabs {
                    labels: [@tr("Screen"), @tr("Picture")];
                    index <=> ScreensDialogState.tab;
                }
                if ScreensDialogState.tab == 1: picture := PictureFix {}
                if ScreensDialogState.tab == 0: VerticalLayout {
                spacing: 16px;
                alignment: start;
                Setting {
                    label: ScreensDialogState.kind;
                    name-field := TextField {
                        height: 38px;
                        label: @tr("Name");
                        text <=> ScreensDialogState.name;
                        edited(t) => { ScreensDialogState.rename(t); }
                    }
                }
                Setting {
                    label: @tr("Output");
                    output-select := Select {
                        options: ScreensDialogState.outputs;
                        index <=> ScreensDialogState.output;
                        changed(i) => { ScreensDialogState.pick-output(i); }
                    }
                }
                if ScreensDialogState.has-size: Setting {
                    label: @tr("Size");
                    if ScreensDialogState.size-editable: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        width-field := TextField {
                            width: 96px;
                            height: 38px;
                            label: @tr("Width");
                            text <=> ScreensDialogState.width-text;
                            edited => { ScreensDialogState.resize(); }
                        }
                        Text {
                            text: "×";
                            color: Theme.muted;
                            font-family: Theme.font;
                            font-size: Theme.base-size;
                            vertical-alignment: center;
                        }
                        height-field := TextField {
                            width: 96px;
                            height: 38px;
                            label: @tr("Height");
                            text <=> ScreensDialogState.height-text;
                            edited => { ScreensDialogState.resize(); }
                        }
                    }
                    if !ScreensDialogState.size-editable: size-text := Text {
                        text: ScreensDialogState.size;
                        color: Theme.text;
                        font-family: Theme.font;
                        font-size: Theme.base-size;
                    }
                    if ScreensDialogState.aspect != "": aspect-text := Text {
                        text: @tr("Aspect ratio: {}", ScreensDialogState.aspect);
                        color: Theme.muted;
                        font-family: Theme.font;
                        font-size: 13px;
                    }
                }
                if ScreensDialogState.can-mask && ScreensDialogState.has-size: Setting {
                    label: @tr("Slides are drawn at");
                    HorizontalLayout {
                        alignment: start;
                        draw-select := Select {
                            width: 280px;
                            options: ScreensDialogState.draw-sizes;
                            index <=> ScreensDialogState.draw-size;
                            changed(i) => { ScreensDialogState.pick-draw-size(i); }
                        }
                    }
                    draw-note := Text {
                        text: ScreensDialogState.draw-note;
                        color: Theme.muted;
                        font-family: Theme.font;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
                if ScreensDialogState.is-stage: HorizontalLayout {
                    spacing: 10px;
                    mirror-toggle := Toggle {
                        on: ScreensDialogState.mirror;
                        label: @tr("Show what the audience screen shows");
                        toggled(on) => { ScreensDialogState.set-mirror(on); }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: @tr("Show what the audience screen shows");
                        color: Theme.text;
                        font-family: Theme.font;
                        font-size: Theme.base-size;
                        vertical-alignment: center;
                    }
                }
                if ScreensDialogState.can-mask: Setting {
                    label: @tr("Shape");
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;
                        mask-select := Select {
                            width: 200px;
                            options: [@tr("Whole screen"), @tr("Smaller rectangle"), @tr("Rounded corners"), @tr("Oval")];
                            index <=> ScreensDialogState.mask-shape;
                            changed => { ScreensDialogState.mask-changed(); }
                        }
                        if ScreensDialogState.mask-shape > 0: mask-inset := MaskSlider {
                            label: @tr("Edge");
                            maximum: 40;
                            value <=> ScreensDialogState.mask-inset;
                            changed => { ScreensDialogState.mask-changed(); }
                        }
                        if ScreensDialogState.mask-shape == 2: mask-radius := MaskSlider {
                            label: @tr("Corners");
                            maximum: 50;
                            value <=> ScreensDialogState.mask-radius;
                            changed => { ScreensDialogState.mask-changed(); }
                        }
                    }
                }
                if ScreensDialogState.note != "": note-box := Note { text: ScreensDialogState.note; font-size: 13px; }
                if ScreensDialogState.one-monitor: one-screen-note := Note {
                    font-size: 13px;
                    text: @tr("Only one screen is connected. Plug in the projector/TV (and set Windows to “Extend these displays” with Win+P), then click Refresh.");
                }
                if ScreensDialogState.can-remove: HorizontalLayout {
                    alignment: start;
                    remove-btn := Btn {
                        danger: true;
                        small: true;
                        icon: "trash";
                        text: @tr("Remove this screen");
                        clicked => { ScreensDialogState.remove(); }
                    }
                }
                }
            }
        }
    }
    DialogFoot {
        alignment: stretch;
        identify-btn := Btn {
            icon: "monitor";
            text: @tr("Identify");
            tooltip: @tr("Show each screen's number on it for a few seconds");
            clicked => { ScreensDialogState.identify(); }
        }
        if ScreensDialogState.has-display-settings: display-settings-btn := Btn {
            text: @tr("Windows display settings");
            tooltip: @tr("Change a screen's resolution or how the screens are arranged, in Windows");
            clicked => { ScreensDialogState.display-settings(); }
        }
        Rectangle { horizontal-stretch: 1; }
        refresh-btn := Btn {
            icon: "restart";
            text: @tr("Refresh");
            clicked => { ScreensDialogState.refresh(); }
        }
    }
}
