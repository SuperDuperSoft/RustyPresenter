// What the Settings dialog shows and edits (`operator.js:877-1007`), shared by its tab files and set from
// `src/ui/dialogs/settings.rs`. The form fields are `in-out`: the Rust side reads them back on Save.
import { BgChoice } from "background-picker.slint";

/// A translation row of Settings → Bible: its status chip and the line under its name.
export struct SettingsBibleRow { translation: string, hint: string, chip: string, chip-state: string, imported: bool }

/// A line of the Bible library list (Settings → Bible): a language heading when `heading` is set, else a Bible.
/// `button` is "Add", "Update", "Remove", "Cancel" or empty; `progress` is 0–100 while downloading, else -1.
/// `font-warning` is set when no font here can draw the title or the language's name.
export struct SettingsCatalogRow {
    heading: string, abbr: string, title: string, tag: string, status: string, button: string, progress: float,
    enabled: bool, primary: bool, font-warning: string,
}

/// An online Bible service row of Settings → Bible.
export struct SettingsProviderRow { label: string, for-text: string, key-set: bool, signup-url: string, note: string }

/// A credit of Settings → Bible: the Bible's notice with its licence, and where to read the licence (may be empty).
export struct SettingsCreditRow { text: string, url: string }

/// A backup row: when it was made and what it holds.
export struct SettingsBackupRow { label: string, counts: string }

/// A row of the keyboard table in Help.
export struct SettingsHelpRow { keys: string, what: string }

export global SettingsDlg {
    /// 0 Look, 1 Songs, 2 Bible, 3 Video, 4 Backups, 5 Help, 6 About.
    in-out property <int> tab;

    // ---- Look ----
    in property <[string]> fonts;
    in-out property <int> font-index;
    in-out property <int> size: 84;
    in-out property <int> scripture-size: 64;
    /// Verses per slide for new passages: 0 Automatic, else 1–4.
    in-out property <int> bible-per-slide;
    in-out property <string> color: "#ffffff";
    /// The parsed `color`, for the swatch.
    in property <color> color-swatch;
    /// 0 Middle, 1 Lower third.
    in-out property <int> position;
    in-out property <bool> shadow;
    in-out property <bool> uppercase;
    // ---- Video ----
    /// Keep the room screen on top while it has a monitor of its own (`Settings::room_on_top`).
    in-out property <bool> room-on-top: true;
    in property <bool> has-logo;
    in property <image> logo;
    in property <image> preview;
    /// "“F” isn't installed on this computer…", or empty.
    in property <string> font-note;
    /// The Default background picker's tiles (`background::Picker`, no "Theme default").
    in property <[BgChoice]> backgrounds;
    /// The colour grid of Text color and the custom background colour.
    in property <[color]> palette;

    // ---- Songs ----
    /// Lines per slide minus one (0–5).
    in-out property <int> lines;
    /// 0 On first slide, 1 On last slide, 2 Off.
    in-out property <int> credits;
    in-out property <string> ccli;

    // ---- Bible ----
    in property <[SettingsBibleRow]> bible-sources;
    in property <[SettingsProviderRow]> bible-providers;
    in property <[SettingsCreditRow]> bible-credits;
    /// The Bibles that can be used now (`available`), as "KJV — King James Version", and the one in use.
    in property <[string]> default-bibles;
    in-out property <int> default-bible;
    in-out property <string> bible-short;
    /// The library list: what matches the search, filter and language, with headings.
    in property <[SettingsCatalogRow]> catalog-rows;
    in-out property <string> catalog-search;
    /// 0 Installed, 1 All.
    in-out property <int> catalog-filter: 1;
    /// "All languages", then each language in the list.
    in property <[string]> catalog-languages: ["All languages"];
    in-out property <int> catalog-language;
    /// "Loading the list of Bibles…", "You're offline…", "Showing 200 of 950…", or empty.
    in property <string> catalog-note;
    in property <bool> catalog-loading;

    // ---- Video ----
    in property <string> video-player;
    in property <string> video-drawing;
    /// Where sound goes: what the list shows, the device each line means, and the chosen line.
    in property <[string]> audio-labels;
    in property <[string]> audio-names;
    in-out property <int> audio-index;

    // ---- Backups ----
    in property <string> backups-folder;
    in property <[SettingsBackupRow]> backups;

    // ---- Help ----
    in property <[SettingsHelpRow]> help;

    // ---- About (Task 21) ----
    in property <string> about-version;
    in property <string> about-data-folder;
    in property <string> about-video;
    in property <string> about-mpv;
    in property <string> about-ffmpeg;
    in property <string> about-pdfium;
    in property <string> about-libreoffice;
    in property <string> about-powerpoint;
    in property <string> about-licence;
    in property <bool> licences-open;
    in property <string> licences;

    callback tab-changed(int);
    /// Any Look edit: the preview is drawn again 150 ms later.
    callback look-changed();
    callback choose-logo();
    callback remove-logo();
    /// Text color: a grid colour, or what was typed into its hex field.
    callback text-color(color);
    callback text-hex(string);
    callback pick-background(int);
    callback background-color(color);
    callback background-hex(string);
    callback upload-background();
    callback save-key(int, string);
    callback copy-link(int);
    callback import-bible();
    callback remove-import(int);
    /// The library list: a new search, filter or language, and a row's button.
    callback catalog-changed();
    callback catalog-button(int);
    /// Default Bible: applied at once (`settings/translation`), like the Bible box's chips; Cancel keeps it.
    callback default-bible-changed(int);
    callback backup-now();
    callback restore(int);
    callback show-licences(bool);
    callback cancel();
    callback save();
}
