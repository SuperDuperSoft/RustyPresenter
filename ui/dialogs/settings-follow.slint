// Settings → Auto-follow (1.3): songs follow the singers. The sound input with a level meter and Test, the songs'
// usual mode, the lead time, when the words go off, and how sure a jump must be. Read and written by
// `src/ui/dialogs/settings_follow.rs`.
import { Theme } from "../theme.slint";
import { Btn, Field, Segmented, ScrollBox } from "../widgets.slint";
import { TextField, Note, Select, Check, RangeSlider } from "form.slint";
import { SettingsDlg } from "settings-state.slint";
import { Heading } from "settings-media.slint";

component SettingsFollowMain inherits VerticalLayout {
    spacing: 4px;
    Note {
        text: @tr("RustyPresenter listens to the band and moves the song's slides by itself. The sound never leaves this computer.");
    }
    Rectangle { height: 10px; }
    Heading { text: @tr("Listening"); }
    Rectangle { height: 6px; }
    Field {
        label: @tr("Sound input");
        help: @tr("Best: the lead singer's microphone on its own, sent from the sound desk. Next best: the main mix. A microphone in the room hears too much else.");
        follow-device := Select {
            options: SettingsDlg.follow-device-labels;
            index <=> SettingsDlg.follow-device-index;
        }
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                follow-level := Rectangle {
                    accessible-role: progress-indicator;
                    accessible-label: @tr("Sound level");
                    accessible-value-minimum: 0;
                    accessible-value-maximum: 1;
                    accessible-value: SettingsDlg.follow-level;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.line;
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(SettingsDlg.follow-level, 0, 1);
                        border-radius: 4px;
                        background: Theme.ok;
                    }
                }
            }
            follow-test := Btn {
                small: true;
                text: @tr("Test");
                tooltip: @tr("Sing or say a line: the meter moves when it hears you.");
                clicked => { SettingsDlg.follow-test(); }
            }
        }
        if SettingsDlg.follow-test-result != "": follow-test-result := Text {
            text: SettingsDlg.follow-test-result;
            color: Theme.muted;
            font-family: Theme.font;
            font-size: 12.5px;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: self.text;
        }
    }
    Field {
        label: @tr("Songs follow the singers");
        help: @tr("A song can have its own in Edit item. Key A turns Auto on and off for the live song, H holds it.");
        HorizontalLayout {
            alignment: start;
            follow-mode := Segmented {
                labels: [@tr("auto-follow" => "Manual"), @tr("auto-follow" => "Suggest"), @tr("auto-follow" => "Auto")];
                index <=> SettingsDlg.follow-mode;
            }
        }
    }
    Rectangle { height: 10px; }
    Heading { text: @tr("Timing"); }
    Rectangle { height: 6px; }
    Field {
        label: @tr("Show the next slide before it is sung");
        help: @tr("Early enough to read, not so early that people sing ahead.");
        HorizontalLayout {
            spacing: 12px;
            follow-lead := RangeSlider {
                horizontal-stretch: 1;
                minimum: 5;
                maximum: 40;
                value <=> SettingsDlg.follow-lead;
            }
            follow-lead-text := Text {
                min-width: 48px;
                text: @tr("{} s", (SettingsDlg.follow-lead / 10).to-fixed(1));
                color: Theme.text;
                font-family: Theme.font;
                vertical-alignment: center;
                accessible-role: text;
                accessible-label: self.text;
            }
        }
    }
    Field {
        label: @tr("When nobody sings");
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            follow-blank-on := Check {
                text: @tr("Take the words off after (seconds)");
                checked <=> SettingsDlg.follow-blank-on;
            }
            if SettingsDlg.follow-blank-on: follow-blank-secs := TextField { width: 70px; text <=> SettingsDlg.follow-blank-secs; }
        }
    }
    Field {
        label: @tr("When someone talks or prays");
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            follow-talk-on := Check {
                text: @tr("Take the words off after (seconds)");
                checked <=> SettingsDlg.follow-talk-on;
            }
            if SettingsDlg.follow-talk-on: follow-talk-secs := TextField { width: 70px; text <=> SettingsDlg.follow-talk-secs; }
        }
    }
    Field {
        label: @tr("Jump to another part of the song after (words heard in a row)");
        help: @tr("More words: fewer wrong jumps, but slower to follow a change in the order.");
        follow-jump := TextField { width: 70px; text <=> SettingsDlg.follow-jump; }
    }
    Rectangle { height: 10px; }
    Heading { text: @tr("Listening model"); }
    Rectangle { height: 6px; }
    Field {
        label: @tr("Speech model");
        help: @tr("Downloaded once, then it works without internet. Apache-2.0, by Facebook AI.");
        HorizontalLayout {
            alignment: start;
            model-pick := Segmented {
                labels: [@tr("Fast (English)"), @tr("Best (all languages)")];
                index <=> SettingsDlg.model-pick;
                changed(i) => { SettingsDlg.model-pick-changed(i); }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            if SettingsDlg.model-installed: model-installed := Text {
                text: @tr("Installed ✓ ({})", SettingsDlg.model-size);
                color: Theme.ok;
                font-family: Theme.font;
                font-weight: 700;
                vertical-alignment: center;
                accessible-role: text;
                accessible-label: self.text;
            }
            if SettingsDlg.model-installed: model-remove := Btn {
                small: true;
                enabled: !SettingsDlg.model-busy;
                text: @tr("Remove");
                clicked => { SettingsDlg.model-remove(); }
            }
            if !SettingsDlg.model-installed && !SettingsDlg.model-downloading: model-download := Btn {
                small: true;
                primary: true;
                enabled: !SettingsDlg.model-busy;
                text: @tr("Download ({})", SettingsDlg.model-size);
                clicked => { SettingsDlg.model-download(); }
            }
            if SettingsDlg.model-downloading: model-cancel := Btn {
                small: true;
                text: @tr("Cancel");
                clicked => { SettingsDlg.model-cancel(); }
            }
            model-speed-check := Btn {
                small: true;
                enabled: !SettingsDlg.model-checking;
                text: @tr("Test speed");
                tooltip: @tr("Tries the downloaded models on this PC and says which one suits it.");
                clicked => { SettingsDlg.model-speed-check(); }
            }
        }
        if SettingsDlg.model-downloading: model-progress := Rectangle {
            accessible-role: progress-indicator;
            accessible-label: @tr("Download");
            accessible-value: SettingsDlg.model-progress;
            height: 8px;
            border-radius: 4px;
            background: Theme.line;
            Rectangle {
                x: 0;
                width: parent.width * clamp(SettingsDlg.model-progress, 0, 1);
                border-radius: 4px;
                background: Theme.accent;
            }
        }
        if SettingsDlg.model-status != "": model-status := Text {
            text: SettingsDlg.model-status;
            color: Theme.muted;
            font-family: Theme.font;
            font-size: 12.5px;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: self.text;
        }
        if SettingsDlg.model-speed != "": model-speed := Text {
            text: SettingsDlg.model-speed;
            color: Theme.text;
            font-family: Theme.font;
            font-size: 12.5px;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: self.text;
        }
    }
}

/// A list of log lines, or `empty` when there are none.
component LogLines inherits Rectangle {
    in property <[string]> lines;
    in property <string> empty;
    min-height: 220px;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.bg;
    if root.lines.length == 0: Text {
        text: root.empty;
        color: Theme.muted;
        font-family: Theme.font;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    if root.lines.length > 0: ScrollBox {
        VerticalLayout {
            padding: 10px;
            spacing: 4px;
            for line in root.lines: log-line := Text {
                text: line;
                color: Theme.text;
                font-family: Theme.font;
                font-size: 12.5px;
                wrap: word-wrap;
                accessible-role: list-item;
                accessible-label: self.text;
            }
        }
    }
}

component SettingsFollowPractice inherits VerticalLayout {
    spacing: 4px;
    Note {
        text: @tr("Play a recording (for example last Sunday's) through auto-follow to see what it would do. Nothing changes on the screens.");
    }
    Rectangle { height: 10px; }
    Field {
        label: @tr("Recording");
        HorizontalLayout {
            spacing: 10px;
            practice-file := Text {
                horizontal-stretch: 1;
                text: SettingsDlg.practice-file != "" ? SettingsDlg.practice-file : @tr("No recording chosen");
                color: SettingsDlg.practice-file != "" ? Theme.text : Theme.muted;
                font-family: Theme.font;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: text;
                accessible-label: self.text;
            }
            practice-choose := Btn {
                small: true;
                text: @tr("Choose recording…");
                clicked => { SettingsDlg.practice-choose(); }
            }
        }
    }
    Field {
        label: @tr("Song");
        practice-song := Select {
            options: SettingsDlg.practice-songs;
            index <=> SettingsDlg.practice-song;
        }
    }
    HorizontalLayout {
        alignment: start;
        spacing: 10px;
        practice-run := Btn {
            primary: true;
            enabled: !SettingsDlg.practice-running && SettingsDlg.practice-file != "" && SettingsDlg.practice-songs.length > 0;
            text: @tr("Practice");
            clicked => { SettingsDlg.practice-run(); }
        }
        practice-status := Text {
            text: SettingsDlg.practice-status;
            color: Theme.muted;
            font-family: Theme.font;
            vertical-alignment: center;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: self.text;
        }
    }
    Rectangle { height: 8px; }
    practice-log := LogLines {
        lines: SettingsDlg.practice-lines;
        empty: @tr("What auto-follow would have done shows here.");
    }
}

component SettingsFollowReview inherits VerticalLayout {
    spacing: 8px;
    Note {
        text: @tr("Every slide change auto-follow made or suggested since RustyPresenter started: when, what, why, and how sure it was.");
    }
    review-log := LogLines {
        lines: SettingsDlg.review-lines;
        empty: @tr("Nothing yet: auto-follow hasn't moved or suggested a slide.");
    }
    HorizontalLayout {
        alignment: start;
        review-copy := Btn {
            small: true;
            enabled: SettingsDlg.review-lines.length > 0;
            text: @tr("Copy to clipboard");
            clicked => { SettingsDlg.review-copy(); }
        }
    }
}

export component SettingsFollow inherits VerticalLayout {
    HorizontalLayout {
        alignment: start;
        padding-bottom: 12px;
        follow-page := Segmented {
            labels: [@tr("Settings"), @tr("Practice"), @tr("Review log")];
            index <=> SettingsDlg.follow-page;
        }
    }
    if SettingsDlg.follow-page == 0: SettingsFollowMain {}
    if SettingsDlg.follow-page == 1: SettingsFollowPractice {}
    if SettingsDlg.follow-page == 2: SettingsFollowReview {}
}
