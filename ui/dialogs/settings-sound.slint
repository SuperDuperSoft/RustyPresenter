// Settings → Media → Livestream: the stream's sound (`src/ui/dialogs/settings_sound.rs`). "Sound setup" and the
// other inputs, the phone and Listen go with the easy settings; "More sound settings" opens each sound's filters.
import { Theme } from "../theme.slint";
import { Field, Segmented } from "../widgets.slint";
import { Select, Check, RangeSlider } from "form.slint";
import { SettingsDlg } from "settings-state.slint";
import { SoundFilters } from "sound-filters.slint";

/// A row's name on the left, as the sound levels have it.
component RowName inherits Text {
    color: Theme.text;
    font-family: Theme.font;
    font-size: Theme.base-size;
    vertical-alignment: center;
    min-width: 150px;
}

/// A slider from -12 to 12 dB with its value.
component DbRow inherits HorizontalLayout {
    in property <string> name;
    in property <int> minimum: -12;
    in property <int> maximum: 12;
    in-out property <int> value;
    spacing: 10px;
    RowName { text: root.name; }
    RangeSlider {
        minimum: root.minimum;
        maximum: root.maximum;
        value <=> root.value;
        horizontal-stretch: 1;
    }
    Text {
        text: @tr("{} dB", root.value);
        color: Theme.text;
        font-family: Theme.font;
        font-size: Theme.base-size;
        vertical-alignment: center;
        min-width: 64px;
    }
}

/// One sound's filters.
component FilterRows inherits VerticalLayout {
    in property <string> title;
    in-out property <SoundFilters> value;
    spacing: 6px;
    Text {
        text: root.title;
        color: Theme.text;
        font-family: Theme.font;
        font-size: Theme.base-size;
        font-weight: 700;
    }
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        RowName { text: @tr("Gate (quiet between words)"); }
        Segmented {
            labels: [@tr("Off"), @tr("Light"), @tr("Strong")];
            index <=> root.value.gate;
        }
    }
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        RowName { text: @tr("Evener (loud down, quiet up)"); }
        Segmented {
            labels: [@tr("Off"), @tr("Light"), @tr("Strong")];
            index <=> root.value.even;
        }
    }
    DbRow { name: @tr("Low (boom)"); value <=> root.value.low; }
    DbRow { name: @tr("Middle (voices)"); value <=> root.value.mid; }
    DbRow { name: @tr("High (clarity, hiss)"); value <=> root.value.high; }
    Check { text: @tr("Never too loud (keeps the stream from crackling; best left on)"); checked <=> root.value.limit; }
}

/// "Sound setup", the second and third inputs, the phone and Listen: after "Sound from this computer".
export component StreamSoundSetup inherits VerticalLayout {
    spacing: 4px;
    // The first input is a microphone or line-in (0 is no sound, 1 the app's sound).
    property <bool> has-input: SettingsDlg.record-sound-index >= 2;
    property <string> phone-key: "input:" + SettingsDlg.stream-phone-name;
    property <bool> phone: SettingsDlg.record-sound-names[SettingsDlg.record-sound-index] == root.phone-key
        || (root.has-input && SettingsDlg.stream-input-names[SettingsDlg.stream-input2-index] == SettingsDlg.stream-phone-name)
        || (root.has-input && SettingsDlg.stream-input2-index > 0 && SettingsDlg.stream-input-names[SettingsDlg.stream-input3-index] == SettingsDlg.stream-phone-name);
    Field {
        label: @tr("Sound setup");
        help: @tr("One choice sets the microphone and how each sound is cleaned up. Anything changed by hand below makes it Custom.")
            + (SettingsDlg.stream-sound-mode-note != "" ? " " + SettingsDlg.stream-sound-mode-note : "");
        stream-sound-mode := Select {
            options: SettingsDlg.stream-sound-mode-labels;
            index <=> SettingsDlg.stream-sound-mode;
            changed(i) => { SettingsDlg.stream-sound-mode-chosen(i); }
        }
    }
    if root.has-input: Field {
        label: @tr("Second microphone or line-in");
        help: @tr("While you are live, mixed with the one chosen under \"Sound in the recording\": for a second sound board, a pulpit microphone or the phone.");
        VerticalLayout {
            spacing: 6px;
            stream-input2 := Select {
                options: SettingsDlg.stream-input-labels;
                index <=> SettingsDlg.stream-input2-index;
            }
            if SettingsDlg.stream-input2-index > 0: DbRow { name: @tr("Its level"); minimum: -20; maximum: 20; value <=> SettingsDlg.stream-input2-level; }
        }
    }
    if root.has-input && SettingsDlg.stream-input2-index > 0: Field {
        label: @tr("Third microphone or line-in");
        VerticalLayout {
            spacing: 6px;
            stream-input3 := Select {
                options: SettingsDlg.stream-input-labels;
                index <=> SettingsDlg.stream-input3-index;
            }
            if SettingsDlg.stream-input3-index > 0: DbRow { name: @tr("Its level"); minimum: -20; maximum: 20; value <=> SettingsDlg.stream-input3-level; }
        }
    }
    if root.phone: Field {
        label: @tr("Phone microphone");
        help: @tr("Turn on the stage screen for phones (Settings → Network…), then open this page on the phone and press Start: {}", SettingsDlg.stream-phone-secure-address != "" ? SettingsDlg.stream-phone-secure-address : SettingsDlg.stream-phone-address)
            + " " + @tr("The first time, the phone warns that the page is not private, because this computer made its own certificate: tap Advanced (on an iPhone, Show Details), then go on to the page. Keep the phone awake and plugged in.");
    }
    Field {
        label: @tr("Listen to the stream");
        help: @tr("While you are live, the stream's sound plays here as viewers hear it (cleaned up and with the sound delay), for headphones at the desk. The room does not hear it unless it is the room's output.");
        stream-listen := Select {
            options: SettingsDlg.stream-listen-labels;
            index <=> SettingsDlg.stream-listen-index;
        }
    }
}

/// "More sound settings": each sound's filters. After "Sound clean-up".
export component StreamSoundMore inherits VerticalLayout {
    spacing: 4px;
    Field {
        label: @tr("More sound settings");
        help: @tr("For the stream only. Each sound has its own: start with the Sound setup above and change little at a time.");
        VerticalLayout {
            spacing: 12px;
            stream-sound-more := Check { text: @tr("Show each sound's gate, evener, low, middle and high"); checked <=> SettingsDlg.stream-sound-more; }
            if SettingsDlg.stream-sound-more && SettingsDlg.record-sound-index >= 2: FilterRows { title: @tr("Microphone or line-in"); value <=> SettingsDlg.stream-board-filters; }
            if SettingsDlg.stream-sound-more && SettingsDlg.record-sound-index >= 2 && SettingsDlg.stream-input2-index > 0: FilterRows {
                title: @tr("Second microphone or line-in");
                value <=> SettingsDlg.stream-input2-filters;
            }
            if SettingsDlg.stream-sound-more && SettingsDlg.record-sound-index >= 2 && SettingsDlg.stream-input2-index > 0 && SettingsDlg.stream-input3-index > 0: FilterRows {
                title: @tr("Third microphone or line-in");
                value <=> SettingsDlg.stream-input3-filters;
            }
            if SettingsDlg.stream-sound-more && SettingsDlg.stream-sound-index != 0: FilterRows { title: @tr("This computer"); value <=> SettingsDlg.stream-pc-filters; }
        }
    }
}
