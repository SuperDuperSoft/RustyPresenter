// Settings (`operator.js:877-1007`): the tabs, the Songs, Video, Backups and Help pages, and the footer. Look and
// Bible have files of their own. Everything shown comes from the `SettingsDlg` global (`settings-state.slint`).
import { Theme } from "../theme.slint";
import { Btn, Field, Segmented, CopyText } from "../widgets.slint";
import { DialogBody, DialogFoot } from "shell.slint";
import { TextField, Tabs, Note, Lbl, ListRow, RowMain, Check, Select } from "form.slint";
import { SettingsDlg } from "settings-state.slint";
import { SettingsLook } from "settings-look.slint";
import { SettingsBible } from "settings-bible.slint";
import { SettingsAbout } from "settings-about.slint";
import { SettingsLanguage } from "settings-language.slint";
import { SettingsThemes, ThemesDlg } from "settings-themes.slint";
import { SettingsSections } from "settings-sections.slint";
import { SettingsHelp } from "settings-keys.slint";
import { SettingsMedia, Heading } from "settings-media.slint";
import { SettingsFollow } from "settings-follow.slint";

export { SettingsDlg }

component SettingsSongsGeneral inherits VerticalLayout {
    Field {
        label: @tr("Lines per slide");
        HorizontalLayout {
            alignment: start;
            lines := Segmented {
                labels: ["1", "2", "3", "4", "5", "6"];
                index <=> SettingsDlg.lines;
            }
        }
    }
    Field {
        label: @tr("Credits");
        // Bible library spec §10: the setting covers scripture too; a Bible that requires its credit always shows it.
        help: @tr("Songs and Bible passages. Some Bibles require their credit to be shown; it appears once per passage.");
        credits-on := Check {
            text: @tr("Show the copyright line");
            checked <=> SettingsDlg.credits-on;
        }
        if SettingsDlg.credits-on: HorizontalLayout {
            alignment: start;
            credits := Segmented {
                labels: [@tr("On first and last slide"), @tr("On first slide"), @tr("On last slide")];
                index <=> SettingsDlg.credits;
            }
        }
    }
    if SettingsDlg.credits-on: Field {
        label: @tr("Copyright line");
        help: @tr("Use {{title}}, {{artist}}, {{author}}, {{publisher}}, {{year}}, {{copyright}}, {{ccli}} and {{license}}. Parts between · with nothing in them are left out. Empty: the usual line.");
        credit-template := TextField {
            text <=> SettingsDlg.credit-template;
            placeholder: SettingsDlg.credit-usual;
            edited => { SettingsDlg.credit-template-edited(); }
        }
        credit-sample := Text {
            text: SettingsDlg.credit-sample;
            color: Theme.muted;
            font-family: Theme.font;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
    Field {
        label: @tr("Church CCLI license #");
        ccli := TextField { text <=> SettingsDlg.ccli; }
    }
    Field {
        label: @tr("Section keys (C, B, 1–9…)");
        help: @tr("Turn off if letters typed by mistake move the screen.");
        section-keys := Check {
            text: @tr("Letters and numbers jump the live song to a section");
            checked <=> SettingsDlg.section-keys;
        }
    }
    HorizontalLayout {
        alignment: start;
        usage-report := Btn {
            small: true;
            text: @tr("Song use report…");
            clicked => { SettingsDlg.usage-report(); }
        }
    }
}

component SettingsSongs inherits VerticalLayout {
    // N19: the songs' general settings, or their sections and slide labels.
    HorizontalLayout {
        alignment: start;
        padding-bottom: 12px;
        songs-page := Segmented {
            labels: [@tr("General"), @tr("Sections and labels")];
            index <=> SettingsDlg.songs-page;
        }
    }
    if SettingsDlg.songs-page == 1: sections := SettingsSections {}
    if SettingsDlg.songs-page == 0: SettingsSongsGeneral {}
}

component SettingsVideo inherits VerticalLayout {
    spacing: 8px;
    Heading { text: @tr("Video and graphics"); }
    player := Text {
        text: SettingsDlg.video-player;
        color: Theme.text;
        wrap: word-wrap;
        accessible-role: text;
        accessible-label: self.text;
    }
    drawing := Text {
        text: SettingsDlg.video-drawing;
        color: Theme.muted;
        wrap: word-wrap;
        accessible-role: text;
        accessible-label: self.text;
    }
    Rectangle { height: 10px; }
    Field {
        label: @tr("Sound goes to");
        audio := Select {
            options: SettingsDlg.audio-labels;
            index <=> SettingsDlg.audio-index;
        }
    }
    Field {
        label: @tr("Graphics");
        help: @tr("Change this only if the screens flicker, stay black or RustyPresenter crashes. Used from the next start.");
        graphics := Select {
            options: SettingsDlg.graphics-labels;
            index <=> SettingsDlg.graphics-index;
            changed(i) => { SettingsDlg.graphics-changed(i); }
        }
        graphics-now := Text {
            text: SettingsDlg.graphics-now;
            color: Theme.muted;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: self.text;
        }
        HorizontalLayout {
            alignment: start;
            spacing: 10px;
            graphics-test := Btn {
                small: true;
                text: @tr("Test which is fastest");
                enabled: !SettingsDlg.graphics-testing;
                clicked => { SettingsDlg.graphics-test(); }
            }
            graphics-test-status := Text {
                text: SettingsDlg.graphics-test-status != "" ? SettingsDlg.graphics-test-status : @tr("About a minute. Test windows open and close while it runs, on the projector too when nothing is showing there.");
                color: Theme.muted;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
                accessible-role: text;
                accessible-label: self.text;
            }
        }
        for r[i] in SettingsDlg.graphics-test-rows: graphics-test-row := Rectangle {
            min-height: 30px;
            border-radius: 6px;
            background: SettingsDlg.graphics-test-pick == i ? Theme.raise : transparent;
            accessible-role: list-item;
            accessible-label: (r.best ? "★ " : "") + r.name + ": " + r.word + ". " + r.details;
            accessible-item-selectable: true;
            accessible-item-selected: SettingsDlg.graphics-test-pick == i;
            accessible-action-default => { SettingsDlg.graphics-test-pick = i; }
            TouchArea {
                enabled: r.works;
                mouse-cursor: r.works ? pointer : default;
                clicked => { SettingsDlg.graphics-test-pick = i; }
            }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 10px;
                Text {
                    width: 16px;
                    text: r.best ? "★" : "";
                    color: Theme.accent;
                    vertical-alignment: center;
                }
                Text {
                    width: 90px;
                    text: r.name;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 180px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.line;
                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(r.bar, 0, 1);
                            border-radius: 4px;
                            background: r.best ? Theme.accent : Theme.muted;
                        }
                    }
                }
                Text {
                    width: 80px;
                    text: r.word;
                    color: r.works ? Theme.text : Theme.muted;
                    vertical-alignment: center;
                }
                graphics-test-details := Text {
                    text: r.details;
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    accessible-role: text;
                    accessible-label: self.text;
                }
            }
        }
        if (SettingsDlg.graphics-test-rows.length > 0 && !SettingsDlg.graphics-testing) || SettingsDlg.graphics-restart: HorizontalLayout {
            alignment: start;
            spacing: 10px;
            if SettingsDlg.graphics-test-rows.length > 0 && !SettingsDlg.graphics-testing: graphics-test-use := Btn {
                small: true;
                primary: !SettingsDlg.graphics-restart;
                text: @tr("Use this");
                clicked => { SettingsDlg.graphics-test-use(SettingsDlg.graphics-test-pick); }
            }
            if SettingsDlg.graphics-restart: graphics-restart := Btn {
                small: true;
                primary: true;
                text: @tr("Restart now");
                clicked => { SettingsDlg.restart-now(); }
            }
        }
    }
    Field {
        label: @tr("Performance");
        help: @tr("Shows under the live preview how many frames a second the screens draw, and the free video memory when the graphics card says. Low numbers mean the computer is struggling.");
        show-performance := Check {
            text: @tr("Show performance");
            checked <=> SettingsDlg.show-performance;
        }
    }
    Rectangle { height: 10px; }
    Heading { text: @tr("Screens"); }
    Field {
        label: @tr("Room screen");
        room-on-top := Check {
            text: @tr("Keep the room screen in front when it has its own monitor (smoother fades)");
            checked <=> SettingsDlg.room-on-top;
        }
    }
    Field {
        label: @tr("At start");
        screens-at-start := Check {
            text: @tr("Turn the screens on when RustyPresenter starts");
            checked <=> SettingsDlg.screens-at-start;
        }
    }
    Field {
        label: @tr("Stage layout");
        help: @tr("What the stage screen shows. Window → Stage layouts… makes your own.");
        stage-layout := Select {
            options: SettingsDlg.stage-layout-names;
            index <=> SettingsDlg.stage-layout;
        }
    }
    Rectangle { height: 10px; }
    Heading { text: @tr("Phone drawing"); }
    Field {
        label: @tr("Drawing from a phone");
        VerticalLayout {
            keep-drawings := Check {
                text: @tr("Keep drawings when the slide changes");
                checked <=> SettingsDlg.keep-drawings;
            }
            stage-drawings := Check {
                text: @tr("Show drawings on the stage screen");
                checked <=> SettingsDlg.stage-drawings;
            }
        }
    }
    Field {
        label: @tr("Fading ink disappears after (seconds, 1–30)");
        help: @tr("On the phone, “Fades” ink works like a laser pointer: it goes away by itself.");
        fade-secs := TextField { text <=> SettingsDlg.fade-secs; }
    }
    Field {
        label: @tr("Limits");
        VerticalLayout {
            drawing-limit := Check {
                text: @tr("Limit phone drawing");
                checked <=> SettingsDlg.drawing-limit;
            }
            if SettingsDlg.drawing-limit: Field {
                label: @tr("Most lines on the screen at once");
                drawing-max-strokes := TextField { text <=> SettingsDlg.drawing-max-strokes; }
            }
            if SettingsDlg.drawing-limit: Field {
                label: @tr("Most drawing updates a second from one phone");
                drawing-max-per-second := TextField { text <=> SettingsDlg.drawing-max-per-second; }
            }
        }
    }
}

component SettingsBackups inherits VerticalLayout {
    Note {
        text: @tr("A full backup (songs, services, settings and every video, picture and slide) is made each time RustyPresenter starts and once a day. The last 10 are kept in");
        HorizontalLayout {
            alignment: start;
            padding-top: 4px;
            spacing: 2px;
            folder := CopyText { text: SettingsDlg.backups-folder; }
            Text {
                text: ".";
                color: Theme.muted;
                vertical-alignment: center;
            }
        }
    }
    Rectangle { height: 12px; }
    HorizontalLayout {
        alignment: start;
        backup-now := Btn {
            primary: true;
            text: @tr("Back up now");
            clicked => { SettingsDlg.backup-now(); }
        }
    }
    Rectangle { height: 12px; }
    VerticalLayout {
        spacing: 4px;
        for b[i] in SettingsDlg.backups: backup-row := ListRow {
            accessible-role: list-item;
            accessible-label: b.label;
            accessible-value: b.counts;
            RowMain {
                title: b.label;
                sub: b.counts;
            }
            restore := Btn {
                small: true;
                text: @tr("Restore");
                clicked => { SettingsDlg.restore(i); }
            }
        }
        if SettingsDlg.backups.length == 0: no-backups := Text {
            text: @tr("No backups yet.");
            color: Theme.muted;
        }
    }
}

/// The Settings dialog's content: put inside a `DialogShell`.
export component SettingsDialog inherits VerticalLayout {
    DialogBody {
        tabs := Tabs {
            labels: [@tr("Look"), @tr("Themes"), @tr("Language"), @tr("Songs"), @tr("Auto-follow"), @tr("Bible"), @tr("Video"), @tr("Media"), @tr("Backups"), @tr("Help"), @tr("About")];
            index <=> SettingsDlg.tab;
            changed(i) => { SettingsDlg.tab-changed(i); }
        }
        Rectangle { height: 14px; }
        if SettingsDlg.tab == 0: look := SettingsLook {}
        if SettingsDlg.tab == 1: themes := SettingsThemes {}
        if SettingsDlg.tab == 2: language := SettingsLanguage {}
        if SettingsDlg.tab == 3: songs := SettingsSongs {}
        if SettingsDlg.tab == 4: follow := SettingsFollow {}
        if SettingsDlg.tab == 5: bible := SettingsBible {}
        if SettingsDlg.tab == 6: video := SettingsVideo {}
        if SettingsDlg.tab == 7: media := SettingsMedia {}
        if SettingsDlg.tab == 8: backups := SettingsBackups {}
        if SettingsDlg.tab == 9: help := SettingsHelp {}
        if SettingsDlg.tab == 10: about := SettingsAbout {}
    }
    // While a theme is being edited, the footer saves the theme instead of the settings.
    if SettingsDlg.tab == 1 && ThemesDlg.editing: DialogFoot {
        theme-cancel := Btn {
            text: @tr("Cancel");
            clicked => { ThemesDlg.cancel-edit(); }
        }
        theme-save := Btn {
            primary: true;
            text: @tr("Save theme");
            clicked => { ThemesDlg.save-theme(); }
        }
    }
    if !(SettingsDlg.tab == 1 && ThemesDlg.editing): DialogFoot {
        cancel := Btn {
            text: @tr("Cancel");
            clicked => { SettingsDlg.cancel(); }
        }
        save := Btn {
            primary: true;
            text: @tr("Save settings");
            clicked => { SettingsDlg.save(); }
        }
    }
}
