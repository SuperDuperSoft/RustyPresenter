// The Add dialog's state shared with Rust (`AddState`) and its library lists (`searchList()`, `operator.js:399-410`;
// `.search`, `.list` and `.row` in `operator.css:163-173`).
import { Theme } from "../theme.slint";
import { Btn, Chip, Icon, ScrollBox } from "../widgets.slint";
import { TextField, ListRow, RowMain } from "form.slint";

/// One library row: a song, a media file or a set of slides.
export struct AddRow {
    id: string,
    title: string,
    subtitle: string,
    /// `.ico-box` icon (songs); empty for a row with a thumbnail.
    icon: string,
    /// `.thumbmini` (media and slides): a 96 px 16:9 picture on black, or `thumb-icon` until a picture exists.
    thumb-shown: bool,
    thumb: image,
    thumb-icon: string,
    /// `.status-chip` (media): text, "ok" / "warn" / "bad", and the reason as a tooltip.
    chip: string,
    chip-state: string,
    chip-tip: string,
    can-try-again: bool,
    can-edit: bool,
    /// The trash button and its tooltip.
    can-delete: bool,
    delete-tip: string,
    /// The entry's JSON, lowercased, for the search (product decision 5).
    key: string,
}

/// What Rust and the dialog share. The text the user types lives here, so a refresh of the list never wipes it.
export global AddState {
    /// 0 Song, 1 Bible, 2 Video & media, 3 Slides, 4 Announcement.
    in-out property <int> tab;
    in property <[AddRow]> rows;
    in property <string> placeholder;
    /// "Nothing matches." / "Nothing here yet.", or empty when there are rows.
    in property <string> empty;
    in property <string> translation;
    /// The translation has no source here, so its verses can be pasted (`operator.js:441`).
    in property <bool> can-paste;
    /// What the user typed in the fields; reset when the dialog opens.
    in-out property <string> search;
    in-out property <string> reference;
    in-out property <bool> paste-open;
    in-out property <string> pasted;
    in-out property <string> text-title;
    in-out property <string> text-body;

    /// The Slides tab's help when a presentation cannot be imported yet; empty when it can.
    in property <string> deck-help;
    /// The command in that help, for the Copy button; may be empty.
    in property <string> install-command;
    callback pick-tab(int);
    callback search-edited(string);
    callback new-song();
    callback import-lyrics();
    callback import-easyworship();
    callback edit-song(string);
    callback add-row(string);
    callback try-again(string);
    callback delete-row(string);
    callback bible-add();
    callback bible-paste();
    callback text-add();
    callback upload-media();
    callback import-deck();
    callback copy-install();
    callback check-libreoffice();
    callback pictures-to-slides();
}

/// `.row`: the picture or icon, the title and subtitle, then the row's buttons.
component AddListRow inherits ListRow {
    in property <AddRow> entry;
    accessible-role: list-item;
    accessible-label: root.entry.title;
    accessible-description: root.entry.subtitle;
    if root.entry.icon != "": VerticalLayout {
        alignment: center;
        Rectangle {
            width: 36px;
            height: 36px;
            border-radius: 9px;
            background: Theme.raise;
            Icon {
                name: root.entry.icon;
                color: Theme.muted;
            }
        }
    }
    if root.entry.icon == "": VerticalLayout {
        alignment: center;
        thumb := Rectangle {
            width: 96px;
            height: 54px;
            border-radius: 6px;
            background: Theme.black;
            clip: true;
            if root.entry.thumb-shown: Image {
                width: parent.width;
                height: parent.height;
                source: root.entry.thumb;
                image-fit: cover;
            }
            if !root.entry.thumb-shown && root.entry.thumb-icon != "": Icon {
                name: root.entry.thumb-icon;
                color: Theme.muted;
            }
        }
    }
    RowMain {
        title: root.entry.title;
        sub: root.entry.subtitle;
    }
    if root.entry.chip != "": VerticalLayout {
        alignment: center;
        chip := Chip {
            text: root.entry.chip;
            state: root.entry.chip-state;
            tooltip: root.entry.chip-tip;
            accessible-role: text;
            accessible-label: root.entry.chip;
            accessible-value: root.entry.chip-state;
            accessible-description: root.entry.chip-tip;
        }
    }
    if root.entry.can-try-again: VerticalLayout {
        alignment: center;
        try-again-btn := Btn {
            text: @tr("Try again");
            small: true;
            clicked => { AddState.try-again(root.entry.id); }
        }
    }
    if root.entry.can-edit: VerticalLayout {
        alignment: center;
        edit-btn := Btn {
            text: @tr("Edit");
            icon: "edit";
            small: true;
            clicked => { AddState.edit-song(root.entry.id); }
        }
    }
    if root.entry.can-delete: VerticalLayout {
        alignment: center;
        delete-btn := Btn {
            icon: "trash";
            small: true;
            tooltip: root.entry.delete-tip;
            accessible-role: button;
            accessible-label: root.entry.delete-tip;
            clicked => { AddState.delete-row(root.entry.id); }
        }
    }
    VerticalLayout {
        alignment: center;
        add-btn := Btn {
            text: @tr("Add");
            icon: "plus";
            small: true;
            primary: true;
            clicked => { AddState.add-row(root.entry.id); }
        }
    }
}

/// `searchList()`: a search field (focused when the tab opens) over the rows, 4 px apart, at most
/// `max-list-height` tall before it scrolls.
export component AddList inherits VerticalLayout {
    in property <length> max-list-height;
    VerticalLayout {
        padding-bottom: 10px;
        search := TextField {
            search: true;
            text <=> AddState.search;
            placeholder: AddState.placeholder;
            init => { self.focus(); }
            edited(t) => { AddState.search-edited(t); }
        }
    }
    if AddState.rows.length > 0: ScrollBox {
        height: min(lines.preferred-height, root.max-list-height);
        track-edge: Theme.panel;
        lines := VerticalLayout {
            spacing: 4px;
            for r in AddState.rows: row := AddListRow { entry: r; }
        }
    }
    if AddState.rows.length == 0: empty := Text {
        text: AddState.empty;
        color: Theme.muted;
        font-family: Theme.font;
        font-size: Theme.base-size;
        horizontal-alignment: center;
        accessible-label: self.text;
        // `.empty`: 28 px 18 px padding.
        height: self.preferred-height + 56px;
        vertical-alignment: center;
    }
}
