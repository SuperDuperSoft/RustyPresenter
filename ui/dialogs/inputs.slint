// The dialogs' text fields (`operator.css:163-178`): `.field input[type=text]`, `.search` and `.field textarea`.
// Each one tells `OperatorState` while it has the keyboard, so the window's keys leave typing alone (Task 10).
import { Theme, OperatorState } from "../theme.slint";

/// One line of text on the page background, with a 1.5 px border that turns accent while focused. `search` gives
/// the `.search` look (radius 10, padding 10×12) instead of `.field input` (radius 9, padding 9×11).
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <length> font-size: Theme.base-size;
    in property <bool> search;
    out property <bool> has-focus: input.has-focus;
    /// The text changed by typing (not by Rust setting it).
    callback edited(string);
    /// Enter.
    callback accepted();
    forward-focus: input;

    background: Theme.bg;
    border-width: 1.5px;
    border-color: input.has-focus ? Theme.accent : Theme.line;
    border-radius: root.search ? 10px : 9px;
    accessible-role: text-input;
    accessible-placeholder-text: root.placeholder;
    accessible-value: root.text;

    HorizontalLayout {
        padding-top: root.search ? 10px : 9px;
        padding-bottom: self.padding-top;
        padding-left: root.search ? 12px : 11px;
        padding-right: self.padding-left;
        Rectangle {
            min-height: input.preferred-height;
            if input.text == "": Text {
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                color: Theme.faint;
                font-family: Theme.font;
                font-size: root.font-size;
                overflow: elide;
                vertical-alignment: center;
            }
            input := TextInput {
                width: parent.width;
                height: parent.height;
                text <=> root.text;
                single-line: true;
                color: Theme.text;
                selection-background-color: Theme.accent;
                selection-foreground-color: Theme.accent-ink;
                font-family: Theme.font;
                font-size: root.font-size;
                vertical-alignment: center;
                changed has-focus => { OperatorState.focus-in-text = self.has-focus; }
                edited => { root.edited(self.text); }
                accepted => { root.accepted(); }
            }
        }
    }
}

/// `.field textarea`: several lines that wrap, at least `min-height` tall, scrolled to keep the cursor in view.
export component TextArea inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <length> font-size: Theme.base-size;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    forward-focus: input;

    min-height: 120px;
    background: Theme.bg;
    border-width: 1.5px;
    border-color: input.has-focus ? Theme.accent : Theme.line;
    border-radius: 9px;
    accessible-role: text-input;
    accessible-placeholder-text: root.placeholder;
    accessible-value: root.text;

    fl := Flickable {
        x: 11px;
        y: 9px;
        width: root.width - 22px;
        height: root.height - 18px;
        mouse-drag-pan-enabled: false;
        content-width: self.width;
        content-height: max(self.height, input.preferred-height);
        if input.text == "": Text {
            width: fl.width;
            text: root.placeholder;
            color: Theme.faint;
            font-family: Theme.font;
            font-size: root.font-size;
            wrap: word-wrap;
        }
        input := TextInput {
            width: fl.width;
            height: max(fl.height, self.preferred-height);
            text <=> root.text;
            single-line: false;
            wrap: word-wrap;
            color: Theme.text;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.accent-ink;
            font-family: Theme.font;
            font-size: root.font-size;
            changed has-focus => { OperatorState.focus-in-text = self.has-focus; }
            edited => { root.edited(self.text); }
            cursor-position-changed(p) => {
                if p.y + fl.content-y < 0 {
                    fl.content-y = -p.y;
                } else if p.y + fl.content-y + root.font-size * 1.5 > fl.height {
                    fl.content-y = min(0px, fl.height - p.y - root.font-size * 1.5);
                }
            }
        }
    }
}
