// Item edit (`openItemEdit`, `operator.js:720-796`): the sections for the item's kind, the stage notes, and
// Remove / Cancel / Save. Rust (`src/ui/dialogs/item_edit.rs`) fills `ItemEdit` when the dialog opens and reads it on
// Save; nothing here is redrawn by a data update, so what the user typed stays.
import { Theme } from "../theme.slint";
import { Btn, Chip, Segmented, Field } from "../widgets.slint";
import { DialogBody, DialogFoot } from "shell.slint";
import { TextField, TextArea, Check, Note, RangeSlider, Select } from "form.slint";
import { BackgroundPicker, BgChoice } from "background-picker.slint";
import { BiblePickButton, TranslationChip } from "../bible-picker.slint";
import { ArrangementStrip, ArrChipRow, ArrAddRow } from "arrangement.slint";

export { BgChoice }

/// What the open Item edit shows and what the user changed.
export global ItemEdit {
    /// The row's kind: song, scripture, text, video, image, audio or deck.
    in property <string> kind;
    /// Song: the library still has the song.
    in property <bool> song-exists;
    /// Scripture: the passage's Bible as its chip says it, and that Bible's picker (spec §7.2). A new Bible looks the
    /// verses up again on Save.
    in property <string> translation;
    in property <bool> translation-changed;
    in property <[TranslationChip]> picker-rows;
    in-out property <string> picker-search;
    in property <string> picker-note;
    /// Scripture: 0 = Automatic, else verses per slide.
    in-out property <int> per-slide;
    /// Scripture text size: 0 = Automatic (Settings → Look), 1 = this passage's own `text-size`.
    in-out property <int> size-mode;
    in-out property <int> text-size: 64;
    /// Announcement.
    in-out property <string> title;
    in-out property <string> body;
    /// Video: 0 = Clear the screen, 1 = Stay on last frame, 2 = Play again (loop).
    in-out property <bool> autoplay;
    in-out property <int> end-index;
    /// Audio.
    in-out property <bool> looped;
    /// Media ("Name in library") and slides ("Name"): the name field is there.
    in property <bool> has-name;
    in-out property <string> name;
    /// Media that is not ready: its status chip and reason.
    in property <bool> not-ready;
    in property <string> status-text;
    in property <string> status-state;
    in property <string> status-reason;
    /// Song, scripture and announcement items have a background.
    in property <bool> has-background;
    in property <[BgChoice]> choices;
    /// Song, scripture and announcement items have a theme (FEAT-1 §3.3): "Same as service (…)", then each theme.
    in property <[string]> theme-options;
    in-out property <int> theme-index;
    in property <[color]> palette;
    in-out property <string> notes;

    /// Song: this service's order (FEAT-4 §3.5). Ticked: the song's usual order, shown dimmed; unticked: the strip
    /// is this service's own order.
    in-out property <bool> usual-order: true;
    in property <[ArrChipRow]> order-rows;
    in property <int> order-count;
    in property <bool> order-written;
    in property <[ArrAddRow]> order-adds;
    in-out property <int> order-selected: -1;
    callback usual-order-toggled(bool);
    callback order-move(int, int);
    callback order-remove(int);
    callback order-add(string);
    callback order-reset();
    pure callback order-drag-data(int) -> data-transfer;
    pure callback order-drag-index(data-transfer) -> int;
    /// Saves the strip as the song's usual order and drops this service's own.
    callback make-usual();

    callback edit-song();
    callback save();
    callback remove();
    callback pick-background(int);
    callback custom-color(color);
    callback custom-hex(string);
    callback upload();
    callback picker-opening();
    callback picker-search-changed(string);
    callback picker-accept();
    callback pick-bible(string);
    callback toggle-favourite(string);
    callback find-more-bibles(string);
    /// Scripture: the Bibles shown with the main one in this passage only (Nov 5 spec §3), at most two, as their
    /// chips say them. Both "Also show" pickers share one list; `also-opening` says which one is opening.
    in property <[string]> also-labels;
    /// 0 side by side, 1 top and bottom.
    in-out property <int> also-layout;
    in property <[TranslationChip]> also-rows;
    in-out property <string> also-search;
    in property <string> also-note;
    callback also-opening(int);
    callback also-search-changed(string);
    callback also-accept();
    callback also-pick(string);
    /// The X beside an Also Bible: the one after it moves up.
    callback also-remove(int);
}

/// The text of a `Note` that has something beside it (a button or a status chip).
component NoteText inherits Text {
    color: Theme.muted;
    font-family: Theme.font;
    font-size: Theme.base-size;
    wrap: word-wrap;
    vertical-alignment: center;
}

/// The dialog's body and footer, inside `DialogShell`.
export component ItemEditDialog inherits VerticalLayout {
    callback close();

    DialogBody {
        if ItemEdit.kind == "song": VerticalLayout {
            padding-bottom: 12px;
            Note {
                HorizontalLayout {
                    spacing: 8px;
                    NoteText {
                        horizontal-stretch: 1;
                        text: ItemEdit.song-exists
                            ? @tr("Lyrics, order and credits belong to the song in your library.")
                            : @tr("Lyrics, order and credits belong to the song in your library. This song was deleted from the library.");
                    }
                    if ItemEdit.song-exists: VerticalLayout {
                        alignment: center;
                        edit-song := Btn {
                            small: true;
                            icon: "edit";
                            text: @tr("Edit song");
                            clicked => { ItemEdit.edit-song(); }
                        }
                    }
                }
            }
        }
        if ItemEdit.kind == "song" && ItemEdit.song-exists: Field {
            label: @tr("Order for this service");
            usual-order := Check {
                text: @tr("Use the song's usual order");
                checked <=> ItemEdit.usual-order;
                toggled(on) => { ItemEdit.usual-order-toggled(on); }
            }
            order-strip := ArrangementStrip {
                active: !ItemEdit.usual-order;
                rows: ItemEdit.order-rows;
                count: ItemEdit.order-count;
                written: ItemEdit.order-written;
                adds: ItemEdit.order-adds;
                selected <=> ItemEdit.order-selected;
                move(from, to) => { ItemEdit.order-move(from, to); }
                remove(i) => { ItemEdit.order-remove(i); }
                add(label) => { ItemEdit.order-add(label); }
                reset => { ItemEdit.order-reset(); }
                drag-data(i) => { return ItemEdit.order-drag-data(i); }
                drag-index(d) => { return ItemEdit.order-drag-index(d); }
            }
            if !ItemEdit.usual-order: HorizontalLayout {
                alignment: start;
                make-usual := Btn {
                    small: true;
                    text: @tr("Make this the song's usual order");
                    clicked => { ItemEdit.make-usual(); }
                }
            }
        }
        if ItemEdit.kind == "scripture": Field {
            label: @tr("Bible");
            HorizontalLayout {
                spacing: 14px;
                bible-pick := BiblePickButton {
                    height: 32px;
                    label: ItemEdit.translation;
                    rows: ItemEdit.picker-rows;
                    search <=> ItemEdit.picker-search;
                    note: ItemEdit.picker-note;
                    opening => { ItemEdit.picker-opening(); }
                    search-changed(text) => { ItemEdit.picker-search-changed(text); }
                    accept => { ItemEdit.picker-accept(); }
                    pick(id) => { ItemEdit.pick-bible(id); }
                    toggle-favourite(id) => { ItemEdit.toggle-favourite(id); }
                    find-more(q) => { ItemEdit.find-more-bibles(q); }
                }
                Text {
                    horizontal-stretch: 1;
                    text: ItemEdit.translation-changed ? @tr("The verses are looked up again in this Bible when you save.") : "";
                    color: Theme.muted;
                    font-family: Theme.font;
                    font-size: Theme.base-size;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
        if ItemEdit.kind == "scripture": Field {
            label: @tr("Also show");
            VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    also-0 := BiblePickButton {
                        height: 32px;
                        label: ItemEdit.also-labels.length > 0 ? ItemEdit.also-labels[0] : @tr("none");
                        rows: ItemEdit.also-rows;
                        search <=> ItemEdit.also-search;
                        note: ItemEdit.also-note;
                        opening => { ItemEdit.also-opening(0); }
                        search-changed(text) => { ItemEdit.also-search-changed(text); }
                        accept => { ItemEdit.also-accept(); }
                        pick(id) => { ItemEdit.also-pick(id); }
                        toggle-favourite(id) => { ItemEdit.toggle-favourite(id); }
                        find-more(q) => { ItemEdit.find-more-bibles(q); }
                    }
                    if ItemEdit.also-labels.length > 0: also-x-0 := Btn {
                        small: true;
                        icon: "close";
                        tooltip: @tr("Stop showing this Bible");
                        clicked => { ItemEdit.also-remove(0); }
                    }
                    if ItemEdit.also-labels.length > 0: also-1 := BiblePickButton {
                        height: 32px;
                        label: ItemEdit.also-labels.length > 1 ? ItemEdit.also-labels[1] : @tr("none");
                        rows: ItemEdit.also-rows;
                        search <=> ItemEdit.also-search;
                        note: ItemEdit.also-note;
                        opening => { ItemEdit.also-opening(1); }
                        search-changed(text) => { ItemEdit.also-search-changed(text); }
                        accept => { ItemEdit.also-accept(); }
                        pick(id) => { ItemEdit.also-pick(id); }
                        toggle-favourite(id) => { ItemEdit.toggle-favourite(id); }
                        find-more(q) => { ItemEdit.find-more-bibles(q); }
                    }
                    if ItemEdit.also-labels.length > 1: also-x-1 := Btn {
                        small: true;
                        icon: "close";
                        tooltip: @tr("Stop showing this Bible");
                        clicked => { ItemEdit.also-remove(1); }
                    }
                }
                if ItemEdit.also-labels.length > 0: HorizontalLayout {
                    alignment: start;
                    also-layout := Segmented {
                        labels: [@tr("Side by side"), @tr("Top and bottom")];
                        index <=> ItemEdit.also-layout;
                    }
                }
            }
        }
        if ItemEdit.kind == "scripture": Field {
            label: @tr("Verses per slide");
            HorizontalLayout {
                alignment: start;
                per-slide := Segmented {
                    labels: [@tr("Automatic"), @tr("1 verse"), @tr("2 verses"), @tr("3 verses"), @tr("4 verses")];
                    index <=> ItemEdit.per-slide;
                }
            }
        }
        if ItemEdit.kind == "scripture": Field {
            label: @tr("Text size");
            help: @tr("(biggest; text shrinks automatically when a slide holds more words)");
            HorizontalLayout {
                spacing: 14px;
                size-mode := Segmented {
                    labels: [@tr("Automatic"), @tr("Choose")];
                    index <=> ItemEdit.size-mode;
                }
                if ItemEdit.size-mode == 0: Text {
                    text: @tr("Same as Settings → Look");
                    color: Theme.muted;
                    font-family: Theme.font;
                    font-size: Theme.base-size;
                    vertical-alignment: center;
                }
                if ItemEdit.size-mode == 1: VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    text-size := RangeSlider {
                        minimum: 36;
                        maximum: 120;
                        value <=> ItemEdit.text-size;
                    }
                }
            }
        }
        if ItemEdit.kind == "text": Field {
            label: @tr("Title");
            title-box := TextField {
                label: @tr("Title");
                text <=> ItemEdit.title;
            }
        }
        if ItemEdit.kind == "text": Field {
            label: @tr("Text");
            help: @tr("— an empty line starts a new slide");
            body-box := TextArea {
                label: @tr("Text");
                text <=> ItemEdit.body;
            }
        }
        if ItemEdit.kind == "video": autoplay := Check {
            text: @tr("Start playing as soon as it is shown");
            checked <=> ItemEdit.autoplay;
        }
        if ItemEdit.kind == "video": Field {
            label: @tr("When the video ends");
            HorizontalLayout {
                alignment: start;
                end := Segmented {
                    labels: [@tr("Clear the screen"), @tr("Stay on last frame"), @tr("Play again (loop)")];
                    index <=> ItemEdit.end-index;
                }
            }
        }
        if ItemEdit.kind == "audio": looped := Check {
            text: @tr("Repeat until stopped");
            checked <=> ItemEdit.looped;
        }
        if ItemEdit.kind == "audio": VerticalLayout {
            padding-bottom: 12px;
            Note {
                text: @tr("Audio keeps playing while you change slides. Stop it with Clear Audio (F4) or Clear All.");
            }
        }
        if ItemEdit.has-name: Field {
            label: ItemEdit.kind == "deck" ? @tr("Name") : @tr("Name in library");
            name-box := TextField {
                label: ItemEdit.kind == "deck" ? @tr("Name") : @tr("Name in library");
                text <=> ItemEdit.name;
            }
        }
        if ItemEdit.not-ready: VerticalLayout {
            padding-bottom: 12px;
            Note {
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Chip {
                            text: ItemEdit.status-text;
                            state: ItemEdit.status-state;
                            tooltip: ItemEdit.status-reason;
                        }
                    }
                    NoteText {
                        horizontal-stretch: 1;
                        text: ItemEdit.status-reason;
                    }
                }
            }
        }
        if ItemEdit.has-background && ItemEdit.theme-options.length > 0: Field {
            label: @tr("Theme");
            item-theme := Select {
                options: ItemEdit.theme-options;
                index <=> ItemEdit.theme-index;
            }
        }
        if ItemEdit.has-background: Field {
            label: @tr("Background");
            picker := BackgroundPicker {
                choices: ItemEdit.choices;
                palette: ItemEdit.palette;
                pick(i) => { ItemEdit.pick-background(i); }
                custom-color(c) => { ItemEdit.custom-color(c); }
                custom-hex(t) => { ItemEdit.custom-hex(t); }
                upload => { ItemEdit.upload(); }
            }
        }
        Field {
            label: @tr("Stage notes");
            notes-box := TextArea {
                label: @tr("Stage notes");
                min-height: 64px;
                placeholder: @tr("Shown on the stage display only");
                text <=> ItemEdit.notes;
            }
        }
    }
    DialogFoot {
        remove := Btn {
            danger: true;
            icon: "trash";
            text: @tr("Remove from service");
            clicked => { ItemEdit.remove(); }
        }
        // `margin-right: auto` on the danger button.
        Rectangle { horizontal-stretch: 1; }
        cancel := Btn {
            text: @tr("Cancel");
            clicked => { root.close(); }
        }
        save := Btn {
            primary: true;
            text: @tr("Save");
            clicked => { ItemEdit.save(); }
        }
    }
}
