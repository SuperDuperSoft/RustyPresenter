// Settings → Media (N21, N24): what new pictures and videos do, where the sound goes, and cleaning up the library.
// Read and written by `src/ui/dialogs/settings_media.rs`.
import { Theme } from "../theme.slint";
import { Btn, Field, Segmented } from "../widgets.slint";
import { TextField, Note, Select, Check, RangeSlider } from "form.slint";
import { SettingsDlg } from "settings-state.slint";
import { StreamSoundSetup, StreamSoundMore } from "settings-sound.slint";
import { StreamExtrasRows } from "settings-stream-extras.slint";

/// A group's title (also on Settings → Video).
export component Heading inherits Text {
    color: Theme.text;
    font-family: Theme.font;
    font-size: 15px;
    font-weight: 700;
    accessible-role: text;
    accessible-label: self.text;
}

export component SettingsMedia inherits VerticalLayout {
    spacing: 4px;
    Heading { text: @tr("New pictures and videos"); }
    Rectangle { height: 6px; }
    Field {
        label: @tr("When the shape doesn't match the screen");
        HorizontalLayout {
            alignment: start;
            scale := Segmented {
                labels: [@tr("Fit (black bars)"), @tr("Fill (cut the edges)"), @tr("Stretch")];
                index <=> SettingsDlg.media-scale;
            }
        }
    }
    Field {
        label: @tr("When a video ends");
        help: @tr("For videos added from now on. Change one video in its Edit window.");
        HorizontalLayout {
            alignment: start;
            video-end := Segmented {
                labels: [@tr("Clear the screen"), @tr("Stay on last frame"), @tr("Play again (loop)"), @tr("Go to the next slide")];
                index <=> SettingsDlg.video-end;
            }
        }
    }
    Field {
        label: @tr("Pictures added together as slides");
        help: @tr("Each picture stays this long, then the next one comes up.");
        picture-secs := Select {
            options: [@tr("Until Next is pressed"), @tr("5 seconds"), @tr("8 seconds"), @tr("10 seconds"), @tr("15 seconds"), @tr("20 seconds"), @tr("30 seconds"), @tr("1 minute")];
            index <=> SettingsDlg.picture-secs;
        }
    }
    Rectangle { height: 14px; }
    Heading { text: @tr("Sound"); }
    Rectangle { height: 6px; }
    Field {
        label: @tr("Headphones (Listen)");
        help: @tr("View → Listen in headphones sends the sound here only, so you can check a video without the room hearing it.");
        listen := Select {
            options: SettingsDlg.listen-labels;
            index <=> SettingsDlg.listen-index;
        }
    }
    Field {
        label: @tr("Delay the room's sound (milliseconds)");
        help: @tr("If the sound comes before the picture on the projector, try 50 to 150. 0 is no delay.");
        HorizontalLayout {
            alignment: start;
            delay := TextField {
                width: 120px;
                height: 38px;
                text <=> SettingsDlg.delay-ms;
                label: @tr("Delay the room's sound (milliseconds)");
            }
        }
    }
    Field {
        label: @tr("Speakers");
        channels := Select {
            options: [@tr("Stereo (as recorded)"), @tr("Mono (both speakers the same)"), @tr("Swap left and right"), @tr("Left speaker only"), @tr("Right speaker only")];
            index <=> SettingsDlg.channels;
        }
    }
    Rectangle { height: 14px; }
    Heading { text: @tr("Recording"); }
    Rectangle { height: 6px; }
    Note {
        text: @tr("File → Start recording (or the Record button at the top) saves what the audience screen shows as an MP4 video.");
    }
    Field {
        label: @tr("Picture size");
        help: @tr("720p uses less of the computer and the disk (about 1.4 GB an hour at most); 1080p is sharper (about 2.8 GB).");
        HorizontalLayout {
            alignment: start;
            record-size := Segmented {
                labels: [@tr("720p"), @tr("1080p")];
                index <=> SettingsDlg.record-size;
            }
        }
    }
    Field {
        label: @tr("Video encoder");
        help: @tr("Automatic suits most computers. A graphics card's encoder leaves the processor free; it is tried first, and Automatic is used if it does not work on this computer.");
        record-encoder := Select {
            options: [@tr("Automatic"), @tr("The processor (x264)"), @tr("NVIDIA graphics card"), @tr("Intel graphics"), @tr("AMD graphics card"), @tr("Windows' own"), @tr("OpenH264"), @tr("The Mac's own")];
            index <=> SettingsDlg.record-encoder;
        }
    }
    Field {
        label: @tr("Bitrate");
        help: @tr("How much picture goes out each second. Automatic: 3000 kbit/s for 720p, 6000 for 1080p. More is sharper and needs a faster upload.");
        record-bitrate := Select {
            options: [@tr("Automatic"), "2500 kbit/s", "4500 kbit/s", "6000 kbit/s", "8000 kbit/s", "12000 kbit/s"];
            index <=> SettingsDlg.record-bitrate;
        }
    }
    Field {
        label: @tr("Save recordings in");
        HorizontalLayout {
            spacing: 8px;
            record-folder := Text {
                text: SettingsDlg.record-folder;
                color: Theme.text;
                font-family: Theme.font;
                font-size: Theme.base-size;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                accessible-role: text;
                accessible-label: self.text;
            }
            record-choose := Btn {
                small: true;
                text: @tr("Choose folder…");
                clicked => { SettingsDlg.record-choose-folder(); }
            }
        }
    }
    Field {
        label: @tr("Sound in the recording");
        help: @tr("The app's sound is taken from the video and song files when the recording stops, so nothing else on the computer is heard.");
        record-sound := Select {
            options: SettingsDlg.record-sound-labels;
            index <=> SettingsDlg.record-sound-index;
        }
    }
    Rectangle { height: 14px; }
    Heading { text: @tr("Livestream"); }
    Rectangle { height: 6px; }
    Note {
        text: @tr("Switch a destination on and a Go Live button appears beside Record. Go Live records as usual and sends the same picture and sound to every destination that is on.");
    }
    Field {
        label: @tr("Sound from this computer");
        help: @tr("Everything that plays on this output goes out with the stream (videos, songs, and any other sound sent there), mixed with the microphone or line-in chosen above.")
            + (SettingsDlg.stream-sound-note != "" ? " " + SettingsDlg.stream-sound-note : "");
        stream-sound := Select {
            options: SettingsDlg.stream-sound-labels;
            index <=> SettingsDlg.stream-sound-index;
        }
    }
    // The sound setup, the other inputs, the phone and Listen (settings-sound.slint).
    StreamSoundSetup {}
    Field {
        label: @tr("Upload speed");
        help: @tr("Sends a few megabytes of zeros to a public speed test and says whether the internet can carry the stream to every destination that is on. It picks the recording size that fits.");
        HorizontalLayout {
            spacing: 10px;
            stream-speed := Btn {
                small: true;
                text: SettingsDlg.stream-speed-testing ? @tr("Testing…") : @tr("Test the upload speed");
                clicked => { if !SettingsDlg.stream-speed-testing { SettingsDlg.stream-speed-test(); } }
            }
            Text {
                text: SettingsDlg.stream-speed-text;
                color: Theme.text;
                font-family: Theme.font;
                font-size: Theme.base-size;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
                accessible-role: text;
                accessible-label: self.text;
            }
        }
    }
    Field {
        label: @tr("Sound delay");
        help: @tr("If the sound in the stream comes before people's lips move, the camera's picture is late: hold the sound back until they match.");
        HorizontalLayout {
            spacing: 10px;
            stream-delay := RangeSlider {
                minimum: 0;
                maximum: 1000;
                value <=> SettingsDlg.stream-sound-delay;
                horizontal-stretch: 1;
            }
            Text {
                text: @tr("{} ms", SettingsDlg.stream-sound-delay);
                color: Theme.text;
                font-family: Theme.font;
                font-size: Theme.base-size;
                vertical-alignment: center;
                min-width: 64px;
            }
        }
    }
    Field {
        label: @tr("Stream delay");
        help: @tr("What goes out to the stream is held back this long, so Hold or Mute can stop something before anyone watching sees it. The recording is not held back. Viewers' comments come in later than what they answer.");
        stream-hold-back := Select {
            options: [@tr("None"), @tr("10 seconds"), @tr("30 seconds"), @tr("1 minute")];
            index <=> SettingsDlg.stream-delay;
        }
    }
    Field {
        label: @tr("Slow internet");
        help: @tr("When a destination's internet cannot keep up, it gets a lighter stream until it can, instead of skipping. The recording and the other destinations keep the full picture. This uses more of the computer.");
        stream-lighter := Check { text: @tr("Send a lighter stream where the internet is slow"); checked <=> SettingsDlg.stream-lighter; }
    }
    Field {
        label: @tr("NDI");
        help: SettingsDlg.ndi-ready
            ? @tr("Other computers and programs on this network (OBS, vMix, a video switcher) can take these while you are live. NDI cameras are listed with the cameras above.")
            : @tr("NDI needs the free NDI Tools from ndi.video on this computer. Install them, then open Settings again.");
        VerticalLayout {
            spacing: 6px;
            stream-ndi := Check { text: @tr("Send the stream over NDI too (picture and sound)"); checked <=> SettingsDlg.stream-ndi; }
            stream-ndi-words := Check { text: @tr("Send the words alone over NDI, on a see-through background (for keying)"); checked <=> SettingsDlg.stream-ndi-words; }
        }
    }
    Field {
        label: @tr("Words alone");
        help: @tr("While you are live, a second video is saved next to the recording, its name ending in words.mov: only the words, with nothing behind them. When you edit the service video, put it on top to add the words. It stays small because the words seldom change.");
        stream-words-file := Check { text: @tr("Also record the words alone, on a see-through background (for video editing)"); checked <=> SettingsDlg.stream-words-file; }
    }
    Field {
        label: @tr("Sound levels");
        help: @tr("Turn each sound up or down in the stream only (not in the room).");
        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: @tr("Microphone or line-in");
                    color: Theme.text;
                    font-family: Theme.font;
                    font-size: Theme.base-size;
                    vertical-alignment: center;
                    min-width: 150px;
                }
                stream-board-level := RangeSlider {
                    minimum: -20;
                    maximum: 20;
                    value <=> SettingsDlg.stream-board-level;
                    horizontal-stretch: 1;
                }
                Text {
                    text: @tr("{} dB", SettingsDlg.stream-board-level);
                    color: Theme.text;
                    font-family: Theme.font;
                    font-size: Theme.base-size;
                    vertical-alignment: center;
                    min-width: 64px;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: @tr("This computer");
                    color: Theme.text;
                    font-family: Theme.font;
                    font-size: Theme.base-size;
                    vertical-alignment: center;
                    min-width: 150px;
                }
                stream-pc-level := RangeSlider {
                    minimum: -20;
                    maximum: 20;
                    value <=> SettingsDlg.stream-pc-level;
                    horizontal-stretch: 1;
                }
                Text {
                    text: @tr("{} dB", SettingsDlg.stream-pc-level);
                    color: Theme.text;
                    font-family: Theme.font;
                    font-size: Theme.base-size;
                    vertical-alignment: center;
                    min-width: 64px;
                }
            }
        }
    }
    Field {
        label: @tr("Sound clean-up");
        help: @tr("For the stream only. Evening out keeps quiet speaking easy to hear at home and loud singing from crackling.");
        VerticalLayout {
            spacing: 6px;
            stream-even := Check { text: @tr("Even out loud and quiet moments"); checked <=> SettingsDlg.stream-even; }
            stream-quiet-noise := Check { text: @tr("Take out hum and hiss from the microphone or line-in (can dull music)"); checked <=> SettingsDlg.stream-quiet-noise; }
            stream-tracks := Check { text: @tr("Also keep each sound on a track of its own in the recording, to balance them again afterwards"); checked <=> SettingsDlg.stream-tracks; }
        }
    }
    StreamSoundMore {}
    Field {
        label: @tr("Camera");
        help: @tr("A camera or capture card for the stream's camera scenes (and its recording).");
        VerticalLayout {
            spacing: 6px;
            stream-camera := Select {
                options: SettingsDlg.stream-camera-labels;
                index <=> SettingsDlg.stream-camera-index;
            }
            if SettingsDlg.stream-camera-index > 0: stream-camera-control := TextField {
                label: @tr("Camera control address");
                placeholder: @tr("To move a PTZ camera to its saved positions: its address, like 192.168.1.60");
                text <=> SettingsDlg.stream-camera-control;
            }
            if SettingsDlg.stream-camera-index > 0 && SettingsDlg.stream-camera-index == SettingsDlg.stream-camera-labels.length - 1: stream-camera-address := TextField {
                label: @tr("Network camera address");
                text <=> SettingsDlg.stream-camera-address;
                placeholder: @tr("The camera's address, like rtsp://192.168.1.50:554/stream1");
            }
        }
    }
    if SettingsDlg.stream-camera-index > 0: Field {
        label: @tr("Second camera");
        help: @tr("Another camera to switch to while live, from the Cameras box beside the live screen.");
        VerticalLayout {
            spacing: 6px;
            stream-camera2 := Select {
                options: SettingsDlg.stream-camera2-labels;
                index <=> SettingsDlg.stream-camera2-index;
            }
            if SettingsDlg.stream-camera2-index > 0: stream-camera2-control := TextField {
                label: @tr("Camera control address");
                placeholder: @tr("To move a PTZ camera to its saved positions: its address, like 192.168.1.60");
                text <=> SettingsDlg.stream-camera2-control;
            }
            if SettingsDlg.stream-camera2-index > 0 && SettingsDlg.stream-camera2-index == SettingsDlg.stream-camera2-labels.length - 1: stream-camera2-address := TextField {
                label: @tr("Network camera address");
                text <=> SettingsDlg.stream-camera2-address;
                placeholder: @tr("The camera's address, like rtsp://192.168.1.50:554/stream1");
            }
        }
    }
    if SettingsDlg.stream-camera2-index > 0: Field {
        label: @tr("Third camera");
        help: @tr("Another camera to switch to while live.");
        VerticalLayout {
            spacing: 6px;
            stream-camera3 := Select {
                options: SettingsDlg.stream-camera3-labels;
                index <=> SettingsDlg.stream-camera3-index;
            }
            if SettingsDlg.stream-camera3-index > 0: stream-camera3-control := TextField {
                label: @tr("Camera control address");
                placeholder: @tr("To move a PTZ camera to its saved positions: its address, like 192.168.1.60");
                text <=> SettingsDlg.stream-camera3-control;
            }
            if SettingsDlg.stream-camera3-index > 0 && SettingsDlg.stream-camera3-index == SettingsDlg.stream-camera3-labels.length - 1: stream-camera3-address := TextField {
                label: @tr("Network camera address");
                text <=> SettingsDlg.stream-camera3-address;
                placeholder: @tr("The camera's address, like rtsp://192.168.1.50:554/stream1");
            }
        }
    }
    if SettingsDlg.stream-camera3-index > 0: Field {
        label: @tr("Fourth camera");
        help: @tr("Another camera to switch to while live.");
        VerticalLayout {
            spacing: 6px;
            stream-camera4 := Select {
                options: SettingsDlg.stream-camera4-labels;
                index <=> SettingsDlg.stream-camera4-index;
            }
            if SettingsDlg.stream-camera4-index > 0: stream-camera4-control := TextField {
                label: @tr("Camera control address");
                placeholder: @tr("To move a PTZ camera to its saved positions: its address, like 192.168.1.60");
                text <=> SettingsDlg.stream-camera4-control;
            }
            if SettingsDlg.stream-camera4-index > 0 && SettingsDlg.stream-camera4-index == SettingsDlg.stream-camera4-labels.length - 1: stream-camera4-address := TextField {
                label: @tr("Network camera address");
                text <=> SettingsDlg.stream-camera4-address;
                placeholder: @tr("The camera's address, like rtsp://192.168.1.50:554/stream1");
            }
        }
    }
    if SettingsDlg.stream-camera-index > 0: Field {
        label: @tr("When a camera sends nothing");
        help: @tr("What the stream shows in a camera's place while it is unplugged or sends no picture. The camera comes back by itself as soon as it sends again.");
        HorizontalLayout {
            alignment: start;
            stream-camera-lost := Segmented {
                labels: [@tr("The audience screen"), @tr("The church logo"), @tr("Black")];
                index <=> SettingsDlg.stream-camera-lost;
            }
        }
    }
    Field {
        label: @tr("Phone as a camera");
        phone-camera-help := Text {
            text: SettingsDlg.phone-camera-help;
            color: Theme.text;
            font-family: Theme.font;
            font-size: Theme.base-size;
            wrap: word-wrap;
        }
    }
    Field {
        label: @tr("Scenes");
        help: @tr("Songs and Bible verses go out as the camera with the words; videos and presentations as the audience screen; nothing on the screen as the camera. A scene chosen with the scene button beside Live holds until the next service item.");
        VerticalLayout {
            spacing: 6px;
            stream-auto := Check { text: @tr("Choose the scene by itself from what is live"); checked <=> SettingsDlg.stream-auto-scenes; }
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Text {
                    text: @tr("Presentations:");
                    color: Theme.text;
                    font-family: Theme.font;
                    font-size: Theme.base-size;
                    vertical-alignment: center;
                }
                stream-presentations := Segmented {
                    labels: [@tr("The audience screen"), @tr("The audience screen with the camera in a corner")];
                    index <=> SettingsDlg.stream-presentation-camera;
                }
            }
        }
    }
    Field {
        label: @tr("Scene layout");
        help: @tr("Where the camera goes when it is in a corner of the audience screen, and where the words go over the camera.");
        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                stream-corner := Segmented {
                    labels: [@tr("Top left"), @tr("Top right"), @tr("Bottom left"), @tr("Bottom right")];
                    index <=> SettingsDlg.stream-corner;
                }
                stream-corner-size := Segmented {
                    labels: [@tr("Small"), @tr("Medium"), @tr("Large")];
                    index <=> SettingsDlg.stream-corner-size;
                }
            }
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Text {
                    text: @tr("Words over the camera:");
                    color: Theme.text;
                    font-family: Theme.font;
                    font-size: Theme.base-size;
                    vertical-alignment: center;
                }
                stream-words-top := Segmented {
                    labels: [@tr("At the bottom"), @tr("At the top")];
                    index <=> SettingsDlg.stream-words-top;
                }
            }
        }
    }
    Field {
        label: @tr("Your scenes");
        help: @tr("Make scenes of your own from cameras, the audience screen, the words, pictures, colours and text. They are listed after the built-in scenes while live.");
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            own-scenes-btn := Btn {
                text: @tr("Your scenes…");
                clicked => { SettingsDlg.edit-own-scenes(); }
            }
            Text {
                text: SettingsDlg.stream-own-count == 0 ? @tr("None yet") : SettingsDlg.stream-own-count == 1 ? @tr("1 scene") : @tr("{} scenes", SettingsDlg.stream-own-count);
                color: Theme.muted;
                font-family: Theme.font;
                font-size: Theme.base-size;
                vertical-alignment: center;
            }
        }
    }
    Field {
        label: @tr("Starting soon");
        help: @tr("Before the service, with the pre-service countdown under the words while it runs.");
        HorizontalLayout {
            spacing: 8px;
            stream-card-words-0 := TextField {
                horizontal-stretch: 1;
                label: @tr("Starting soon");
                placeholder: @tr("Starting soon");
                text <=> SettingsDlg.stream-card-words-0;
            }
            if SettingsDlg.stream-card-picture-0 != "": Text {
                text: SettingsDlg.stream-card-picture-0;
                color: Theme.muted;
                font-family: Theme.font;
                font-size: Theme.base-size;
                vertical-alignment: center;
                overflow: elide;
                max-width: 220px;
            }
            stream-card-pick-0 := Btn {
                small: true;
                text: SettingsDlg.stream-card-picture-0 == "" ? @tr("Use a picture…") : @tr("Use words");
                clicked => { if SettingsDlg.stream-card-picture-0 == "" { SettingsDlg.stream-card-choose(0); } else { SettingsDlg.stream-card-picture-0 = ""; } }
            }
        }
    }
    Field {
        label: @tr("Ending");
        help: @tr("After the service's last item.");
        HorizontalLayout {
            spacing: 8px;
            stream-card-words-1 := TextField {
                horizontal-stretch: 1;
                label: @tr("Ending");
                placeholder: @tr("Thanks for joining us");
                text <=> SettingsDlg.stream-card-words-1;
            }
            if SettingsDlg.stream-card-picture-1 != "": Text {
                text: SettingsDlg.stream-card-picture-1;
                color: Theme.muted;
                font-family: Theme.font;
                font-size: Theme.base-size;
                vertical-alignment: center;
                overflow: elide;
                max-width: 220px;
            }
            stream-card-pick-1 := Btn {
                small: true;
                text: SettingsDlg.stream-card-picture-1 == "" ? @tr("Use a picture…") : @tr("Use words");
                clicked => { if SettingsDlg.stream-card-picture-1 == "" { SettingsDlg.stream-card-choose(1); } else { SettingsDlg.stream-card-picture-1 = ""; } }
            }
        }
    }
    Field {
        label: @tr("Hold");
        help: @tr("For a break, chosen with the scene button.");
        HorizontalLayout {
            spacing: 8px;
            stream-card-words-2 := TextField {
                horizontal-stretch: 1;
                label: @tr("Hold");
                placeholder: @tr("We'll be right back");
                text <=> SettingsDlg.stream-card-words-2;
            }
            if SettingsDlg.stream-card-picture-2 != "": Text {
                text: SettingsDlg.stream-card-picture-2;
                color: Theme.muted;
                font-family: Theme.font;
                font-size: Theme.base-size;
                vertical-alignment: center;
                overflow: elide;
                max-width: 220px;
            }
            stream-card-pick-2 := Btn {
                small: true;
                text: SettingsDlg.stream-card-picture-2 == "" ? @tr("Use a picture…") : @tr("Use words");
                clicked => { if SettingsDlg.stream-card-picture-2 == "" { SettingsDlg.stream-card-choose(2); } else { SettingsDlg.stream-card-picture-2 = ""; } }
            }
        }
    }
    Field {
        label: @tr("Stream to");
        help: @tr("A stream key is a password: whoever has it can stream as you. It is kept in this computer's own password store as you type it, never in a backup or a service file.");
        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                stream-yt := Check { text: "YouTube"; checked <=> SettingsDlg.stream-on-0; }
                if SettingsDlg.stream-account-0 == "": stream-yt-key := TextField { horizontal-stretch: 1; password: true; label: @tr("YouTube stream key"); placeholder: SettingsDlg.stream-saved-0 ? @tr("A key is saved. Type a new one to change it.") : @tr("Paste the stream key"); edited(t) => { SettingsDlg.stream-key-edited(0, t); } }
                if SettingsDlg.stream-account-0 == "" && SettingsDlg.stream-can-sign-in-0: stream-yt-sign-in := Btn {
                    small: true;
                    text: @tr("Sign in");
                    enabled: !SettingsDlg.stream-signing-in;
                    tooltip: @tr("Sign in instead of pasting a key: Go Live then makes the broadcast itself, with its title");
                    clicked => { SettingsDlg.stream-sign-in(0); }
                }
                if SettingsDlg.stream-account-0 != "": Text {
                    text: @tr("Signed in as {}", SettingsDlg.stream-account-0);
                    color: Theme.text;
                    font-family: Theme.font;
                    font-size: Theme.base-size;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                if SettingsDlg.stream-account-0 != "": stream-yt-sign-out := Btn { small: true; text: @tr("Sign out"); clicked => { SettingsDlg.stream-sign-out(0); } }
            }
            HorizontalLayout {
                spacing: 8px;
                stream-fb := Check { text: "Facebook"; checked <=> SettingsDlg.stream-on-1; }
                if SettingsDlg.stream-account-1 == "": stream-fb-key := TextField { horizontal-stretch: 1; password: true; label: @tr("Facebook stream key"); placeholder: SettingsDlg.stream-saved-1 ? @tr("A key is saved. Type a new one to change it.") : @tr("Paste the stream key"); edited(t) => { SettingsDlg.stream-key-edited(1, t); } }
                if SettingsDlg.stream-account-1 == "" && SettingsDlg.stream-can-sign-in-1: stream-fb-sign-in := Btn {
                    small: true;
                    text: @tr("Sign in");
                    enabled: !SettingsDlg.stream-signing-in;
                    tooltip: @tr("Sign in instead of pasting a key: Go Live then makes the broadcast itself, with its title");
                    clicked => { SettingsDlg.stream-sign-in(1); }
                }
                if SettingsDlg.stream-account-1 != "": Text {
                    text: @tr("Signed in as {}", SettingsDlg.stream-account-1);
                    color: Theme.text;
                    font-family: Theme.font;
                    font-size: Theme.base-size;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                if SettingsDlg.stream-account-1 != "": stream-fb-sign-out := Btn { small: true; text: @tr("Sign out"); clicked => { SettingsDlg.stream-sign-out(1); } }
            }
            HorizontalLayout {
                spacing: 8px;
                stream-tw := Check { text: "Twitch"; checked <=> SettingsDlg.stream-on-2; }
                if SettingsDlg.stream-account-2 == "": stream-tw-key := TextField { horizontal-stretch: 1; password: true; label: @tr("Twitch stream key"); placeholder: SettingsDlg.stream-saved-2 ? @tr("A key is saved. Type a new one to change it.") : @tr("Paste the stream key"); edited(t) => { SettingsDlg.stream-key-edited(2, t); } }
                if SettingsDlg.stream-account-2 == "" && SettingsDlg.stream-can-sign-in-2: stream-tw-sign-in := Btn {
                    small: true;
                    text: @tr("Sign in");
                    enabled: !SettingsDlg.stream-signing-in;
                    tooltip: @tr("Sign in instead of pasting a key: Go Live then makes the broadcast itself, with its title");
                    clicked => { SettingsDlg.stream-sign-in(2); }
                }
                if SettingsDlg.stream-account-2 != "": Text {
                    text: @tr("Signed in as {}", SettingsDlg.stream-account-2);
                    color: Theme.text;
                    font-family: Theme.font;
                    font-size: Theme.base-size;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                if SettingsDlg.stream-account-2 != "": stream-tw-sign-out := Btn { small: true; text: @tr("Sign out"); clicked => { SettingsDlg.stream-sign-out(2); } }
            }
            HorizontalLayout {
                spacing: 8px;
                stream-custom := Check { text: @tr("Another server"); checked <=> SettingsDlg.stream-on-3; }
                stream-custom-url := TextField { horizontal-stretch: 1; label: @tr("The server's address"); placeholder: @tr("Its address: rtmp://, rtmps:// or srt://"); text <=> SettingsDlg.stream-url; }
                stream-custom-key := TextField { horizontal-stretch: 1; password: true; label: @tr("The server's stream key"); placeholder: SettingsDlg.stream-saved-3 ? @tr("A key is saved. Type a new one to change it.") : @tr("Its stream key, if it has one"); edited(t) => { SettingsDlg.stream-key-edited(3, t); } }
            }
            HorizontalLayout {
                spacing: 8px;
                stream-ig := Check { text: "Instagram"; checked <=> SettingsDlg.stream-on-4; }
                stream-ig-url := TextField { horizontal-stretch: 1; label: @tr("Instagram's server address"); placeholder: @tr("Its server address, if Instagram shows one"); text <=> SettingsDlg.stream-url-4; }
                stream-ig-key := TextField { horizontal-stretch: 1; password: true; label: @tr("Instagram stream key"); placeholder: SettingsDlg.stream-saved-4 ? @tr("A key is saved. Type a new one to change it.") : @tr("Paste the stream key"); edited(t) => { SettingsDlg.stream-key-edited(4, t); } }
            }
            HorizontalLayout {
                spacing: 8px;
                stream-x := Check { text: "X"; checked <=> SettingsDlg.stream-on-5; }
                stream-x-url := TextField { horizontal-stretch: 1; label: @tr("X's server address"); placeholder: @tr("Its server address, if X shows one"); text <=> SettingsDlg.stream-url-5; }
                stream-x-key := TextField { horizontal-stretch: 1; password: true; label: @tr("X stream key"); placeholder: SettingsDlg.stream-saved-5 ? @tr("A key is saved. Type a new one to change it.") : @tr("Paste the stream key"); edited(t) => { SettingsDlg.stream-key-edited(5, t); } }
            }
            HorizontalLayout {
                spacing: 8px;
                stream-tt := Check { text: "TikTok"; checked <=> SettingsDlg.stream-on-6; }
                stream-tt-url := TextField { horizontal-stretch: 1; label: @tr("TikTok's server address"); placeholder: @tr("The server address TikTok shows with the key"); text <=> SettingsDlg.stream-url-6; }
                stream-tt-key := TextField { horizontal-stretch: 1; password: true; label: @tr("TikTok stream key"); placeholder: SettingsDlg.stream-saved-6 ? @tr("A key is saved. Type a new one to change it.") : @tr("Paste the stream key"); edited(t) => { SettingsDlg.stream-key-edited(6, t); } }
            }
            Text {
                text: @tr("Instagram, X and TikTok give stream keys only to some accounts (TikTok asks for enough followers; Instagram's come from Live Producer on a computer). Each shows a server address with the key: paste both. Their keys often work for one broadcast only.");
                color: Theme.muted;
                font-family: Theme.font;
                font-size: Theme.base-size;
                wrap: word-wrap;
                accessible-role: text;
                accessible-label: self.text;
            }
            if SettingsDlg.stream-sign-in-text != "": Text {
                text: SettingsDlg.stream-sign-in-text;
                color: Theme.text;
                font-family: Theme.font;
                font-size: Theme.base-size;
                wrap: word-wrap;
                accessible-role: text;
                accessible-label: self.text;
            }
        }
    }
    Field {
        label: @tr("Tall for phones");
        help: @tr("These get a tall picture (for YouTube Shorts, Reels, TikTok and other phone apps): the wide picture across the middle, black above and below. The recording stays wide.");
        HorizontalLayout {
            alignment: start;
            spacing: 14px;
            stream-tall-yt := Check { text: "YouTube"; checked <=> SettingsDlg.stream-tall-0; }
            stream-tall-fb := Check { text: "Facebook"; checked <=> SettingsDlg.stream-tall-1; }
            stream-tall-tw := Check { text: "Twitch"; checked <=> SettingsDlg.stream-tall-2; }
            stream-tall-custom := Check { text: @tr("Another server"); checked <=> SettingsDlg.stream-tall-3; }
            stream-tall-ig := Check { text: "Instagram"; checked <=> SettingsDlg.stream-tall-4; }
            stream-tall-x := Check { text: "X"; checked <=> SettingsDlg.stream-tall-5; }
            stream-tall-tt := Check { text: "TikTok"; checked <=> SettingsDlg.stream-tall-6; }
        }
    }
    Field {
        label: @tr("More settings");
        help: @tr("Pictures a second, video format, sound quality, which network card sends, each destination's own quality, the recording's file type and name, and setups saved by name (Sunday, Wedding) to use again in one go.");
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            stream-more-btn := Btn {
                text: @tr("More settings and saved setups…");
                clicked => { SettingsDlg.edit-stream-more(); }
            }
            if SettingsDlg.stream-setup != "": Text {
                text: @tr("Setup: {}", SettingsDlg.stream-setup);
                color: Theme.muted;
                font-family: Theme.font;
                font-size: Theme.base-size;
                vertical-alignment: center;
            }
        }
    }
    if SettingsDlg.stream-account-0 != "" || SettingsDlg.stream-account-1 != "": Field {
        label: @tr("Broadcast title");
        help: @tr("What YouTube and Facebook call each broadcast. {{date}} becomes the day's date, {{weekday}} the day's name and {{time}} the time; the description can have them too.");
        stream-title := TextField { label: @tr("Broadcast title"); placeholder: @tr("Sunday Service — {{date}}"); text <=> SettingsDlg.stream-title; }
    }
    if SettingsDlg.stream-account-0 != "" || SettingsDlg.stream-account-1 != "": Field {
        label: @tr("Description");
        stream-description := TextField { label: @tr("Broadcast description"); placeholder: @tr("What viewers read under the video"); text <=> SettingsDlg.stream-description; }
        if SettingsDlg.stream-account-0 != "": HorizontalLayout {
            spacing: 8px;
            Text {
                text: SettingsDlg.stream-scheduled-link == "" ? @tr("Next YouTube broadcast: made when you go live") : @tr("Next YouTube broadcast: {}", SettingsDlg.stream-scheduled-link);
                color: Theme.text;
                font-family: Theme.font;
                font-size: Theme.base-size;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if SettingsDlg.stream-scheduled-link != "": stream-copy-link := Btn { small: true; text: @tr("Copy the link"); clicked => { SettingsDlg.stream-copy-link(); } }
            stream-schedule := Btn {
                small: true;
                text: SettingsDlg.stream-scheduled-link == "" ? @tr("Make it now, to share the link") : @tr("Make a new one");
                enabled: !SettingsDlg.stream-signing-in;
                tooltip: @tr("Makes the next service's YouTube broadcast now, for its day and start time, so its link can be shared before Sunday. Go Live uses it.");
                clicked => { SettingsDlg.stream-schedule(); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: SettingsDlg.stream-thumbnail == "" ? @tr("YouTube thumbnail: a frame of the stream") : @tr("YouTube thumbnail: {}", SettingsDlg.stream-thumbnail);
                color: Theme.text;
                font-family: Theme.font;
                font-size: Theme.base-size;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            stream-thumbnail-btn := Btn {
                small: true;
                text: SettingsDlg.stream-thumbnail == "" ? @tr("Choose a picture…") : @tr("No picture");
                clicked => { if SettingsDlg.stream-thumbnail == "" { SettingsDlg.stream-card-choose(3); } else { SettingsDlg.stream-thumbnail = ""; } }
            }
        }
    }
    if SettingsDlg.stream-account-0 != "": Field {
        label: @tr("Who can watch on YouTube");
        stream-privacy := Segmented {
            labels: [@tr("Everyone"), @tr("Only people with the link")];
            index <=> SettingsDlg.stream-privacy;
        }
    }
    StreamExtrasRows { }
    Rectangle { height: 14px; }
    Heading { text: @tr("Media library"); }
    Rectangle { height: 6px; }
    Note {
        text: @tr("Every file you add is copied into RustyPresenter's own folder, so moving or deleting the original never breaks a slide.");
    }
    Rectangle { height: 6px; }
    HorizontalLayout {
        alignment: start;
        cleanup := Btn {
            small: true;
            text: @tr("Clean up unused media…");
            clicked => { SettingsDlg.cleanup-media(); }
        }
    }
}
