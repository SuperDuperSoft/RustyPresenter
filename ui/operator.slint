// The native operator window (`web/operator.html`): the top bar over three columns (`operator.css:52`).
import { Theme, OperatorState } from "theme.slint";
import { Panel } from "widgets.slint";
import { Palette } from "std-widgets.slint";
import { TopBar, TranslationChip } from "operator/topbar.slint";
import { ServiceColumn, ServiceRow } from "operator/service.slint";
import { SlidesPanel, SlideCell, SlideRowCells, SlideJump } from "operator/slides.slint";
import { MediaBin, BinRow, BinFolder } from "operator/media.slint";
import { LiveColumn, TransportCell, LiveSong } from "operator/live.slint";
import { Side } from "room.slint";
import { ToastStack, JobsBox, DropHint, ToastRow, JobRow } from "operator/overlays.slint";
import { DialogShell } from "dialogs/shell.slint";
import { AskOverlay, AskRow } from "dialogs/ask.slint";
import { AddDialog } from "dialogs/add.slint";
import { SongEditor } from "dialogs/song-editor.slint";
import { ItemEditDialog } from "dialogs/item-edit.slint";
import { ServicesDialog, ServicesDialogState } from "dialogs/services.slint";
import { PrintDialog } from "dialogs/print.slint";
import { ScreensDialog } from "dialogs/screens.slint";
import { PhoneDialog } from "dialogs/phone.slint";
import { SettingsDialog } from "dialogs/settings.slint";
import { UsageDialog } from "dialogs/usage.slint";

export { TranslationChip, ServiceRow, SlideCell, SlideRowCells, SlideJump, TransportCell, LiveSong, BinRow, BinFolder }

export component OperatorWindow inherits Window {
    title: @tr("RustyPresenter");
    min-width: 1024px;
    min-height: 640px;
    preferred-width: 1440px;
    preferred-height: 900px;
    background: Theme.bg;
    default-font-family: Theme.font;
    default-font-size: Theme.base-size;
    forward-focus: keys;

    /// `operator.css:239`: at 1250 px or less the top bar drops the brand word and labels. Set from a change handler,
    /// not a binding: the top bar's width needs depend on it, and the window's width on those (a binding loop).
    /// `changed` fires only on a change, so `init` sets it for a window whose first width is already its last.
    out property <bool> narrow;
    /// Below 1400 px the Bible box's favourite and recent chips are hidden, leaving the chosen one (`TopBar.compact`), so the top
    /// bar fits a 1280 px window. Set with `narrow`, for the same reason.
    out property <bool> compact;
    /// The Verses button shows with the full Bible box; narrower, it is still in Add → Bible and Settings → Look.
    out property <bool> verses-shown;
    init => {
        // The app is always dark; the menu bar Slint draws (Linux) and its drop-downs follow the style's palette.
        Palette.color-scheme = ColorScheme.dark;
        root.fit();
    }
    changed width => { root.fit(); }
    function fit() {
        root.narrow = root.width <= 1250px;
        root.compact = root.width < 1400px;
        root.verses-shown = !root.compact;
    }

    // Top bar (see `TopBar`).
    in property <string> service-name: @tr("Service");
    in property <[TranslationChip]> translations;
    in property <[TranslationChip]> quick-chips;
    in property <string> translation;
    in property <[TranslationChip]> picker-rows;
    in-out property <string> picker-search;
    in property <string> picker-note;
    in-out property <string> bible-text;
    /// Verses per slide for the next passage: 0 Automatic, else 1–4.
    in property <int> bible-per-slide;
    in property <bool> room-on;
    in property <string> room-state: "warn";
    in property <string> room-tip;
    in property <bool> stage-shown;
    in property <bool> stage-on;
    in property <string> phones-label;

    /// The first state read has arrived (the web `onopen`); until then the columns stay empty, with no Welcome.
    in property <bool> loaded;
    in property <int> item-count;

    // Service column (see `ServiceColumn`).
    in property <[ServiceRow]> service-rows;
    in property <string> service-count;
    callback service-select(string);
    callback service-show-first(string);
    callback service-edit(string);
    callback service-remove(string);
    callback service-add();
    callback service-move(string, int);
    callback service-drag-started();
    callback service-drag-finished();
    pure callback service-drag-data(string) -> data-transfer;
    pure callback service-drag-id(data-transfer) -> string;

    // Slides column (see `SlidesPanel`).
    in property <string> slides-title: @tr("Nothing selected");
    in property <string> slides-kind;
    in property <bool> has-selection;
    in property <int> slide-count;
    in property <[SlideRowCells]> slide-rows;
    in property <int> slide-columns: 1;
    /// A song's sections, to jump straight to one.
    in property <[SlideJump]> slide-jumps;
    out property <length> slides-grid-width: slides.grid-width;
    callback slides-show(int);
    callback slides-pick-section(int);
    callback slides-edit();
    callback slides-grid-resized(length);
    /// A Bible passage is selected: its text size ("Auto" or pixels) with A− / A+ / Auto.
    in property <bool> slides-text-size-shown;
    in property <string> slides-text-size;
    in property <bool> slides-text-size-custom;
    /// The selected item's note under the grid (a passage's missing verses), or "".
    in property <string> slides-note;
    in property <bool> slides-custom-order;
    callback slides-text-smaller();
    callback slides-text-larger();
    callback slides-text-auto();
    public function slides-scroll-to-row(row: int) { slides.scroll-to-row(row); }
    public function slides-scroll-to-top() { slides.scroll-to-top(); }

    // The media library (see `MediaBin`).
    in property <[BinRow]> bin-rows;
    in property <[BinFolder]> bin-folders;
    in property <string> bin-tab: "all";
    in property <bool> bin-has-pick;
    in property <string> bin-pick-name;
    in property <string> bin-pick-hint;
    in property <bool> bin-can-use;
    in property <bool> bin-can-delete-folder;
    callback bin-set-tab(string);
    callback bin-set-folder(string);
    callback bin-search(string);
    callback bin-pick(string);
    callback bin-use-picked();
    callback bin-add-picked();
    callback bin-move-picked();
    callback bin-import();
    callback bin-new-folder();
    callback bin-delete-folder();

    // Live column (see `LiveColumn`).
    in property <bool> live-pending;
    in property <string> live-what;
    in property <string> live-notice;
    in property <LiveSong> live-song;
    callback live-song-action(string);
    in property <bool> logo-on;
    in property <string> up-next-title;
    in property <string> up-next-body: @tr("—");
    in property <[TransportCell]> transport;
    in property <Side> monitor-bg;
    in property <bool> monitor-bg-visible: true;
    in property <Side> monitor-media;
    in property <Side> monitor-slide;
    in property <Side> monitor-logo;
    in property <bool> monitor-video;
    in property <image> monitor-video-frame;
    in property <bool> monitor-video-cover;
    in property <float> monitor-black;
    in property <bool> monitor-room-off;
    out property <length> monitor-width: live.monitor-width;
    callback live-next();
    callback live-prev();
    callback live-clear(string);
    callback transport-toggle(int);
    callback monitor-resized(length);

    // Toasts and the jobs box (see `overlays.slint`).
    in property <[ToastRow]> toasts;
    in property <[JobRow]> jobs;
    callback job-dismiss(string);
    /// Files are being dragged over the window (set from the winit filter, see `files.rs`).
    in property <bool> drop-hint;
    callback job-cancel(string);

    callback services();
    callback screens();
    callback phone();
    callback stage-message();
    callback check-service();
    callback settings();
    /// Opens the Song use report (FEAT-7 §3.3); for the menu bar and Settings → Songs.
    callback usage-report();
    callback bible-submit(string);
    callback pick-translation(int);
    callback picker-opening();
    callback picker-search-changed(string);
    callback picker-accept();
    callback pick-bible(string);
    callback toggle-favourite(string);
    callback find-more-bibles(string);
    callback cycle-per-slide();

    // The menu bar (`src/ui/operator/menu.rs`).
    /// There is a current service (File → Save this service to a file…).
    in property <bool> has-service;
    callback menu(string);
    /// Items that open a dialog or act on the window: the first read is in and nothing covers the window (its
    /// buttons are under a dialog's backdrop then).
    out property <bool> menu-ready: root.loaded && !root.covered;
    out property <bool> menu-can-edit: root.menu-ready && root.has-selection;
    out property <bool> menu-can-save: root.menu-ready && root.has-service;

    /// One key press, for `keys::route` in Rust: the key's text, Ctrl (Cmd on macOS), Alt, whether a text field
    /// has focus and whether that field is the Bible box. True when the key was used.
    callback key(string, bool, bool, bool, bool) -> bool;

    /// Gives the keyboard back to the window's keys, as the web's `blur()` does. A dialog calls this when it
    /// closes: a field destroyed while focused never runs its `changed has-focus`, so the flag is cleared here.
    public function focus-keys() {
        keys.focus();
        OperatorState.focus-in-text = false;
    }

    public function focus-bible() { top.focus-bible(); }
    /// Opens the Bible picker (tests and the chosen chip).
    public function open-bible-picker() { top.open-picker(); }

    // The dialog layer (see `src/ui/dialogs`): one dialog at a time, swapped in place like the web `<dialog>`.
    in property <bool> dialog-open;
    in property <string> dialog-kind;
    in property <string> dialog-title;
    in property <bool> dialog-wide;
    property <int> dialog-focus-serial;
    callback dialog-close();
    /// Gives the keyboard back to the open dialog (a question over it was answered).
    public function focus-dialog() {
        root.dialog-focus-serial += 1;
        OperatorState.focus-in-text = false;
    }
    /// The question on top (none or one row): a confirm or prompt over the dialog or the bare window.
    in property <[AskRow]> ask;
    callback ask-answer(bool, string);
    callback ask-other();

    /// Keys offered to Rust before the focused field sees them (`capture-key-pressed`): F1–F5 and Ctrl+B everywhere,
    /// and Alt+key in the Bible box, where the field would otherwise type the digit. Which Alt keys pick a
    /// translation is decided in Rust (`keys::route`): the number row gives other characters on some layouts.
    pure function captured(e: KeyEvent) -> bool {
        return e.text == Key.F1 || e.text == Key.F2 || e.text == Key.F3 || e.text == Key.F4 || e.text == Key.F5
            || (e.modifiers.control && (e.text == "b" || e.text == "B"))
            || (e.modifiers.alt && top.bible-focused);
    }

    /// A dialog or question covers the window: Tab must not reach the window's keys or the Bible box under it.
    property <bool> covered: root.dialog-open || root.ask.length > 0;

    function send-key(e: KeyEvent) -> bool {
        return root.key(e.text, e.modifiers.control, e.modifiers.alt, OperatorState.focus-in-text, top.bible-focused);
    }

    // File, Edit, View, Window, Settings, Help. Each item runs what its button or key runs. Only F1–F5 and Ctrl+B are
    // bound as shortcuts: the window matches them before any text box, and these do the same wherever the focus is.
    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem {
                title: @tr("New service…");
                enabled: root.menu-ready;
                activated => { root.focus-keys(); ServicesDialogState.new-service(); }
            }
            MenuItem {
                title: @tr("Services…");
                enabled: root.menu-ready;
                activated => { root.focus-keys(); root.services(); }
            }
            MenuItem {
                title: @tr("Open a service file…");
                enabled: root.menu-ready;
                activated => { root.focus-keys(); ServicesDialogState.open-file(); }
            }
            MenuItem {
                title: @tr("Save this service to a file…");
                enabled: root.menu-can-save;
                activated => { root.focus-keys(); ServicesDialogState.save-file(); }
            }
            MenuSeparator {}
            Menu {
                title: @tr("Add to service");
                enabled: root.menu-ready;
                MenuItem {
                    title: @tr("Song…");
                    activated => { root.focus-keys(); root.menu("add-song"); }
                }
                MenuItem {
                    title: @tr("Bible passage…");
                    activated => { root.focus-keys(); root.menu("add-bible"); }
                }
                MenuItem {
                    title: @tr("Video & media…");
                    activated => { root.focus-keys(); root.menu("add-media"); }
                }
                MenuItem {
                    title: @tr("Slides…");
                    activated => { root.focus-keys(); root.menu("add-slides"); }
                }
                MenuItem {
                    title: @tr("Announcement…");
                    activated => { root.focus-keys(); root.menu("add-text"); }
                }
            }
            MenuItem {
                title: @tr("Import media…");
                enabled: root.menu-ready;
                activated => { root.focus-keys(); root.bin-import(); }
            }
            MenuSeparator {}
            MenuItem {
                title: @tr("Exit");
                activated => { root.menu("exit"); }
            }
        }
        Menu {
            title: @tr("Edit");
            MenuItem {
                title: @tr("Edit the selected item…");
                enabled: root.menu-can-edit;
                activated => { root.focus-keys(); root.slides-edit(); }
            }
            MenuItem {
                title: @tr("Bible box");
                shortcut: @keys(Control + B);
                enabled: !root.covered;
                activated => { root.focus-bible(); }
            }
        }
        Menu {
            title: @tr("View");
            MenuItem {
                title: @tr("Next");
                enabled: !root.covered;
                activated => { root.focus-keys(); root.live-next(); }
            }
            MenuItem {
                title: @tr("Back");
                enabled: !root.covered;
                activated => { root.focus-keys(); root.live-prev(); }
            }
            MenuSeparator {}
            MenuItem {
                title: @tr("Clear all");
                shortcut: @keys(F1);
                activated => { root.live-clear("clear_all"); }
            }
            MenuItem {
                title: @tr("Clear text");
                shortcut: @keys(F2);
                activated => { root.live-clear("clear_slide"); }
            }
            MenuItem {
                title: @tr("Clear media & background");
                shortcut: @keys(F3);
                activated => { root.live-clear("clear_media"); }
            }
            MenuItem {
                title: @tr("Stop audio");
                shortcut: @keys(F4);
                activated => { root.live-clear("clear_audio"); }
            }
            MenuItem {
                title: @tr("Logo");
                shortcut: @keys(F5);
                activated => { root.live-clear("logo"); }
            }
            MenuSeparator {}
            MenuItem {
                title: bin.open ? @tr("Hide media library") : @tr("Show media library");
                enabled: !root.covered;
                activated => { bin.open = !bin.open; }
            }
        }
        Menu {
            title: @tr("Window");
            MenuItem {
                title: @tr("Screens…");
                enabled: root.menu-ready;
                activated => { root.focus-keys(); root.screens(); }
            }
            MenuItem {
                title: @tr("Phone remote…");
                enabled: root.menu-ready;
                activated => { root.focus-keys(); root.phone(); }
            }
            MenuItem {
                title: @tr("Stage message…");
                enabled: root.menu-ready && root.stage-shown;
                activated => { root.focus-keys(); root.stage-message(); }
            }
        }
        Menu {
            title: @tr("Settings");
            MenuItem {
                title: @tr("Settings…");
                enabled: root.menu-ready;
                activated => { root.focus-keys(); root.settings(); }
            }
            MenuSeparator {}
            MenuItem {
                title: @tr("Songs…");
                enabled: root.menu-ready;
                activated => { root.focus-keys(); root.menu("settings-songs"); }
            }
            MenuItem {
                title: @tr("Bible…");
                enabled: root.menu-ready;
                activated => { root.focus-keys(); root.menu("settings-bible"); }
            }
            MenuItem {
                title: @tr("Video…");
                enabled: root.menu-ready;
                activated => { root.focus-keys(); root.menu("settings-video"); }
            }
            MenuItem {
                title: @tr("Backups…");
                enabled: root.menu-ready;
                activated => { root.focus-keys(); root.menu("settings-backups"); }
            }
        }
        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("Keyboard shortcuts");
                enabled: root.menu-ready;
                activated => { root.focus-keys(); root.menu("settings-help"); }
            }
            MenuItem {
                title: @tr("Check the service");
                enabled: root.menu-ready;
                activated => { root.focus-keys(); root.check-service(); }
            }
            MenuSeparator {}
            MenuItem {
                title: @tr("About RustyPresenter");
                enabled: root.menu-ready;
                activated => { root.focus-keys(); root.menu("settings-about"); }
            }
        }
    }

    // The window's key scope (`operator.js:305-320`). Everything else reaches it only when the focused field
    // leaves the key alone (`key-pressed` bubbles), so a text field keeps its arrows, Space and Enter.
    keys := FocusScope {
        focus-on-tab-navigation: !root.covered;
        capture-key-pressed(event) => {
            if root.captured(event) && root.send-key(event) { return accept; }
            reject
        }
        key-pressed(event) => {
            if root.send-key(event) { return accept; }
            reject
        }

        VerticalLayout {
            top := TopBar {
                narrow: root.narrow;
                compact: root.compact;
                verses-shown: root.verses-shown;
                covered: root.covered;
                service-name: root.service-name;
                translations: root.translations;
                quick-chips: root.quick-chips;
                translation: root.translation;
                picker-rows: root.picker-rows;
                picker-search <=> root.picker-search;
                picker-note: root.picker-note;
                bible-text <=> root.bible-text;
                bible-per-slide: root.bible-per-slide;
                room-on: root.room-on;
                room-state: root.room-state;
                room-tip: root.room-tip;
                stage-shown: root.stage-shown;
                stage-on: root.stage-on;
                phones-label: root.phones-label;
                services => { root.focus-keys(); root.services(); }
                screens => { root.focus-keys(); root.screens(); }
                phone => { root.focus-keys(); root.phone(); }
                stage-message => { root.focus-keys(); root.stage-message(); }
                settings => { root.focus-keys(); root.settings(); }
                bible-submit(text) => { root.bible-submit(text); }
                pick-translation(i) => { root.pick-translation(i); }
                picker-opening => { root.picker-opening(); }
                picker-search-changed(text) => { root.picker-search-changed(text); }
                picker-accept => { root.picker-accept(); }
                pick-bible(id) => { root.pick-bible(id); }
                toggle-favourite(id) => { root.toggle-favourite(id); }
                find-more-bibles(text) => { root.focus-keys(); root.find-more-bibles(text); }
                cycle-per-slide => { root.cycle-per-slide(); }
            }

            // The work area (service, slides, media library) beside the live column, which runs the full height.
            HorizontalLayout {
                vertical-stretch: 1;
                padding: 8px;
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    spacing: 8px;
                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 8px;
                        service-col := Panel {
                            min-width: 250px;
                            preferred-width: 264px;
                            max-width: 280px;
                            horizontal-stretch: 0;
                            ServiceColumn {
                                vertical-stretch: 1;
                                rows: root.service-rows;
                                count: root.service-count;
                                loaded: root.loaded;
                                select(id) => { root.focus-keys(); root.service-select(id); }
                                show-first(id) => { root.focus-keys(); root.service-show-first(id); }
                                edit(id) => { root.focus-keys(); root.service-edit(id); }
                                remove(id) => { root.focus-keys(); root.service-remove(id); }
                                add => { root.focus-keys(); root.service-add(); }
                                check => { root.focus-keys(); root.check-service(); }
                                move(id, to) => { root.service-move(id, to); }
                                drag-started => { root.service-drag-started(); }
                                drag-finished => { root.service-drag-finished(); }
                                drag-data(id) => { return root.service-drag-data(id); }
                                drag-id(data) => { return root.service-drag-id(data); }
                            }
                        }
                        slides-col := Panel {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            slides := SlidesPanel {
                                vertical-stretch: 1;
                                title: root.slides-title;
                                kind: root.slides-kind;
                                has-selection: root.has-selection;
                                slide-count: root.slide-count;
                                rows: root.slide-rows;
                                columns: root.slide-columns;
                                jumps: root.slide-jumps;
                                loaded: root.loaded;
                                item-count: root.item-count;
                                window-height: root.height;
                                show(idx) => { root.focus-keys(); root.slides-show(idx); }
                                pick-section(i) => { root.focus-keys(); root.slides-pick-section(i); }
                                edit => { root.focus-keys(); root.slides-edit(); }
                                text-size-shown: root.slides-text-size-shown;
                                text-size: root.slides-text-size;
                                text-size-custom: root.slides-text-size-custom;
                                note: root.slides-note;
                                custom-order: root.slides-custom-order;
                                text-smaller => { root.focus-keys(); root.slides-text-smaller(); }
                                text-larger => { root.focus-keys(); root.slides-text-larger(); }
                                text-auto => { root.focus-keys(); root.slides-text-auto(); }
                                grid-resized(w) => { root.slides-grid-resized(w); }
                            }
                        }
                    }
                    bin-col := Panel {
                        vertical-stretch: 0;
                        bin := MediaBin {
                            rows: root.bin-rows;
                            folders: root.bin-folders;
                            tab: root.bin-tab;
                            has-pick: root.bin-has-pick;
                            pick-name: root.bin-pick-name;
                            pick-hint: root.bin-pick-hint;
                            can-use: root.bin-can-use;
                            can-delete-folder: root.bin-can-delete-folder;
                            set-tab(t) => { root.focus-keys(); root.bin-set-tab(t); }
                            set-folder(f) => { root.focus-keys(); root.bin-set-folder(f); }
                            search(q) => { root.bin-search(q); }
                            pick(id) => { root.focus-keys(); root.bin-pick(id); }
                            use-picked => { root.focus-keys(); root.bin-use-picked(); }
                            add-picked => { root.focus-keys(); root.bin-add-picked(); }
                            move-picked => { root.bin-move-picked(); }
                            import => { root.focus-keys(); root.bin-import(); }
                            new-folder => { root.bin-new-folder(); }
                            delete-folder => { root.bin-delete-folder(); }
                        }
                    }
                }
                live-col := Panel {
                    min-width: 360px;
                    preferred-width: 440px;
                    max-width: 440px;
                    horizontal-stretch: 0;
                    live := LiveColumn {
                        vertical-stretch: 1;
                        pending: root.live-pending;
                        live-what: root.live-what;
                        notice: root.live-notice;
                        song: root.live-song;
                        song-action(a) => { root.focus-keys(); root.live-song-action(a); }
                        logo-on: root.logo-on;
                        up-next-title: root.up-next-title;
                        up-next-body: root.up-next-body;
                        transport: root.transport;
                        monitor-bg: root.monitor-bg;
                        monitor-bg-visible: root.monitor-bg-visible;
                        monitor-media: root.monitor-media;
                        monitor-slide: root.monitor-slide;
                        monitor-logo: root.monitor-logo;
                        monitor-video: root.monitor-video;
                        monitor-video-frame: root.monitor-video-frame;
                        monitor-video-cover: root.monitor-video-cover;
                        monitor-black: root.monitor-black;
                        monitor-room-off: root.monitor-room-off;
                        next => { root.focus-keys(); root.live-next(); }
                        prev => { root.focus-keys(); root.live-prev(); }
                        clear(cmd) => { root.focus-keys(); root.live-clear(cmd); }
                        transport-toggle(i) => { root.focus-keys(); root.transport-toggle(i); }
                        monitor-resized(w) => { root.monitor-resized(w); }
                    }
                }
            }
        }

        if root.dialog-open: DialogShell {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            title: root.dialog-title;
            wide: root.dialog-wide;
            focus-serial: root.dialog-focus-serial;
            close => { root.dialog-close(); }
            if root.dialog-kind == "add": AddDialog { window-height: root.height; }
            if root.dialog-kind == "song-editor": SongEditor { window-height: root.height; }
            if root.dialog-kind == "item-edit": ItemEditDialog { close => { root.dialog-close(); } }
            if root.dialog-kind == "services": ServicesDialog {}
            if root.dialog-kind == "print": PrintDialog {}
            if root.dialog-kind == "screens": ScreensDialog {}
            if root.dialog-kind == "phone": PhoneDialog {}
            if root.dialog-kind == "settings": SettingsDialog {}
            if root.dialog-kind == "usage": UsageDialog {}
        }

        for a in root.ask: AskOverlay {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            ask: a;
            answer(ok, text) => { root.ask-answer(ok, text); }
            other => { root.ask-other(); }
        }
    }

    // Over the columns: the jobs box (`z-index: 40`), then the toasts (`z-index: 50`).
    JobsBox {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        jobs: root.jobs;
        dismiss(id) => { root.job-dismiss(id); }
        cancel(id) => { root.job-cancel(id); }
    }
    ToastStack {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        toasts: root.toasts;
    }
    // Files dragged over the window (`z-index: 60`, over the toasts).
    if root.drop-hint: DropHint {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
    }
}
