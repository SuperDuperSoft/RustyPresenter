// The native operator window (`web/operator.html`): the top bar over three columns (`operator.css:52`).
import { Theme, OperatorState } from "theme.slint";
import { Panel } from "widgets.slint";
import { TopBar, TranslationChip } from "operator/topbar.slint";
import { ServiceColumn, ServiceRow } from "operator/service.slint";
import { SlidesPanel, SlideCell, SlideRowCells } from "operator/slides.slint";
import { LiveColumn, TransportCell } from "operator/live.slint";
import { Layer } from "room.slint";
import { ToastStack, JobsBox, DropHint, ToastRow, JobRow } from "operator/overlays.slint";
import { DialogShell } from "dialogs/shell.slint";
import { AskOverlay, AskRow } from "dialogs/ask.slint";
import { AddDialog } from "dialogs/add.slint";
import { SongEditor } from "dialogs/song-editor.slint";
import { ItemEditDialog } from "dialogs/item-edit.slint";
import { ServicesDialog } from "dialogs/services.slint";
import { ScreensDialog } from "dialogs/screens.slint";
import { PhoneDialog } from "dialogs/phone.slint";
import { SettingsDialog } from "dialogs/settings.slint";

export { TranslationChip, ServiceRow, SlideCell, SlideRowCells, TransportCell }

export component OperatorWindow inherits Window {
    title: @tr("RustyPresenter");
    min-width: 1024px;
    min-height: 640px;
    preferred-width: 1440px;
    preferred-height: 900px;
    background: Theme.bg;
    default-font-family: Theme.font;
    default-font-size: Theme.base-size;
    forward-focus: keys;

    /// `operator.css:239`: at 1250 px or less the top bar drops the brand word and labels. Set from a change handler,
    /// not a binding: the top bar's width needs depend on it, and the window's width on those (a binding loop).
    /// `changed` fires only on a change, so `init` sets it for a window whose first width is already its last.
    out property <bool> narrow;
    init => { root.narrow = root.width <= 1250px; }
    changed width => { root.narrow = root.width <= 1250px; }

    // Top bar (see `TopBar`).
    in property <string> service-name: @tr("Service");
    in property <[TranslationChip]> translations;
    in-out property <string> bible-text;
    in property <bool> room-on;
    in property <string> room-state: "warn";
    in property <string> room-tip;
    in property <bool> stage-shown;
    in property <bool> stage-on;
    in property <string> phones-label;

    /// The first state read has arrived (the web `onopen`); until then the columns stay empty, with no Welcome.
    in property <bool> loaded;
    in property <int> item-count;

    // Service column (see `ServiceColumn`).
    in property <[ServiceRow]> service-rows;
    in property <string> service-count;
    callback service-select(string);
    callback service-show-first(string);
    callback service-edit(string);
    callback service-remove(string);
    callback service-add();
    callback service-move(string, int);
    callback service-drag-started();
    callback service-drag-finished();
    pure callback service-drag-data(string) -> data-transfer;
    pure callback service-drag-id(data-transfer) -> string;

    // Slides column (see `SlidesPanel`).
    in property <string> slides-title: @tr("Nothing selected");
    in property <string> slides-kind;
    in property <bool> has-selection;
    in property <int> slide-count;
    in property <[SlideRowCells]> slide-rows;
    in property <int> slide-columns: 1;
    out property <length> slides-grid-width: slides.grid-width;
    callback slides-show(int);
    callback slides-edit();
    callback slides-grid-resized(length);
    public function slides-scroll-to-row(row: int) { slides.scroll-to-row(row); }
    public function slides-scroll-to-top() { slides.scroll-to-top(); }

    // Live column (see `LiveColumn`).
    in property <bool> live-pending;
    in property <string> live-what;
    in property <string> live-notice;
    in property <bool> logo-on;
    in property <string> up-next-title;
    in property <string> up-next-body: @tr("—");
    in property <[TransportCell]> transport;
    in property <Layer> monitor-bg;
    in property <bool> monitor-bg-visible: true;
    in property <Layer> monitor-media;
    in property <Layer> monitor-slide;
    in property <Layer> monitor-logo;
    in property <bool> monitor-video;
    in property <image> monitor-video-frame;
    in property <bool> monitor-video-cover;
    in property <float> monitor-black;
    in property <bool> monitor-room-off;
    out property <length> monitor-width: live.monitor-width;
    callback live-next();
    callback live-prev();
    callback live-clear(string);
    callback transport-toggle(int);
    callback monitor-resized(length);

    // Toasts and the jobs box (see `overlays.slint`).
    in property <[ToastRow]> toasts;
    in property <[JobRow]> jobs;
    callback job-dismiss(string);
    /// Files are being dragged over the window (set from the winit filter, see `files.rs`).
    in property <bool> drop-hint;
    callback job-cancel(string);

    callback services();
    callback screens();
    callback phone();
    callback settings();
    callback bible-submit(string);
    callback pick-translation(int);

    /// One key press, for `keys::route` in Rust: the key's text, Ctrl (Cmd on macOS), Alt, whether a text field
    /// has focus and whether that field is the Bible box. True when the key was used.
    callback key(string, bool, bool, bool, bool) -> bool;

    /// Gives the keyboard back to the window's keys, as the web's `blur()` does. A dialog calls this when it
    /// closes: a field destroyed while focused never runs its `changed has-focus`, so the flag is cleared here.
    public function focus-keys() {
        keys.focus();
        OperatorState.focus-in-text = false;
    }

    public function focus-bible() { top.focus-bible(); }

    // The dialog layer (see `src/ui/dialogs`): one dialog at a time, swapped in place like the web `<dialog>`.
    in property <bool> dialog-open;
    in property <string> dialog-kind;
    in property <string> dialog-title;
    in property <bool> dialog-wide;
    property <int> dialog-focus-serial;
    callback dialog-close();
    /// Gives the keyboard back to the open dialog (a question over it was answered).
    public function focus-dialog() {
        root.dialog-focus-serial += 1;
        OperatorState.focus-in-text = false;
    }
    /// The question on top (none or one row): a confirm or prompt over the dialog or the bare window.
    in property <[AskRow]> ask;
    callback ask-answer(bool, string);
    callback ask-other();

    /// Keys offered to Rust before the focused field sees them (`capture-key-pressed`): F1–F5 and Ctrl+B everywhere,
    /// and Alt+key in the Bible box, where the field would otherwise type the digit. Which Alt keys pick a
    /// translation is decided in Rust (`keys::route`): the number row gives other characters on some layouts.
    pure function captured(e: KeyEvent) -> bool {
        return e.text == Key.F1 || e.text == Key.F2 || e.text == Key.F3 || e.text == Key.F4 || e.text == Key.F5
            || (e.modifiers.control && (e.text == "b" || e.text == "B"))
            || (e.modifiers.alt && top.bible-focused);
    }

    /// A dialog or question covers the window: Tab must not reach the window's keys or the Bible box under it.
    property <bool> covered: root.dialog-open || root.ask.length > 0;

    function send-key(e: KeyEvent) -> bool {
        return root.key(e.text, e.modifiers.control, e.modifiers.alt, OperatorState.focus-in-text, top.bible-focused);
    }

    // The window's key scope (`operator.js:305-320`). Everything else reaches it only when the focused field
    // leaves the key alone (`key-pressed` bubbles), so a text field keeps its arrows, Space and Enter.
    keys := FocusScope {
        focus-on-tab-navigation: !root.covered;
        capture-key-pressed(event) => {
            if root.captured(event) && root.send-key(event) { return accept; }
            reject
        }
        key-pressed(event) => {
            if root.send-key(event) { return accept; }
            reject
        }

        VerticalLayout {
            top := TopBar {
                narrow: root.narrow;
                covered: root.covered;
                service-name: root.service-name;
                translations: root.translations;
                bible-text <=> root.bible-text;
                room-on: root.room-on;
                room-state: root.room-state;
                room-tip: root.room-tip;
                stage-shown: root.stage-shown;
                stage-on: root.stage-on;
                phones-label: root.phones-label;
                services => { root.focus-keys(); root.services(); }
                screens => { root.focus-keys(); root.screens(); }
                phone => { root.focus-keys(); root.phone(); }
                settings => { root.focus-keys(); root.settings(); }
                bible-submit(text) => { root.bible-submit(text); }
                pick-translation(i) => { root.pick-translation(i); }
            }

            // `.layout`: minmax(250px, 300px) 1fr minmax(360px, 440px), 10 px gap and padding.
            HorizontalLayout {
                vertical-stretch: 1;
                padding: 10px;
                spacing: 10px;
                service-col := Panel {
                    min-width: 250px;
                    preferred-width: 300px;
                    max-width: 300px;
                    horizontal-stretch: 0;
                    ServiceColumn {
                        vertical-stretch: 1;
                        rows: root.service-rows;
                        count: root.service-count;
                        loaded: root.loaded;
                        select(id) => { root.focus-keys(); root.service-select(id); }
                        show-first(id) => { root.focus-keys(); root.service-show-first(id); }
                        edit(id) => { root.focus-keys(); root.service-edit(id); }
                        remove(id) => { root.focus-keys(); root.service-remove(id); }
                        add => { root.focus-keys(); root.service-add(); }
                        move(id, to) => { root.service-move(id, to); }
                        drag-started => { root.service-drag-started(); }
                        drag-finished => { root.service-drag-finished(); }
                        drag-data(id) => { return root.service-drag-data(id); }
                        drag-id(data) => { return root.service-drag-id(data); }
                    }
                }
                slides-col := Panel {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    slides := SlidesPanel {
                        vertical-stretch: 1;
                        title: root.slides-title;
                        kind: root.slides-kind;
                        has-selection: root.has-selection;
                        slide-count: root.slide-count;
                        rows: root.slide-rows;
                        columns: root.slide-columns;
                        loaded: root.loaded;
                        item-count: root.item-count;
                        window-height: root.height;
                        show(idx) => { root.focus-keys(); root.slides-show(idx); }
                        edit => { root.focus-keys(); root.slides-edit(); }
                        grid-resized(w) => { root.slides-grid-resized(w); }
                    }
                }
                live-col := Panel {
                    min-width: 360px;
                    preferred-width: 440px;
                    max-width: 440px;
                    horizontal-stretch: 0;
                    live := LiveColumn {
                        vertical-stretch: 1;
                        pending: root.live-pending;
                        live-what: root.live-what;
                        notice: root.live-notice;
                        logo-on: root.logo-on;
                        up-next-title: root.up-next-title;
                        up-next-body: root.up-next-body;
                        transport: root.transport;
                        monitor-bg: root.monitor-bg;
                        monitor-bg-visible: root.monitor-bg-visible;
                        monitor-media: root.monitor-media;
                        monitor-slide: root.monitor-slide;
                        monitor-logo: root.monitor-logo;
                        monitor-video: root.monitor-video;
                        monitor-video-frame: root.monitor-video-frame;
                        monitor-video-cover: root.monitor-video-cover;
                        monitor-black: root.monitor-black;
                        monitor-room-off: root.monitor-room-off;
                        next => { root.focus-keys(); root.live-next(); }
                        prev => { root.focus-keys(); root.live-prev(); }
                        clear(cmd) => { root.focus-keys(); root.live-clear(cmd); }
                        transport-toggle(i) => { root.focus-keys(); root.transport-toggle(i); }
                        monitor-resized(w) => { root.monitor-resized(w); }
                    }
                }
            }
        }

        if root.dialog-open: DialogShell {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            title: root.dialog-title;
            wide: root.dialog-wide;
            focus-serial: root.dialog-focus-serial;
            close => { root.dialog-close(); }
            if root.dialog-kind == "add": AddDialog { window-height: root.height; }
            if root.dialog-kind == "song-editor": SongEditor { window-height: root.height; }
            if root.dialog-kind == "item-edit": ItemEditDialog { close => { root.dialog-close(); } }
            if root.dialog-kind == "services": ServicesDialog {}
            if root.dialog-kind == "screens": ScreensDialog {}
            if root.dialog-kind == "phone": PhoneDialog {}
            if root.dialog-kind == "settings": SettingsDialog {}
        }

        for a in root.ask: AskOverlay {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            ask: a;
            answer(ok, text) => { root.ask-answer(ok, text); }
            other => { root.ask-other(); }
        }
    }

    // Over the columns: the jobs box (`z-index: 40`), then the toasts (`z-index: 50`).
    JobsBox {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        jobs: root.jobs;
        dismiss(id) => { root.job-dismiss(id); }
        cancel(id) => { root.job-cancel(id); }
    }
    ToastStack {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        toasts: root.toasts;
    }
    // Files dragged over the window (`z-index: 60`, over the toasts).
    if root.drop-hint: DropHint {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
    }
}
