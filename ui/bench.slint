// The graphics test's windows (`src/ui/graphics_test.rs`, Settings → Video → "Test which is fastest"): a Sunday's
// load for one graphics choice. Everything moves by itself from `animation-tick()`: lyrics slides crossfade in a
// loop, the background drifts, and a designed slide's picture flies in. Each drawn frame calls `frame`, so frames
// are counted with every renderer (the software one has no rendering notifier).

/// A slide as the room shows it: moving background, two crossfading lyrics faces, a picture that flies in.
component BenchSlide inherits Rectangle {
    in property <image> bg;
    in property <image> picture;
    in property <[string]> lyrics;
    in property <duration> t;
    /// Shifts this copy's loop, so thumbnails are not all in step.
    in property <duration> offset;
    property <duration> now: root.t + root.offset;
    property <int> cycle: floor(root.now / 2000ms);
    property <float> fade: min(mod(root.now / 1ms, 2000) / 400, 1);
    property <bool> even: mod(root.cycle, 2) == 0;
    property <int> n: max(root.lyrics.length, 1);
    property <float> fly: 1 - pow(1 - clamp(mod(root.now / 1ms, 3000) / 900, 0, 1), 3);
    clip: true;
    background: #000;

    Image {
        source: root.bg;
        width: root.width * 1.3;
        height: root.height * 1.3;
        x: root.width * (sin(root.now / 1ms * 0.03deg) - 1) * 0.15;
        y: root.height * (cos(root.now / 1ms * 0.021deg) - 1) * 0.15;
        image-fit: fill;
    }
    Rectangle {
        width: root.height * 0.9;
        height: self.width;
        x: (root.width - self.width) * (0.5 + 0.45 * sin(root.now / 1ms * 0.05deg));
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: @radial-gradient(circle, #ffffff40 0%, #ffffff00 70%);
    }
    Text {
        width: root.width * 0.86;
        x: root.width * 0.07;
        height: root.height;
        text: root.lyrics[mod(root.even ? root.cycle : root.cycle - 1, root.n)];
        color: #fff;
        font-size: root.height * 0.07;
        font-weight: 700;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: root.even ? root.fade : 1 - root.fade;
    }
    Text {
        width: root.width * 0.86;
        x: root.width * 0.07;
        height: root.height;
        text: root.lyrics[mod(root.even ? root.cycle - 1 : root.cycle, root.n)];
        color: #fff;
        font-size: root.height * 0.07;
        font-weight: 700;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: root.even ? 1 - root.fade : root.fade;
    }
    Image {
        source: root.picture;
        width: root.width * 0.18;
        height: self.width * 0.5;
        x: root.width * 0.78;
        y: root.height * (0.04 + (1 - root.fly) * 0.9);
        image-fit: fill;
        opacity: root.fly;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-rotation: (1 - root.fly) * 90deg;
        transform-scale: 0.5 + root.fly * 0.5;
    }
}

/// One window of the test: `kind` 0 = operator, 1 = room, 2 = stage.
export component BenchWindow inherits Window {
    title: "RustyPresenter";
    in property <int> kind;
    in property <image> bg;
    in property <image> picture;
    in property <[string]> lyrics;
    /// Called once per drawn frame; returns 1.
    pure callback frame(duration) -> float;
    property <duration> t: animation-tick();
    background: #000;

    if root.kind == 1: BenchSlide {
        width: root.width;
        height: root.height;
        bg: root.bg;
        picture: root.picture;
        lyrics: root.lyrics;
        t: root.t;
    }
    if root.kind == 2: Rectangle {
        background: #000;
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text {
                text: root.lyrics[mod(floor(root.t / 2000ms), max(root.lyrics.length, 1))];
                color: #fff;
                font-size: root.height * 0.08;
                wrap: word-wrap;
                vertical-stretch: 2;
            }
            Text {
                text: root.lyrics[mod(floor(root.t / 2000ms) + 1, max(root.lyrics.length, 1))];
                color: #ffd166;
                font-size: root.height * 0.05;
                wrap: word-wrap;
                vertical-stretch: 1;
            }
            Text {
                text: floor(root.t / 60000ms) + ":" + mod(floor(root.t / 1000ms), 60);
                color: #9ad;
                font-size: root.height * 0.06;
                horizontal-alignment: right;
            }
        }
    }
    if root.kind == 0: HorizontalLayout {
        padding: 8px;
        spacing: 8px;
        VerticalLayout {
            width: 22%;
            spacing: 2px;
            for line[i] in root.lyrics: Rectangle {
                height: 26px;
                background: mod(floor(root.t / 2000ms), max(root.lyrics.length, 1)) == i ? #3a3f4b : #1b1e24;
                Text { x: 6px; text: line; color: #dde; font-size: 12px; overflow: elide; }
            }
            Rectangle { }
        }
        VerticalLayout {
            spacing: 8px;
            for row in 3: HorizontalLayout {
                spacing: 8px;
                for col in 3: BenchSlide {
                    bg: root.bg;
                    picture: root.picture;
                    lyrics: root.lyrics;
                    t: root.t;
                    offset: (row * 3 + col) * 230ms;
                }
            }
        }
        BenchSlide {
            width: 30%;
            bg: root.bg;
            picture: root.picture;
            lyrics: root.lyrics;
            t: root.t;
        }
    }
    // The frame counter: its opacity is worked out again (calling `frame`) every time the window draws.
    Rectangle {
        x: 0;
        y: 0;
        width: 1px;
        height: 1px;
        background: #000;
        opacity: root.frame(root.t);
    }
}
