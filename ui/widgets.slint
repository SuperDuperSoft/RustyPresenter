// Shared controls of the operator and its dialogs, sized and coloured as their `web/operator.css` rules
// (named beside each component). Every colour, radius and font comes from `Theme`.
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { TipBox } from "tip.slint";
import { ScrollBox } from "scroll.slint";

export { Icon, TipBox, ScrollBox }

/// `.btn` (`.primary`, `.danger`, `.small`, `:disabled`): an optional icon and a label.
export component Btn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> small;
    in property <bool> enabled: true;
    in property <string> tooltip;
    out property <bool> has-hover: ta.has-hover;
    callback clicked();

    property <brush> ink: root.primary ? Theme.accent-ink : root.danger ? Theme.danger-text : Theme.text;

    border-radius: 9px;
    border-width: 1px;
    background: root.primary ? Theme.accent : Theme.raise;
    border-color: root.primary ? Theme.accent : ta.has-hover && root.enabled ? Theme.btn-hover : Theme.line;
    opacity: root.enabled ? 1 : 0.45;

    HorizontalLayout {
        padding-top: root.small ? 5px : 8px;
        padding-bottom: self.padding-top;
        padding-left: root.small ? 10px : 13px;
        padding-right: self.padding-left;
        spacing: 7px;
        alignment: center;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                color: root.ink;
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.ink;
            font-family: Theme.font;
            font-size: root.small ? 13px : Theme.base-size;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    if root.tooltip != "": Tooltip {
        TipBox { text: root.tooltip; }
    }
}

/// `.top-btn` (and `.icon-only`): a top-bar button with an icon and a label; hover raises it.
export component TopBtn inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    /// `.icon-only`: only the icon, 8 px padding all round (the Settings button).
    in property <bool> icon-only;
    /// A narrow window (`operator.css:180`): the label hides but the 8×10 padding stays (Screens and Phone).
    in property <bool> narrow;
    in property <string> tooltip;
    callback clicked();

    property <brush> ink: ta.has-hover ? Theme.text : Theme.muted;

    border-radius: 9px;
    border-width: 1px;
    border-color: transparent;
    background: ta.has-hover ? Theme.raise : transparent;

    HorizontalLayout {
        padding: 8px;
        padding-left: root.icon-only ? 8px : 10px;
        padding-right: self.padding-left;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                color: root.ink;
            }
        }
        if !root.icon-only && !root.narrow: Text {
            text: root.text;
            color: root.ink;
            font-family: Theme.font;
            font-size: Theme.base-size;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    if root.tooltip != "": Tooltip {
        TipBox { text: root.tooltip; }
    }
}

/// `.pill` in the top bar's status: a dot (`off` grey, `on` green with a glow, `warn` red) and a label.
export component Pill inherits Rectangle {
    in property <string> label;
    in property <string> state: "off";
    in property <string> tooltip;
    /// A narrow window shows only the dot (`operator.css:239`).
    in property <bool> narrow;

    border-radius: self.height / 2;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.panel-2;

    HorizontalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.state == "on" ? Theme.ok : root.state == "warn" ? Theme.live : Theme.faint;
                drop-shadow-blur: root.state == "on" ? 8px : 0px;
                drop-shadow-color: Theme.ok;
            }
        }
        if !root.narrow: Text {
            text: root.label;
            color: Theme.muted;
            font-family: Theme.font;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    ta := TouchArea { }

    if root.tooltip != "": Tooltip {
        TipBox { text: root.tooltip; }
    }
}

/// `kbd`: a key name.
export component Kbd inherits Rectangle {
    in property <string> text;
    background: Theme.kbd-bg;
    border-color: Theme.line;
    border-width: 1px;
    border-radius: 5px;
    HorizontalLayout {
        padding-top: 3px;
        padding-bottom: 3px;
        padding-left: 5px;
        padding-right: 5px;
        Text {
            text: root.text;
            color: Theme.muted;
            font-family: Theme.font;
            font-size: 10.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

/// `.status-chip` (`.ok`, `.warn`, `.bad`).
export component Chip inherits Rectangle {
    in property <string> text;
    in property <string> state;
    in property <string> tooltip;

    background: Theme.raise;
    border-radius: self.height / 2;

    HorizontalLayout {
        padding-top: 3px;
        padding-bottom: 3px;
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            color: root.state == "ok" ? Theme.ok : root.state == "warn" ? Theme.accent : root.state == "bad" ? Theme.live : Theme.muted;
            font-family: Theme.font;
            font-size: 11.5px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    ta := TouchArea { }

    if root.tooltip != "": Tooltip {
        TipBox { text: root.tooltip; }
    }
}

/// `.seg`: a row of choices, one of them on.
export component Segmented inherits Rectangle {
    in property <[string]> labels;
    in-out property <int> index;
    callback changed(int);

    background: Theme.bg;
    border-color: Theme.line;
    border-width: 1.5px;
    border-radius: 10px;

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for label[i] in root.labels: Rectangle {
            border-radius: 7px;
            background: i == root.index ? Theme.raise : transparent;
            // The inset highlight on the top edge (`box-shadow: 0 1px 0 … inset`).
            Rectangle {
                y: 0;
                height: 1px;
                visible: i == root.index;
                background: Theme.seg-inset;
            }
            HorizontalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                padding-left: 11px;
                padding-right: 11px;
                Text {
                    text: label;
                    color: i == root.index ? Theme.text : Theme.muted;
                    font-family: Theme.font;
                    font-size: Theme.base-size;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if root.index != i {
                        root.index = i;
                        root.changed(i);
                    }
                }
            }
        }
    }
}

/// `.panel`: a column of the main layout. Its children are stacked top to bottom.
export component Panel inherits Rectangle {
    background: Theme.panel;
    border-color: Theme.line;
    border-width: 1px;
    border-radius: Theme.radius;
    clip: true;
    VerticalLayout {
        padding: 1px;
        @children
    }
}

/// `.panel-head`: an uppercase title and a count; children go on the right (`.head-actions`).
export component PanelHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> count;
    padding-top: 14px;
    padding-bottom: 10px;
    padding-left: 16px;
    padding-right: 16px;
    spacing: 10px;
    Text {
        text: root.title.to-uppercase();
        color: Theme.muted;
        font-family: Theme.font;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 1.3px;
        vertical-alignment: center;
    }
    Rectangle {
        horizontal-stretch: 1;
    }
    if root.count != "": Text {
        text: root.count;
        color: Theme.faint;
        font-family: Theme.font;
        font-size: 12px;
        vertical-alignment: center;
    }
    @children
}

/// `.transport .bar` / `.job .bar`: progress 0–100. The fill slides in 500 ms (`.transport .bar i`); a job bar sets
/// `animated: false`, as `.job .bar i` has no transition.
export component Bar inherits Rectangle {
    in property <float> progress;
    in property <bool> animated: true;
    height: 6px;
    background: Theme.line;
    border-radius: self.height / 2;
    clip: true;
    Rectangle {
        x: 0;
        height: parent.height;
        width: parent.width * clamp(root.progress, 0, 100) / 100;
        background: Theme.accent;
        animate width { duration: root.animated ? 500ms : 0ms; easing: linear; }
    }
}

/// `.field`: an uppercase label over its control (the children), with an optional help line in the label.
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> help;
    spacing: 6px;
    padding-bottom: 12px;
    HorizontalLayout {
        spacing: 6px;
        Text {
            text: root.label.to-uppercase();
            color: Theme.muted;
            font-family: Theme.font;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.48px;
        }
        if root.help != "": Text {
            text: root.help;
            color: Theme.faint;
            font-family: Theme.font;
            font-size: 12px;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }
    }
    @children
}

/// `.copy`: text the user can select and copy (an address or a code), read-only, in the monospace font. One click
/// selects all of it (`user-select: all`). Like the web `<span>`, it does not count as a text field for the operator
/// keys, so it leaves `OperatorState.focus-in-text` alone.
export component CopyText inherits Rectangle {
    in property <string> text;
    background: Theme.bg;
    border-color: Theme.line;
    border-width: 1px;
    border-radius: 6px;
    HorizontalLayout {
        padding-top: 2px;
        padding-bottom: 2px;
        padding-left: 6px;
        padding-right: 6px;
        input := TextInput {
            text: root.text;
            read-only: true;
            single-line: true;
            color: Theme.text;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.accent-ink;
            font-family: Theme.mono;
            font-size: Theme.base-size;
            vertical-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
            input.select-all();
        }
    }
}
