// The operator's bottom library pane. The rows and filtering are in Rust (`media_bin.rs`).
import { Theme } from "../theme.slint";
import { Icon, Btn, ScrollBox } from "../widgets.slint";
import { TextField, RangeSlider, Select, ListRow, RowMain } from "../dialogs/form.slint";
import { AddRow } from "../dialogs/add-list.slint";
import { ListView } from "std-widgets.slint";

/// N11: the Video inputs tab (`src/ui/operator/video_inputs.rs`). `found` lists the cameras and capture cards found on
/// this computer; `typed` is a name typed instead.
export global VideoInputs {
    in property <[string]> found;
    in-out property <int> found-index;
    in property <bool> searching;
    in-out property <string> typed;
    callback find();
    callback add();
    callback remove();
}

/// One file. `kind` is "video", "image", "audio" or "input" (a camera); `image` stays empty for video and audio (an icon is drawn).
export struct BinRow { id: string, name: string, kind: string, tag: string, image: image, picked: bool, on-screen: bool }
/// One folder of the list. An empty `name` is "All media".
export struct BinFolder { name: string, label: string, count: int, on: bool }

/// One tab in the bottom library pane.
component BinTab inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked();
    min-width: label.preferred-width + 20px;
    height: 30px;
    border-radius: 6px;
    background: root.on ? Theme.raise : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    label := Text {
        text: root.text;
        color: root.on ? Theme.accent : ta.has-hover ? Theme.text : Theme.muted;
        font-family: Theme.font;
        font-size: 13px;
        font-weight: root.on ? 600 : 400;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// One thumbnail: 16:9 with the kind and "ON SCREEN" marks, and the name under it.
component BinTile inherits Rectangle {
    in property <BinRow> file;
    callback clicked();
    callback double-clicked();

    property <length> name-h: 24px;
    height: root.width * 9 / 16 + root.name-h;
    border-radius: 8px;
    clip: true;
    background: Theme.panel-2;
    accessible-role: button;
    accessible-label: root.file.name;
    accessible-item-selected: root.file.picked;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.width * 9 / 16;
        background: Theme.black;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.file.image;
            image-fit: cover;
        }
        if root.file.kind != "image": Icon {
            width: 26px;
            height: 26px;
            name: root.file.kind == "audio" ? "audio" : root.file.kind == "input" ? "video" : "play";
            color: Theme.muted;
        }
        Rectangle {
            x: 6px;
            y: 6px;
            width: tag.preferred-width + 12px;
            height: 18px;
            border-radius: 4px;
            background: Theme.caption-bg;
            tag := Text {
                text: root.file.tag;
                color: Theme.white;
                font-family: Theme.font;
                font-size: 11px;
                font-weight: 600;
            }
        }
        if root.file.on-screen: Rectangle {
            x: parent.width - self.width - 6px;
            y: 6px;
            width: on-air.preferred-width + 12px;
            height: 18px;
            border-radius: 4px;
            background: Theme.live;
            on-air := Text {
                text: @tr("ON SCREEN");
                color: Theme.black;
                font-family: Theme.font;
                font-size: 10px;
                font-weight: 800;
            }
        }
    }
    Text {
        x: 8px;
        y: root.height - root.name-h;
        width: root.width - 16px;
        height: root.name-h;
        text: root.file.name;
        color: Theme.text;
        font-family: Theme.font;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        border-radius: 8px;
        border-width: 2px;
        border-color: root.file.picked ? Theme.accent : ta.has-hover ? Theme.thumb-hover : Theme.line;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }
}

export component MediaBin inherits VerticalLayout {
    in-out property <bool> open: true;
    /// How tall the list under the tabs is. Shorter on a short window, so the slides keep their room.
    in property <length> body-height: 220px;
    /// The window is wide enough for the thumbnail size slider beside the tabs, the search box and Import.
    in property <bool> roomy: true;
    in property <string> tab: "all";
    in property <[BinFolder]> folders;
    in property <[BinRow]> rows;
    in-out property <string> query;
    in property <[AddRow]> songs;
    in property <string> song-placeholder;
    in property <string> song-empty;
    in-out property <string> song-query;
    /// A file is chosen: its name, a hint and what can be done with it.
    in property <bool> has-pick;
    in property <string> pick-name;
    in property <string> pick-hint;
    in property <bool> can-use;
    /// The selected folder can be deleted (it is not "All media").
    in property <bool> can-delete-folder;

    callback set-tab(string);
    callback set-folder(string);
    callback search(string);
    callback pick(string);
    callback use-picked();
    callback add-picked();
    callback move-picked();
    callback import();
    callback new-folder();
    callback delete-folder();
    callback song-search(string);
    callback add-song(string);
    callback edit-song(string);
    callback new-song();

    /// The size slider: how wide a thumbnail is.
    in-out property <int> tile-size: 150;
    property <length> tile-w: root.tile-size * 1px;
    property <length> gap: 8px;
    /// The thumbnails' width: everything but the folders, the side panel and their two dividers.
    property <length> tiles-w: root.width - 168px - 188px - 2px;
    property <int> cols: max(1, floor((root.tiles-w - 20px - 10px + root.gap) / (root.tile-w + root.gap)));
    property <length> cell-w: (root.tiles-w - 20px - 10px - (root.cols - 1) * root.gap) / root.cols;
    property <length> cell-h: root.cell-w * 9 / 16 + 24px;

    // The header: always there, so the library can be opened again.
    HorizontalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        height: 44px;
        toggle := Rectangle {
            width: toggle-row.preferred-width;
            accessible-role: button;
            accessible-label: root.tab == "songs" ? @tr("Songs") : @tr("Media library");
            accessible-expandable: true;
            accessible-expanded: root.open;
            accessible-action-default => { root.open = !root.open; }
            toggle-row := HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        name: root.open ? "chevron-down" : "chevron-right";
                        color: Theme.muted;
                    }
                }
                Text {
                    text: root.tab == "songs" ? @tr("Songs") : @tr("Media library");
                    color: Theme.text;
                    font-family: Theme.font;
                    font-size: Theme.base-size;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open = !root.open; }
            }
        }
        if root.open: Rectangle {
            width: tabs.preferred-width + 4px;
            border-radius: 8px;
            background: Theme.bg;
            tabs := HorizontalLayout {
                padding: 1px;
                spacing: 2px;
                songs-tab := BinTab { text: @tr("Songs"); on: root.tab == "songs"; clicked => { root.set-tab("songs"); } }
                BinTab { text: @tr("All"); on: root.tab == "all"; clicked => { root.set-tab("all"); } }
                BinTab { text: @tr("Videos"); on: root.tab == "video"; clicked => { root.set-tab("video"); } }
                BinTab { text: @tr("Pictures"); on: root.tab == "image"; clicked => { root.set-tab("image"); } }
                BinTab { text: @tr("Audio"); on: root.tab == "audio"; clicked => { root.set-tab("audio"); } }
                inputs-tab := BinTab { text: @tr("Video inputs"); on: root.tab == "inputs"; clicked => { root.set-tab("inputs"); } }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.open && root.tab != "songs": bin-search := TextField {
            min-width: 100px;
            preferred-width: 190px;
            max-width: 190px;
            search: true;
            text <=> root.query;
            placeholder: @tr("Search media");
            edited(t) => { root.search(t); }
        }
        if root.open && root.tab == "songs": song-search-field := TextField {
            min-width: 100px;
            preferred-width: 190px;
            max-width: 190px;
            search: true;
            text <=> root.song-query;
            placeholder: root.song-placeholder;
            edited(t) => { root.song-search(t); }
        }
        // N8: the thumbnail size slider. It gives way on a narrow window, so Import always stays on the screen.
        if root.open && root.tab != "songs" && root.roomy: HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Icon {
                    width: 16px;
                    height: 16px;
                    name: "image";
                    color: Theme.muted;
                }
            }
            VerticalLayout {
                alignment: center;
                bin-size := RangeSlider {
                    width: 110px;
                    minimum: 110;
                    maximum: 210;
                    value <=> root.tile-size;
                    accessible-label: @tr("Picture size");
                }
            }
        }
        if root.open: bin-import := Btn {
            horizontal-stretch: 0;
            small: true;
            icon: "upload";
            text: @tr("Import");
            clicked => { root.import(); }
        }
        if root.open && root.tab == "songs": new-song-button := Btn {
            horizontal-stretch: 0;
            small: true;
            icon: "plus";
            text: @tr("New song");
            clicked => { root.new-song(); }
        }
    }

    if root.open && root.tab == "songs": Rectangle {
        height: root.body-height;
        if root.songs.length == 0: Text {
            width: parent.width;
            height: parent.height;
            text: root.song-empty;
            color: Theme.muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.songs.length > 0: ListView {
            x: 8px;
            y: 4px;
            width: parent.width - 16px;
            height: parent.height - 8px;
            for song in root.songs: Rectangle {
                height: 62px;
                song-row := ListRow {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height - 4px;
                    accessible-role: list-item;
                    accessible-label: song.title;
                    accessible-description: song.subtitle;
                    RowMain { title: song.title; sub: song.subtitle; }
                    VerticalLayout {
                        alignment: center;
                        song-edit := Btn {
                            small: true;
                            icon: "edit";
                            text: @tr("Edit");
                            clicked => { root.edit-song(song.id); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        song-add := Btn {
                            small: true;
                            primary: true;
                            icon: "plus";
                            text: @tr("Add");
                            clicked => { root.add-song(song.id); }
                        }
                    }
                }
            }
        }
    }

    if root.open && root.tab != "songs": HorizontalLayout {
        height: root.body-height;
        // Folders.
        Rectangle {
            width: 168px;
            ScrollBox {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    alignment: start;
                    for f in root.folders: Rectangle {
                        height: 34px;
                        border-radius: 6px;
                        background: f.on ? Theme.raise : fa.has-hover ? Theme.panel-2 : transparent;
                        accessible-role: button;
                        accessible-label: f.label;
                        accessible-action-default => { root.set-folder(f.name); }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Text {
                                horizontal-stretch: 1;
                                text: f.label;
                                color: Theme.text;
                                font-family: Theme.font;
                                font-size: 13px;
                                font-weight: f.on ? 600 : 400;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: f.count;
                                color: Theme.muted;
                                font-family: Theme.font;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                        fa := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.set-folder(f.name); }
                        }
                    }
                    new-folder := Btn {
                        small: true;
                        icon: "plus";
                        text: @tr("New folder");
                        clicked => { root.new-folder(); }
                    }
                    if root.can-delete-folder: delete-folder := Btn {
                        small: true;
                        icon: "trash";
                        text: @tr("Delete folder");
                        clicked => { root.delete-folder(); }
                    }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.line; }

        // Thumbnails. Placed by hand: Slint has no wrapping layout.
        tiles := Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            ScrollBox {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                Rectangle {
                    x: 0;
                    y: 0;
                    width: root.tiles-w;
                    height: 20px + ceil(root.rows.length / root.cols) * (root.cell-h + root.gap);
                    for f[i] in root.rows: BinTile {
                        x: 10px + (i - floor(i / root.cols) * root.cols) * (root.cell-w + root.gap);
                        y: 10px + floor(i / root.cols) * (root.cell-h + root.gap);
                        width: root.cell-w;
                        file: f;
                        clicked => { root.pick(f.id); }
                        double-clicked => { root.pick(f.id); root.use-picked(); }
                    }
                }
            }
            // N7: an empty list always offers the one thing to do next.
            if root.rows.length == 0 && root.tab == "inputs": VerticalLayout {
                width: parent.width - 40px;
                alignment: center;
                inputs-empty := Text {
                    text: @tr("No video inputs yet. Plug in a camera or capture card, then add it on the right.");
                    color: Theme.muted;
                    font-family: Theme.font;
                    font-size: 13px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
            if root.rows.length == 0 && root.tab != "inputs": VerticalLayout {
                width: parent.width - 40px;
                alignment: center;
                spacing: 10px;
                empty := Text {
                    text: @tr("Nothing here yet. Import pictures, videos or music, or try another folder or word.");
                    color: Theme.muted;
                    font-family: Theme.font;
                    font-size: 13px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: center;
                    empty-import := Btn {
                        primary: true;
                        icon: "upload";
                        text: @tr("Import media");
                        clicked => { root.import(); }
                    }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.line; }

        // N11: add a camera or capture card, when none is chosen.
        if root.tab == "inputs" && !root.has-pick: VerticalLayout {
            width: 188px;
            padding: 10px;
            spacing: 8px;
            Text {
                text: @tr("Add a video input");
                color: Theme.text;
                font-family: Theme.font;
                font-size: Theme.base-size;
                font-weight: 600;
                overflow: elide;
            }
            if VideoInputs.found.length > 0: inputs-found := Select {
                height: 34px;
                options: VideoInputs.found;
                index <=> VideoInputs.found-index;
            }
            if VideoInputs.found.length == 0: Text {
                text: VideoInputs.searching ? @tr("Looking for cameras…") : @tr("None found. Type the camera's name:");
                color: Theme.muted;
                font-family: Theme.font;
                font-size: 12px;
                wrap: word-wrap;
            }
            inputs-typed := TextField {
                text <=> VideoInputs.typed;
                placeholder: VideoInputs.found.length > 0 ? @tr("Or type its name") : @tr("Camera name");
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 6px;
                inputs-find := Btn {
                    small: true;
                    icon: "restart";
                    tooltip: @tr("Look for cameras again");
                    clicked => { VideoInputs.find(); }
                }
                inputs-add := Btn {
                    horizontal-stretch: 1;
                    primary: true;
                    small: true;
                    icon: "plus";
                    text: @tr("Add");
                    clicked => { VideoInputs.add(); }
                }
            }
        }
        // What to do with the chosen file.
        if root.tab != "inputs" || root.has-pick: VerticalLayout {
            width: 188px;
            padding: 10px;
            spacing: 8px;
            Text {
                text: root.has-pick ? root.pick-name : @tr("Pick a file");
                color: Theme.text;
                font-family: Theme.font;
                font-size: Theme.base-size;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                vertical-stretch: 1;
                text: root.pick-hint;
                color: Theme.muted;
                font-family: Theme.font;
                font-size: 12px;
                wrap: word-wrap;
            }
            if root.can-use: use-picked := Btn {
                primary: true;
                text: @tr("Use as background");
                clicked => { root.use-picked(); }
            }
            if root.has-pick && root.tab == "inputs": inputs-remove := Btn {
                small: true;
                danger: true;
                icon: "trash";
                text: @tr("Remove");
                clicked => { VideoInputs.remove(); }
            }
            if root.has-pick && root.tab != "inputs": add-picked := Btn {
                text: @tr("Add to service");
                clicked => { root.add-picked(); }
            }
            if root.has-pick && root.tab != "inputs": move-picked := Btn {
                small: true;
                text: @tr("Move to folder");
                clicked => { root.move-picked(); }
            }
        }
    }
}
