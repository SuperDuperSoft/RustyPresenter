// FEAT-2's automation strip in the live column (spec §3.1): the Message button, the auto-advance chip, timer
// chips and macro buttons. Rows with nothing in them are hidden. Filled by `src/ui/operator/automation.rs`.
import { Theme } from "../theme.slint";
import { Btn, Icon, TipBox } from "../widgets.slint";

export struct AutoTimerChip { id: string, name: string, text: string, over: bool, running: bool, can-pause: bool, in-room: bool }
export struct AutoMacroBtn { id: string, name: string, color: color }
/// Up to three macro buttons on one row.
export struct AutoMacroRow { buttons: [AutoMacroBtn] }

export global AutoStrip {
    in property <bool> message-on;
    in property <bool> auto-shown;
    in property <bool> auto-paused;
    in property <string> auto-label;
    in property <[AutoTimerChip]> timers;
    in property <[AutoMacroRow]> macros;
    callback message();
    callback auto-toggle();
    callback timer-toggle(string);
    callback timer-room(string);
    callback timer-reset(string);
    callback run-macro(string);
    callback open-automation();
}

/// A small round button inside a chip.
component ChipBtn inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip;
    in property <bool> lit;
    callback clicked();
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background: root.lit ? Theme.accent : ta.has-hover ? Theme.btn-hover : transparent;
    accessible-role: button;
    accessible-label: root.tooltip;
    accessible-action-default => { root.clicked(); }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        color: root.lit ? Theme.accent-ink : Theme.text;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if root.tooltip != "": Tooltip {
        TipBox { text: root.tooltip; }
    }
}

export component AutomationStrip inherits VerticalLayout {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 8px;
    spacing: 6px;

    // Row 1: Message and, while the live item turns its own slides, the Auto chip.
    HorizontalLayout {
        spacing: 6px;
        message-btn := Btn {
            horizontal-stretch: 1;
            small: true;
            icon: "message";
            primary: AutoStrip.message-on;
            text: AutoStrip.message-on ? @tr("Message showing — Hide") : @tr("Message");
            tooltip: @tr("Show a message on the screen (Ctrl+Shift+M)");
            clicked => { AutoStrip.message(); }
        }
        if AutoStrip.auto-shown: auto-chip := Btn {
            width: 132px;
            small: true;
            icon: AutoStrip.auto-paused ? "play" : "pause";
            text: AutoStrip.auto-label;
            tooltip: AutoStrip.auto-paused ? @tr("Turn the slides by themselves again") : @tr("Stop turning the slides by themselves");
            clicked => { AutoStrip.auto-toggle(); }
        }
        automation-btn := Btn {
            small: true;
            icon: "gear";
            tooltip: @tr("Timers, messages and macros");
            clicked => { AutoStrip.open-automation(); }
        }
    }

    // Row 2: timers that run, are paused or finished, or are on the screen.
    if AutoStrip.timers.length > 0: HorizontalLayout {
        spacing: 6px;
        alignment: start;
        for t[i] in AutoStrip.timers: Rectangle {
            width: 168px;
            height: 34px;
            border-radius: 9px;
            background: Theme.raise;
            border-width: 1px;
            border-color: t.in-room ? Theme.accent : Theme.line;
            accessible-role: text;
            accessible-label: t.name + " " + t.text;
            HorizontalLayout {
                padding-left: 9px;
                padding-right: 3px;
                spacing: 2px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: t.name;
                        color: Theme.muted;
                        font-family: Theme.font;
                        font-size: 10.5px;
                        overflow: elide;
                    }
                    Text {
                        text: t.text;
                        color: t.over ? Theme.live : Theme.text;
                        font-family: Theme.font;
                        font-size: 14px;
                        font-weight: 700;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    if t.can-pause || !t.running: ChipBtn {
                        icon: t.running ? "pause" : "play";
                        tooltip: t.running ? @tr("Pause") : @tr("Start");
                        clicked => { AutoStrip.timer-toggle(t.id); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    ChipBtn {
                        icon: "monitor";
                        lit: t.in-room;
                        tooltip: t.in-room ? @tr("Hide from room") : @tr("Show in room");
                        clicked => { AutoStrip.timer-room(t.id); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    ChipBtn {
                        icon: "restart";
                        tooltip: @tr("Reset");
                        clicked => { AutoStrip.timer-reset(t.id); }
                    }
                }
            }
        }
    }

    // Rows 3–4: macro buttons, three to a row.
    for row in AutoStrip.macros: HorizontalLayout {
        spacing: 6px;
        alignment: start;
        for m in row.buttons: Rectangle {
            width: 112px;
            height: 32px;
            border-radius: 9px;
            background: ta.has-hover ? m.color.brighter(0.15) : m.color;
            accessible-role: button;
            accessible-label: m.name;
            accessible-action-default => { AutoStrip.run-macro(m.id); }
            Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: m.name;
                color: #111;
                font-family: Theme.font;
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { AutoStrip.run-macro(m.id); }
            }
        }
    }
}
