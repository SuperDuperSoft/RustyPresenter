// The live column's monitor (`.monitor`, `operator.css:113`). It takes the room's inputs (`ui/room.slint`) so the
// two screens stay in step; Rust prepares its layers off the UI thread (`src/ui/preview.rs`).
import { Theme } from "../theme.slint";
import { CutLayer, Side } from "../room.slint";

/// `.monitor`: the live frame, 16:9, with the room's layers (background, media, slide, logo) over the video frame.
export component LiveMonitor inherits Rectangle {
    // Each layer cuts straight to its new picture (an empty `Side` when hidden): fading here would redraw the
    // operator for every room crossfade.
    in property <Side> bg;
    in property <bool> bg-visible: true;
    in property <Side> media;
    in property <Side> slide;
    in property <Side> logo;
    in property <bool> video;
    in property <image> video-frame;
    /// The drawn video is the background one: it fills the box and is cropped (`object-fit: cover`, the room's
    /// `panscan=1.0`). A foreground video is letterboxed on black (`object-fit: contain`), as mpv does in the room.
    in property <bool> video-cover;
    in property <float> black;
    /// A video is live but the room screen is not open, so there is no frame to show.
    in property <bool> room-off;
    /// N5: show the stage screen (`stage-frame`, a picture of its window) instead of the room.
    in property <bool> show-stage;
    in property <image> stage-frame;
    /// The stage window is not open.
    in property <bool> stage-off;

    height: self.width * 9 / 16;

    // `outline: 2px solid` sits outside the box; a Slint border is drawn inside, so it is a ring around it.
    Rectangle {
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
        border-radius: 12px;
        border-width: 2px;
        border-color: Theme.monitor-outline;
    }

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        border-radius: 10px;
        clip: true;
        background: Theme.black;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.video-frame;
            // The grab keeps the video's own shape, so it is fitted here rather than stretched to 16:9.
            image-fit: root.video-cover ? ImageFit.cover : ImageFit.contain;
            visible: root.video;
        }
        CutLayer {
            width: parent.width;
            height: parent.height;
            side: root.bg;
            fit: cover;
            visible: root.bg-visible;
        }
        CutLayer {
            width: parent.width;
            height: parent.height;
            side: root.media;
        }
        CutLayer {
            width: parent.width;
            height: parent.height;
            side: root.slide;
        }
        CutLayer {
            width: parent.width;
            height: parent.height;
            side: root.logo;
            scale: 0.7;
        }
        Rectangle {
            background: Theme.black;
            opacity: root.black;
        }
        if root.video && root.room-off: room-off := Text {
            text: @tr("Room screen is off");
            color: Theme.muted;
            font-family: Theme.font;
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.show-stage: Rectangle {
            background: Theme.black;
            stage-frame := Image {
                width: parent.width;
                height: parent.height;
                source: root.stage-frame;
                image-fit: contain;
            }
            if root.stage-off: stage-off := Text {
                text: @tr("Stage screen is off");
                color: Theme.muted;
                font-family: Theme.font;
                font-size: 13px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
