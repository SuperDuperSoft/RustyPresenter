// The 24x24 stroke icons of the web operator (`operator.html:13-23`, `operator.js:20-38`), drawn as Slint paths.
// SVG `rect` and `circle` elements are written out as path data; everything else is copied unchanged.

/// One icon by name. Like the web `svg` rule: 18x18, stroke 2 (in the 24-unit box), round caps and joins, no fill.
/// `play` and `pause` are filled shapes with no stroke. An unknown name draws nothing.
export component Icon inherits Path {
    in property <string> name;
    in property <brush> color;
    /// Stroke width in units of the 24x24 box (the web's `stroke-width`).
    in property <float> weight: 2;
    in property <bool> filled: name == "play" || name == "pause";

    width: 18px;
    height: 18px;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: filled ? color : transparent;
    stroke: filled ? transparent : color;
    stroke-width: filled ? 0px : self.width * weight / 24;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands:
        name == "song" ? "M9 18V5l12-2v13 M3 18a3 3 0 1 0 6 0a3 3 0 1 0 -6 0z M15 16a3 3 0 1 0 6 0a3 3 0 1 0 -6 0z"
        : name == "scripture" ? "M4 19.5A2.5 2.5 0 0 1 6.5 17H20 M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
        : name == "video" ? "M4 5h11a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-11a2 2 0 0 1 -2 -2v-10a2 2 0 0 1 2 -2z M17 10l5-3v10l-5-3z"
        : name == "image" ? "M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2z M7 9a2 2 0 1 0 4 0a2 2 0 1 0 -4 0z M21 15l-5-5L5 21"
        : name == "audio" ? "M11 5L6 9H2v6h4l5 4z M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"
        : name == "deck" ? "M4 3h16a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-16a2 2 0 0 1 -2 -2v-10a2 2 0 0 1 2 -2z M8 21h8M12 17v4"
        : name == "text" ? "M4 7V4h16v3M9 20h6M12 4v16"
        : name == "edit" ? "M12 20h9 M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"
        : name == "trash" ? "M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"
        : name == "play" ? "M7 4v16l13-8z"
        : name == "pause" ? "M6 4h4v16h-4z M14 4h4v16h-4z"
        : name == "close" ? "M18 6L6 18M6 6l12 12"
        : name == "plus" ? "M12 5v14M5 12h14"
        : name == "upload" ? "M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"
        : name == "restart" ? "M3 12a9 9 0 1 0 3-6.7L3 8 M3 3v5h5"
        : name == "dots" ? "M10.5 5a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0z M10.5 12a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0z M10.5 19a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0z"
        : name == "phone" ? "M9 2h6a2 2 0 0 1 2 2v16a2 2 0 0 1 -2 2h-6a2 2 0 0 1 -2 -2v-16a2 2 0 0 1 2 -2z M11 18h2"
        : name == "copy" ? "M11 9h9a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-9a2 2 0 0 1 -2 -2v-9a2 2 0 0 1 2 -2z M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
        : name == "chevron-down" ? "M7 10l5 5 5-5"
        : name == "chevron-left" ? "M15 18l-6-6 6-6"
        : name == "chevron-right" ? "M9 18l6-6-6-6"
        : name == "monitor" ? "M4 4h16a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-16a2 2 0 0 1 -2 -2v-9a2 2 0 0 1 2 -2z M8 21h8M12 17v4"
        : name == "gear" ? "M9 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0z M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"
        : name == "message" ? "M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
        : name == "book" ? "M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2z M4 21V5 M9 7h6"
        : "";
}
