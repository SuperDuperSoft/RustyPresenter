// The hover tooltip look shared by the operator widgets (`widgets.slint`).
import { Theme } from "theme.slint";

/// The content of a hover tooltip (the web `title` attribute), in the operator's colours. Use it as the one child of
/// Slint's built-in `Tooltip`, so the tip is an input-transparent tooltip popup that never takes the next click:
///
/// ```slint
/// if root.tooltip != "": Tooltip { TipBox { text: root.tooltip; } }
/// ```
///
/// The built-in element shows it 500 ms after the pointer rests, 8 px below the pointer, and hides it on leave.
export component TipBox inherits Rectangle {
    in property <string> text;
    background: Theme.toast-bg;
    border-color: Theme.dash;
    border-width: 1px;
    border-radius: 6px;
    HorizontalLayout {
        padding: 4px;
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            color: Theme.text;
            font-family: Theme.font;
            font-size: 12px;
        }
    }
}
